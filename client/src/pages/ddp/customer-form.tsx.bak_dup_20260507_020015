      (pos) => {
        const lat = pos.coords.latitude.toFixed(6);
        const lng = pos.coords.longitude.toFixed(6);
        capturedGpsRef.current = { lat, lng };
        form.setValue("latitude", lat, { shouldValidate: true });
        form.setValue("longitude", lng, { shouldValidate: true });
        setGpsStatus("got");
      },
      () => { setGpsStatus("failed"); },
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
    );
  };

  const handleDocumentUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (!e.target.files?.length) return;
    const newFiles = Array.from(e.target.files);
    if (documentFiles.length + newFiles.length > 10) {
      toast({ title: "Error", description: "Maximum 10 documents allowed", variant: "destructive" });
      return;
    }
    setDocumentFiles(prev => [...prev, ...newFiles]);
    if (documentInputRef.current) documentInputRef.current.value = "";
  };

  const removeDocument = (index: number) => {
    setDocumentFiles(prev => prev.filter((_, i) => i !== index));
  };

  const handleSitePhotoUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
