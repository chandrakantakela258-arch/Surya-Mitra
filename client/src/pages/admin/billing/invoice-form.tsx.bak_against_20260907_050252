// ── Component ────────────────────────────────────────────────────────────────

export default function InvoiceForm() {
  const [, navigate] = useLocation();
  const [isEdit, editParams] = useRoute("/admin/billing/invoices/:id/edit");
  const editId = isEdit ? (editParams as any)?.id : null;
  const [loadingExisting, setLoadingExisting] = useState(false);
  const [companies, setCompanies] = useState<Company[]>([]);
  const [products, setProducts] = useState<Product[]>([]);
  const [segments, setSegments] = useState<Record<string, any[]>>({});
  const [openSegs, setOpenSegs] = useState<Set<string>>(new Set());
  const [expandedProds, setExpandedProds] = useState<Set<number>>(new Set());
  const [customers, setCustomers] = useState<Customer[]>([]);
  const [saving, setSaving] = useState(false);
  const [savedInvoiceId, setSavedInvoiceId] = useState<number | null>(null);
  const [savedInvoiceNo, setSavedInvoiceNo] = useState<string>("");
  // PDF opens in new tab, no loading state needed

  // Form state
  const [companyId, setCompanyId] = useState<number>(1);
  const [customerId, setCustomerId] = useState<string | null>(null);
  const [invoiceType, setInvoiceType] = useState("tax_invoice");
  const [againstInv, setAgainstInv] = useState<any | null>(null);
  const [againstOptions, setAgainstOptions] = useState<any[]>([]);
  const [invoiceDate, setInvoiceDate] = useState(new Date().toISOString().split("T")[0]);
  const [invoiceNoOverride, setInvoiceNoOverride] = useState("");
  const [useManualInvoiceNo, setUseManualInvoiceNo] = useState(false);
  const [dueDate, setDueDate] = useState("");
  const [notes, setNotes] = useState("");
  const [terms, setTerms] = useState("100% Advance Payment before the goods dispatch.");
  const [paymentMode, setPaymentMode] = useState("cash");
  const [hypothecatedTo, setHypothecatedTo] = useState("");
  const [items, setItems] = useState<LineItem[]>([emptyItem()]);

  // BOS Auto-Calculate
  const [bosKw, setBosKw] = useState<string>("");
  const [bosType, setBosType] = useState<string>("hybrid_la_single");
  const [bosPhase, setBosPhase] = useState<string>("single");

  // Customer search
  const [customerSearch, setCustomerSearch] = useState("");
  const [showCustomerDropdown, setShowCustomerDropdown] = useState(false);
  const [selectedCustomer, setSelectedCustomer] = useState<Customer | null>(null);
  const [shipSame, setShipSame] = useState(true);
  const [shipCust, setShipCust] = useState<Customer | null>(null);
  const [shipSearch, setShipSearch] = useState("");
  const [shipResults, setShipResults] = useState<Customer[]>([]);
  const shipFetch = (q: string) => fetch(`/api/billing/customers/search?q=${encodeURIComponent(q)}`).then(r => r.json()).then(d => { setShipResults(d.customers || []); setShowShipDropdown(true); }).catch(() => {});
  const [showShipDropdown, setShowShipDropdown] = useState(false);
  const [shipTo, setShipTo] = useState({ name: "", address: "", city: "", state: "Bihar", state_code: "10", pin: "", gstin: "", plant_capacity: "", consumer_number: "" });

  // New customer inline
  const [showNewCustomer, setShowNewCustomer] = useState(false);
  const [newCust, setNewCust] = useState({ name: "", phone: "", gstin: "", address: "", city: "", state: "Bihar", state_code: "10", pin: "", email: "", consumer_number: "", plant_capacity: "", plant_type: "", customer_reference: "" });

  // Derived
  const company = companies.find(c => c.id === companyId);
  const sellerState = company?.state_code || "10";
  const buyerState = selectedCustomer?.state_code || newCust.state_code || "10";
  const isInter = sellerState !== buyerState;

  // ── Load data ──────────────────────────────────────────────
  useEffect(() => {
    Promise.all([
      fetch("/api/billing/companies").then(r => r.json()),
      fetch("/api/billing/products").then(r => r.json()),
      fetch("/api/billing/products/segments").then(r => r.json()).catch(() => ({ segments: {} })),
    ]).then(([co, pr, seg]) => {
      setCompanies(co);
      setProducts(pr);
      if (seg && seg.segments) setSegments(seg.segments);
      if (co.length) setCompanyId(co[0].id);
    });
  }, []);

  // ── Load an existing DRAFT for editing ─────────────────────
  useEffect(() => {
    if (!editId) return;
    setLoadingExisting(true);
    fetch(`/api/billing/invoices/${editId}`).then(r => r.json()).then((d: any) => {
      if (!d || !d.id) { alert("Could not load invoice"); return; }
      if (d.approval_status === "approved") {
        alert("This invoice is already approved and cannot be edited.");
        navigate("/admin/billing/invoices");
        return;
      }
      setCompanyId(d.company_id);
      setSavedInvoiceId(d.id);
      setSavedInvoiceNo(d.invoice_no || "");
      setInvoiceType(d.invoice_type || "tax_invoice");
      setInvoiceDate(String(d.invoice_date || "").slice(0, 10));
      setDueDate(d.due_date ? String(d.due_date).slice(0, 10) : "");
      setNotes(d.notes || "");
      setTerms(d.terms || "");
      setHypothecatedTo(d.hypothecated_to || "");
      if (d.customer_id) setCustomerId(String(d.customer_id));
      setSelectedCustomer({
        id: d.customer_id, name: d.customer_name || "", phone: d.customer_phone || "",
        gstin: d.customer_gstin || "", address: d.customer_address || "",
        city: d.customer_city || "", state: d.customer_state || "Bihar",
        state_code: d.place_of_supply || d.customer_state_code || "10",
        pin: d.customer_pin || "",
      } as any);
      if (d.ship_to_name || d.ship_to_address) {
        setShipSame(false);
        setShipTo({
          name: d.ship_to_name || "", address: d.ship_to_address || "",
          city: d.ship_to_city || "", state: d.ship_to_state || "Bihar",
          state_code: d.ship_to_state_code || "10", pin: d.ship_to_pin || "",
          gstin: d.ship_to_gstin || "", plant_capacity: d.ship_to_plant_capacity || "",
          consumer_number: d.ship_to_consumer_number || "",
        });
      }
      const loaded = (d.items || []).map((i: any) => {
        const raw = String(i.description || "");
        const cut = raw.indexOf("\nSerial No: ");
        return {
          key: uid(), product_id: i.product_id ?? null,
          description: cut >= 0 ? raw.slice(0, cut) : raw,
          serial_numbers: cut >= 0 ? raw.slice(cut + 12) : "",
          hsn_code: i.hsn_code || "", quantity: Number(i.quantity) || 0,
          unit: i.unit || "Nos", rate: Number(i.rate) || 0,
          discount_percent: Number(i.discount_percent) || 0,
          gst_rate: Number(i.gst_rate) || 0, cess_rate: Number(i.cess_rate) || 0,
          discount_amount: Number(i.discount_amount) || 0,
          taxable_value: Number(i.taxable_value) || 0,
          cgst_rate: Number(i.cgst_rate) || 0, cgst_amount: Number(i.cgst_amount) || 0,
          sgst_rate: Number(i.sgst_rate) || 0, sgst_amount: Number(i.sgst_amount) || 0,
          igst_rate: Number(i.igst_rate) || 0, igst_amount: Number(i.igst_amount) || 0,
          total_amount: Number(i.total_amount) || 0,
        } as LineItem;
      });
      if (loaded.length) setItems(loaded);
    }).catch((e: any) => alert("Load failed: " + e.message))
      .finally(() => setLoadingExisting(false));
  }, [editId]);

  // Load this customer's approved tax invoices for credit/debit note reference
  useEffect(() => {
    if (invoiceType !== "credit_note" && invoiceType !== "debit_note") { setAgainstOptions([]); return; }
    const cid = selectedCustomer?.id;
    if (!cid) { setAgainstOptions([]); return; }
    fetch(`/api/billing/invoices?approval=approved&type=invoice&customer_id=${cid}`)
      .then(r => r.json())
      .then((rows: any[]) => setAgainstOptions((rows || []).filter(r => r.invoice_type === "tax_invoice")))
      .catch(() => setAgainstOptions([]));
  }, [invoiceType, selectedCustomer]);

  // Search customers
  useEffect(() => {
    if (false) // allow empty search
    if (customerSearch.length < 0) { setCustomers([]); return; }
    const t = setTimeout(() => {
      fetch(`/api/billing/customers/search?q=${encodeURIComponent(customerSearch)}`).then(r => r.json()).then(d => setCustomers(d.customers || []));
    }, 300);
    return () => clearTimeout(t);
  }, [customerSearch]);

  // ── Recalculate items when state changes ───────────────────
  const recalcItems = useCallback((currentItems: LineItem[]) => {
    return currentItems.map(it => calcItem(it, sellerState, buyerState));
  }, [sellerState, buyerState]);

  useEffect(() => {
    setItems(prev => recalcItems(prev));
  }, [sellerState, buyerState, recalcItems]);

  // ── Line item handlers ─────────────────────────────────────
  const updateItem = (key: string, field: string, value: any) => {
    setItems(prev => {
      return prev.map(it => {
        if (it.key !== key) return it;
        const newIt = { ...it, [field]: value };
        return calcItem(newIt, sellerState, buyerState);
      });
    });
  };

  const addFromCatalog = (catProd: any) => {
    const p = products.find(x => x.id === catProd.id);
    if (!p) return;
    setItems(prev => {
      const existing = prev.findIndex(i => i.product_id === p.id);
      if (existing >= 0) {
        return prev.map((it, idx) => {
          if (idx !== existing) return it;
          return calcItem({ ...it, quantity: it.quantity + 1 }, sellerState, buyerState);
        });
      }
      const fresh = calcItem({
        key: uid(), product_id: p.id, description: p.name,
        hsn_code: p.hsn_code, quantity: 1, unit: p.unit,
        rate: parseFloat(p.default_sale_price), discount_percent: 0,
        gst_rate: parseFloat(p.gst_rate), cess_rate: 0,
        discount_amount: 0, taxable_value: 0,
        cgst_rate: 0, cgst_amount: 0, sgst_rate: 0, sgst_amount: 0,
        igst_rate: 0, igst_amount: 0, total_amount: 0,
      }, sellerState, buyerState);
      const emptyIdx = prev.findIndex(i => !i.product_id && !i.description);
      if (emptyIdx >= 0) return prev.map((it, idx) => idx === emptyIdx ? fresh : it);
      return [...prev, fresh];
    });
  };

  const toggleSeg = (s: string) => setOpenSegs(prev => { const n = new Set(prev); n.has(s) ? n.delete(s) : n.add(s); return n; });
  const toggleProdDesc = (id: number) => setExpandedProds(prev => { const n = new Set(prev); n.has(id) ? n.delete(id) : n.add(id); return n; });

  const selectProduct = (key: string, productId: string) => {
    const prod = products.find(p => p.id === parseInt(productId));
    if (!prod) return;
    setItems(prev => prev.map(it => {
      if (it.key !== key) return it;
      const newIt = {
        ...it, product_id: prod.id, description: prod.name,
        hsn_code: prod.hsn_code, unit: prod.unit,
        rate: parseFloat(prod.default_sale_price), gst_rate: parseFloat(prod.gst_rate),
      };
      return calcItem(newIt, sellerState, buyerState);
    }));
  };

  const addItem = () => setItems(prev => [...prev, emptyItem()]);

  const [gstMode, setGstMode] = useState<number | null>(null);
  const setAllGst = (rate: number) => {
    setGstMode(rate);
    setItems(prev => recalcItems(prev.map(it => ({ ...it, gst_rate: rate }))));
  };
  const removeItem = (key: string) => setItems(prev => {
    const filtered = prev.filter(it => it.key !== key);
    return filtered.length === 0 ? [emptyItem()] : filtered;
  });

  const moveItem = (key: string, dir: "up" | "down") => setItems(prev => {
    const i = prev.findIndex(it => it.key === key);
    if (i < 0) return prev;
    const j = dir === "up" ? i - 1 : i + 1;
    if (j < 0 || j >= prev.length) return prev;
    const next = [...prev];
    const tmp = next[i]; next[i] = next[j]; next[j] = tmp;
    return next;
  });

  // ── Totals ─────────────────────────────────────────────────
  const subtotal = items.reduce((s, i) => s + i.quantity * i.rate, 0);
  const totalDiscount = items.reduce((s, i) => s + i.discount_amount, 0);
  const taxableAmount = items.reduce((s, i) => s + i.taxable_value, 0);
  const cgstTotal = items.reduce((s, i) => s + i.cgst_amount, 0);
  const sgstTotal = items.reduce((s, i) => s + i.sgst_amount, 0);
  const igstTotal = items.reduce((s, i) => s + i.igst_amount, 0);
  const rawTotal = taxableAmount + cgstTotal + sgstTotal + igstTotal;
  const grandTotal = Math.round(rawTotal);
  const roundOff = Math.round((grandTotal - rawTotal) * 100) / 100;

  // ── Select customer ────────────────────────────────────────
  const pickCustomer = (c: Customer) => {
    setSelectedCustomer(c);
    setCustomerId(String(c.id));
    setCustomerSearch(c.name);
    setShowCustomerDropdown(false);
    setNewCust(prev => ({
      ...prev,
      name: c.name || prev.name,
      phone: c.phone || prev.phone,
      email: (c as any).email || prev.email,
      address: c.address || prev.address,
      city: c.city || c.district || prev.city,
      state: c.state || prev.state,
      state_code: c.state_code || prev.state_code,
      consumer_number: (c as any).consumer_number || prev.consumer_number,
      customer_reference: prev.customer_reference || c.name || "",
      plant_capacity: (c as any).plant_capacity || prev.plant_capacity,
    }));
  };

  // ── Create customer inline ─────────────────────────────────
  const createCustomer = async () => {
    try {
      const res = await fetch("/api/billing/customers", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(newCust) });
      const created = await res.json();
      pickCustomer(created);
      setShowNewCustomer(false);
    } catch (e) { console.error(e); }
  };

  // ── Submit — stays on page, sets savedInvoiceId ────────────
  const handleSubmit = async () => {
    if (!customerId) { alert("Please select a customer"); return; }
    if ((invoiceType === "credit_note" || invoiceType === "debit_note") && !againstInv) {
      alert("Please select the original tax invoice this note is issued against. GST filing requires this reference."); return;
    }
    if (items.length === 0 || items.every(i => !i.description)) { alert("Add at least one line item"); return; }

    setSaving(true);
    try {
      const payload = {
        company_id: companyId,
        customer_id: customerId,
        invoice_type: invoiceType,
        against_invoice_id: againstInv ? againstInv.id : null,
        against_invoice_no: againstInv ? againstInv.invoice_no : null,
        against_invoice_date: againstInv ? String(againstInv.invoice_date).slice(0,10) : null,
        invoice_date: invoiceDate,
        ...(useManualInvoiceNo && invoiceNoOverride.trim() ? { invoice_no: invoiceNoOverride.trim() } : {}),
        due_date: dueDate || null,
        place_of_supply: buyerState,
        notes, hypothecated_to: hypothecatedTo || null, terms: (paymentMode === "cash" && !terms.includes("70% advance payment")) ? terms + "\n\nNOTE: Please make a 70% advance payment to dispatch the item and the remaining 30% after the item reaches the execution site." : terms,
        // Include customer contact info for PDF generation
        buyer_phone: newCust.phone || selectedCustomer?.phone || "",
        buyer_email: newCust.email || (selectedCustomer as any)?.email || "",
        customer_reference: newCust.customer_reference || null,
        plant_type: newCust.plant_type || null,
        approval_status: "draft",
        ship_to_customer_id: (!shipSame && shipCust) ? shipCust.id : null,
        ship_to_name: shipSame ? null : (shipTo.name || null),
        ship_to_address: shipSame ? null : (shipTo.address || null),
        ship_to_city: shipSame ? null : (shipTo.city || null),
        ship_to_state: shipSame ? null : (shipTo.state || null),
        ship_to_state_code: shipSame ? null : (shipTo.state_code || null),
        ship_to_pin: shipSame ? null : (shipTo.pin || null),
        ship_to_gstin: shipSame ? null : (shipTo.gstin || null),
        ship_to_plant_capacity: shipSame ? null : (shipTo.plant_capacity || null),
        ship_to_consumer_number: shipSame ? null : (shipTo.consumer_number || null),
        items: items.filter(i => i.description).map(i => ({
          product_id: i.product_id,
          description: i.serial_numbers ? `${i.description}\nSerial No: ${i.serial_numbers}` : i.description,
          hsn_code: i.hsn_code, quantity: i.quantity, unit: i.unit,
          rate: i.rate, discount_percent: i.discount_percent,
          gst_rate: i.gst_rate, cess_rate: i.cess_rate, serial_numbers: i.serial_numbers || null,
        })),
      };

      const targetId = editId || savedInvoiceId;
      const res = await fetch(targetId ? `/api/billing/invoices/${targetId}` : "/api/billing/invoices", { method: targetId ? "PUT" : "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const data = await res.json();

      if (res.ok) {
        const id = data.invoice?.id || data.id;
        const no = data.invoice?.invoice_no || data.invoice_no || "";
        setSavedInvoiceId(id);
        setSavedInvoiceNo(no);
        // Don't navigate away — stay on page to show share options
      } else {
        const errMsg = data.error || "Failed to create invoice";
        if (errMsg.includes("duplicate key") && errMsg.includes("invoice_no")) {
          alert(`⚠️ Invoice number "${invoiceNoOverride || "(auto)"}" is already used by another invoice.\n\nPlease enter a different invoice number, or click the "Manual ON / auto" toggle to switch back to auto-generation.`);
        } else {
          alert("Error: " + errMsg);
        }
      }
    } catch (e: any) {
      alert("Error: " + e.message);
    } finally { setSaving(false); }
  };

  // ── PDF / Email / WhatsApp ─────────────────────────────────
  function getPdfUrl(): string {
    return `${window.location.origin}/api/billing/invoices/${savedInvoiceId}/pdf`;
  }

  function downloadPDF() {
    if (!savedInvoiceId) return;
    window.open(`/api/billing/invoices/${savedInvoiceId}/pdf`, "_blank");
  }

  async function sendEmail() {
    if (!savedInvoiceId) return;
    const email = newCust.email || (selectedCustomer as any)?.email;
    if (!email) { alert("Enter customer email first"); return; }
    try {
      const res = await fetch(`/api/billing/invoices/${savedInvoiceId}/send-email`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
