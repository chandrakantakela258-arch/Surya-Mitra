            <div className="text-right">
              <div className="text-xs text-blue-300">Grand Total (Incl. GST)</div>
              <div className="text-2xl font-black">₹{total.toLocaleString("en-IN")}</div>
            </div>
          </div>
          <p className="text-xs text-muted-foreground italic px-1 pt-2">Panels / Inverters / Batteries @ 5% GST · Structure / Cables / Accessories / Service / Contractor @ 18% GST</p>
        </CardContent>
      </Card>

      {!solarHideDownPayment && <div className="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2.5">
        <span className="text-sm font-semibold text-gray-700">Down Payment:</span>
        <div className="flex items-center gap-2">
          <input
            type="number" min={5} max={100} step={5}
            value={solarDownPct}
