// ── Solar Quotation Section Component ────────────────────────────────────────
function SolarQuotationSection(p: any) {
  const { solarEnabled, setSolarEnabled, solarPlantType, setSolarPlantType,
    solarCapacityKw, setSolarCapacityKw, solarPanelModel, setSolarPanelModel,
    solarPanelQty, setSolarPanelQty, solarInverterModel, setSolarInverterModel,
    solarBatteryModel, setSolarBatteryModel, solarBatteryQty, setSolarBatteryQty,
    solarPowerLoad, setSolarPowerLoad, solarBackupHours, setSolarBackupHours,
    solarNetMeterOn, setSolarNetMeterOn, solarCosts, setSolarCosts,
    solarRatesEdited, setSolarRatesEdited, solarShowBom, setSolarShowBom,
    solarConsumerNo, setSolarConsumerNo, solarSiteAddress, setSolarSiteAddress,
    solarQuotationDate, setSolarQuotationDate,
    solarPartnerName, setSolarPartnerName, solarPartnerMobile, setSolarPartnerMobile,
    solarDownPct, setSolarDownPct,
    solarHiddenRows, setSolarHiddenRows,
    solarHideDownPayment, setSolarHideDownPayment,
    solarPhase, setSolarPhase,
    solarInstallType, setSolarInstallType,
    solarUnitName, setSolarUnitName,
    solarInverterSpec, setSolarInverterSpec, perWattRate, setPerWattRate, panelDcr, setPanelDcr,
    solarVfdHp, setSolarVfdHp,
    solarBatterySpec, setSolarBatterySpec,
    solarBatteryType, setSolarBatteryType,
    companies, companyId, setCompanyId,
  } = p;

  const panel   = SOLAR_PANEL_OPTIONS.find(pp => pp.model === solarPanelModel);
  const invList = SOLAR_INVERTER_OPTIONS[solarPlantType] ?? SOLAR_INVERTER_OPTIONS["hybrid"];
  const inv     = invList.find((i: any) => i.model === solarInverterModel);
  const bat     = SOLAR_BATTERY_OPTIONS.find(b => b.model === solarBatteryModel);

  const activeCosts = { ...solarCosts,
    netMeter: solarNetMeterOn && solarPlantType !== "offgrid" ? solarCosts.netMeter : 0,
    battery:  solarPlantType === "ongrid" ? 0 : solarCosts.battery };

  type SCKey = keyof SolarCosts;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const COST_ROWS: Array<{ key: SCKey; label: string; gst: 5|18 }> = [
    { key:"solarPanels",      label:"Solar Panels",              gst:5  },
    { key:"inverter",         label:"Inverter",                  gst:5  },
    ...(solarPlantType!=="ongrid" && solarPlantType!=="vfd_offgrid" && solarPlantType!=="vfd_autogrid" ? [{ key:"battery" as SCKey, label:"Battery", gst:5 as 5|18 }] : []),
    { key:"structure",        label:"Module Mounting Structure",  gst:18 },
    { key:"cablesWiring",     label:"Cables & Wiring",           gst:18 },
    ...(solarNetMeterOn && solarPlantType!=="offgrid" ? [{ key:"netMeter" as SCKey, label:"Net Meter", gst:18 as 5|18 }] : []),
    { key:"transport",        label:"Transport",                 gst:18 },
    { key:"installation",     label:"Installation",              gst:18 },
    { key:"miscAccessories",  label:"Misc & Accessories",        gst:18 },
    { key:"serviceCharge5yr", label:"Service Charge (5yr)",      gst:18 },
    { key:"contractorProfit", label:"Contractor Profit",         gst:18 },
  ];
  const visibleRows = COST_ROWS.filter(r => !solarHiddenRows.has(r.key));
  const total   = visibleRows.reduce((s,r) => s + ((activeCosts[r.key] as number)||0), 0);
  const downPmt = Math.round(total * solarDownPct / 100);
  const loan    = total - downPmt;
  const gstSplit = (incl: number, pct: number) => {
    const base = Math.round(incl/(1+pct/100)); return { base, gst: incl-base };
  };
  const bomRows = [
    { model:solarPanelModel,    spec:`${panel?.wattage??""  }Wp ${panel?.panelType??""} Panel — 12yr Mfg, 30yr Perf`, cat:"Module",      qty:`${solarPanelQty} Nos`,   brand:"Livguard Solar" },
    { model:solarInverterModel, spec:`${inv?.capacity??solarInverterModel} — 8yr Warranty`,                           cat:"Inverter",    qty:"1 Nos",                  brand:"Livguard" },
    ...(solarPlantType!=="ongrid"?[{model:solarBatteryModel,spec:`${bat?.spec??""} Lead Acid Battery`,cat:"Battery",qty:`${solarBatteryQty} Nos`,brand:"Livguard"}]:[]),
    { model:"GI-MMS-60402",    spec:"Hot Dip Galvanized G.I. Pipe Structure (60×40×2mm) + Accessories",               cat:"Structure",   qty:"1 Set",                  brand:"HINDUSTAR" },
    { model:"ACDB-DCDB-SPD",   spec:"DCDB 1IN1OUT IP65 SPD TypeII | ACDB IP65 MCB 32A 2P SPD TypeII+I",              cat:"Jn. Box",     qty:"1 Set",                  brand:"L&T / HAVELLS" },
    { model:"EARTH-LA-KIT",    spec:"Earth Rod 1m + Chamber Box + Chemical 15kg + LA Conv. 1m + Cable 10sqmm 50m",   cat:"Earthing",    qty:"1 Kit",                  brand:"COPPER / REPUTED" },
    { model:"POLYCAB-CABLES",  spec:"DC: 1Cx4sqmm XLPO Solar | AC: 2Cx4sqmm Cu XLPE | LT: 2Cx10sqmm AL-CCA",        cat:"Cables",      qty:"As req.",                brand:"POLYCAB" },
    { model:"ACC-SOLAR-STD",   spec:"HDPE Conduit, Bends, Lugs, MC4 Connectors, Cable Ties, Saddles",                cat:"Accessories", qty:"1 Set",                  brand:"REPUTED" },
    ...(solarPlantType!=="offgrid"?[{model:"NETMETER-SECURE",spec:"Net Energy Meter (Solar) — DISCOM Approved",cat:"Net Meter",qty:"1 Nos",brand:"SECURE"}]:[]),
  ];

  if (!solarEnabled) return (
    <Card className="border-2 border-dashed border-blue-200 bg-blue-50/30">
      <CardContent className="pt-5 pb-5 flex items-center justify-between">
        <div>
          <p className="font-semibold text-blue-800 text-sm">Solar Plant Quotation</p>
          <p className="text-xs text-blue-500 mt-0.5">Enable for plant type, BOM, itemized GST & detailed 3-page PDF</p>
        </div>
        <Button size="sm" onClick={() => setSolarEnabled(true)} className="bg-blue-700 hover:bg-blue-800 text-white">
          + Enable Solar Quotation
        </Button>
      </CardContent>
    </Card>
  );

  return (
    <div className="space-y-4">
      {/* Company Selector */}
      <div className="flex items-center gap-3 bg-white border-2 border-orange-300 rounded-lg px-4 py-2.5 shadow-sm">
        <span className="text-sm font-bold text-gray-700 shrink-0">Select Company:</span>
        <div className="flex gap-2 flex-1">
          {companies.filter((c:any)=>c).map((c:any)=>(<button key={c.id} type="button"
            onClick={()=>setCompanyId(String(c.id))}
            className={"px-4 py-2 rounded-lg text-sm font-semibold border-2 transition-all "+(String(companyId)===String(c.id)?"bg-orange-600 border-orange-600 text-white":"border-gray-300 text-gray-600 hover:border-orange-400")}>
            {c.name}
          </button>))}
        </div>
        {companies.find((c:any)=>String(c.id)===String(companyId)) && (
          <span className="text-xs text-gray-500 shrink-0">
            {companies.find((c:any)=>String(c.id)===String(companyId))?.bank_name?.split(",")[0]}
          </span>
        )}
      </div>

      <Card className="border-blue-300 bg-gradient-to-r from-blue-900 to-blue-700">
        <CardContent className="pt-4 pb-4 flex items-center justify-between">
          <div>
            <p className="text-white font-bold text-base">☀️ Solar Plant Quotation</p>
            <p className="text-blue-200 text-xs mt-0.5">
              {solarCapacityKw}KW {solarPlantType==="offgrid"?"Off-Grid":solarPlantType==="ongrid"?"On-Grid":"Hybrid"} · {solarInstallType.charAt(0).toUpperCase()+solarInstallType.slice(1)}{solarUnitName?" — "+solarUnitName:""} — {solarPanelQty}×{panel?.wattage}Wp
            </p>
          </div>
          <Button size="sm" variant="outline" className="border-white/30 text-white hover:bg-white/10 text-xs" onClick={() => setSolarEnabled(false)}>Disable</Button>
        </CardContent>
      </Card>

      <Card>
        <CardHeader className="pb-3 pt-4"><CardTitle className="text-sm font-bold text-gray-700 uppercase tracking-wide">Plant Configuration</CardTitle></CardHeader>
        <CardContent className="space-y-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <Label className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">Plant Type</Label>
              <div className="flex sm:flex-col gap-1.5 overflow-x-auto pb-1 sm:overflow-visible">
                {([
                  {v:"hybrid_lithium",  label:"🔋 Hybrid + Lithium",    bat:"lithium"},
                  {v:"hybrid",          label:"🔋 Hybrid + Lead Acid",   bat:"lead_acid"},
                  {v:"offgrid_lithium", label:"🌿 Off-Grid + Lithium",   bat:"lithium"},
                  {v:"offgrid",         label:"🌿 Off-Grid + Lead Acid", bat:"lead_acid"},
                  {v:"ongrid",          label:"⚡ On-Grid",              bat:"none"},
                  {v:"vfd_offgrid",     label:"⚙️ VFD Off-Grid",        bat:"none"},
                  {v:"vfd_autogrid",    label:"🔄 VFD Auto-Grid",        bat:"none"},
                ] as const).map(t => (
                  <button key={t.v} type="button" onClick={() => {
                    setSolarPlantType(t.v as any);
                    setSolarRatesEdited(false);
                    setSolarCosts(prev => ({...solarDefaultCosts(t.v, solarCapacityKw, solarPhase, solarPanelQty, SOLAR_PANEL_OPTIONS.find(pp=>pp.model===solarPanelModel)?.wattage||580), inverter: prev.inverter, battery: prev.battery}));
                    if(t.bat==="lithium") { setSolarBatteryType("lithium"); setSolarBatterySpec("BAT-LI-100AH"); }
                    else if(t.bat==="lead_acid") { setSolarBatteryType("lead_acid"); setSolarBatterySpec("BAT-LA-200AH"); }
                  }}
                    className={`w-full py-2 px-3 text-xs font-semibold rounded-lg border-2 text-left transition-all ${solarPlantType===t.v?"border-blue-600 bg-blue-600 text-white":"border-gray-200 bg-white text-gray-600 hover:border-blue-400"}`}>
                    {t.label}
                  </button>
                ))}
              </div>
            </div>
            <div>
              <Label className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">Installation Type</Label>
              <div className="space-y-1.5">
                {([
                  { v: "residential",  label: "🏠 Residential",  hint: "Home / Society" },
                  { v: "commercial",   label: "🏢 Commercial",   hint: "Shop / Office / Agency" },
                  { v: "industrial",   label: "🏭 Industrial",   hint: "Factory / Mill / Unit" },
                ] as const).map(t => (
                  <button key={t.v} type="button"
                    onClick={() => { setSolarInstallType(t.v); if(t.v==="residential") setSolarUnitName(""); }}
                    className={`w-full py-2 px-3 rounded-lg border-2 text-left transition-all ${solarInstallType===t.v?"border-orange-500 bg-orange-500 text-white":"border-gray-200 bg-white text-gray-600 hover:border-orange-400"}`}>
                    <div className="text-xs font-bold">{t.label}</div>
                    <div className={`text-[10px] ${solarInstallType===t.v?"text-orange-100":"text-gray-400"}`}>{t.hint}</div>
                  </button>
                ))}
              </div>
              {(solarInstallType==="commercial"||solarInstallType==="industrial") && (
                <div className="mt-2">
                  <Label className="text-[10px] font-semibold text-gray-500 uppercase tracking-wide mb-1 block">
                    {solarInstallType==="commercial"?"Business / Unit Name":"Industry / Factory Name"}
                  </Label>
                  <input
                    type="text"
                    value={solarUnitName}
                    onChange={e => setSolarUnitName(e.target.value)}
                    placeholder={solarInstallType==="commercial"?"e.g. Aarav Bikes Agency, Rice Mill":"e.g. Shree Steel Industries"}
                    className="w-full h-9 text-sm border-2 border-orange-300 rounded-lg px-3 bg-orange-50 focus:border-orange-500 outline-none text-orange-900 font-medium"
                  />
                  {solarUnitName && (
                    <div className="mt-1 flex items-center gap-1.5 bg-blue-50 border border-blue-200 rounded px-2 py-1">
                      <span className="text-blue-500 text-xs">📋</span>
                      <span className="text-xs font-semibold text-blue-700">{solarUnitName}</span>
                      <span className={`ml-auto text-[10px] px-1.5 py-0.5 rounded-full font-bold ${solarInstallType==="commercial"?"bg-green-100 text-green-700":"bg-purple-100 text-purple-700"}`}>
                        {solarInstallType==="commercial"?"Commercial":"Industrial"}
                      </span>
                    </div>
                  )}
                </div>
              )}
            </div>

            <div>
              <Label className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">Capacity</Label>
              <div className="space-y-2">
                <Select value={String(solarCapacityKw)} onValueChange={v => { setSolarCapacityKw(Number(v)); setSolarRatesEdited(false); setSolarCosts(prev => ({...solarDefaultCosts(solarPlantType, Number(v), solarPhase, solarPanelQty, SOLAR_PANEL_OPTIONS.find(pp=>pp.model===solarPanelModel)?.wattage||580), inverter: prev.inverter, battery: prev.battery})); }}>
                  <SelectTrigger className="h-9 text-sm font-bold"><SelectValue /></SelectTrigger>
                  <SelectContent className="max-h-64 overflow-y-auto">
                    {CAPACITY_OPTIONS.map(kw => (
                      <SelectItem key={kw} value={String(kw)}>{kw} KW</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
                <p className="text-xs text-muted-foreground">1 KW to 500 KW available</p>
              </div>
              {/* Phase Selector */}
              <div>
                <Label className="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">Phase</Label>
                <div className="flex gap-2">
                  {([
                    { v: "1ph", label: "⚡ Single Phase", hint: "Residential / Small" },
                    { v: "3ph", label: "⚡⚡ Three Phase", hint: "Commercial / Industrial" },
                  ] as const).map(p => (
                    <button key={p.v} type="button"
                      onClick={() => {
                        setSolarPhase(p.v);
                        if (!solarRatesEdited) setSolarCosts(prev => ({...solarDefaultCosts(solarPlantType, solarCapacityKw, p.v, solarPanelQty, SOLAR_PANEL_OPTIONS.find(pp=>pp.model===solarPanelModel)?.wattage||580), inverter: prev.inverter, battery: prev.battery}));
                      }}
                      className={`flex-1 py-2 px-3 rounded-lg border-2 text-xs font-bold transition-all text-left ${
                        solarPhase === p.v
                          ? "border-indigo-600 bg-indigo-600 text-white"
                          : "border-gray-200 text-gray-600 hover:border-indigo-400 bg-white"
                      }`}>
                      <div>{p.label}</div>
                      <div className={`text-[10px] font-normal mt-0.5 ${solarPhase===p.v?"text-indigo-200":"text-gray-400"}`}>{p.hint}</div>
                    </button>
                  ))}
                </div>
                {solarPhase === "3ph" && (
                  <p className="text-[11px] text-indigo-600 font-semibold mt-1.5 bg-indigo-50 px-2 py-1 rounded">
                    ⚡ 3-Phase: Inverter rate set to ₹{solarCapacityKw<=20?"27,000":"18,000"}/KW
                  </p>
                )}
              </div>
            </div>
            <div className="space-y-3">
              <div>
                {/* DCR / Non-DCR Toggle */}
                <div className="flex gap-2 mb-2">
                  {([{v:"dcr",label:"✅ DCR Panel",hint:"₹30,000/kW",color:"blue"},{v:"nondcr",label:"☀️ Non-DCR Panel",hint:"₹18,000/kW",color:"green"}] as const).map(opt => (
                    <button key={opt.v} type="button"
                      onClick={() => {
                        setPanelDcr(opt.v);
                        const ratePerWatt = opt.v === "dcr" ? PANEL_RATE_PER_WATT.dcr : PANEL_RATE_PER_WATT.nondcr;
                        setPerWattRate(Math.round(ratePerWatt * 100) / 100);
                        const panelCost = solarPanelQty * watt * ratePerWatt;
                        setSolarCosts((prev: any) => ({...prev, solarPanels: panelCost}));
                        setSolarRatesEdited(true);
                        // Switch panel model to match DCR preference
                        const matching = SOLAR_PANEL_OPTIONS.filter(p => p.isDCR === (opt.v === "dcr"));
                        if (matching.length && !matching.find(p => p.model === solarPanelModel)) {
                          setSolarPanelModel(matching[0].model);
                        }
                      }}
                      className={"flex-1 py-1.5 px-2 rounded-lg border-2 text-xs font-semibold transition-all " + (panelDcr===opt.v?(opt.v==="dcr"?"border-blue-500 bg-blue-50 text-blue-700":"border-green-500 bg-green-50 text-green-700"):"border-gray-200 bg-white text-gray-500 hover:border-gray-300")}>
