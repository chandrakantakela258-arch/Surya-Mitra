                          type="number"
                          value={ratePerKw}
                          onChange={e => {
                            setSolarRatesEdited(true);
                            const rpk = Number(e.target.value);
                            const b = rpk * solarCapacityKw;
                            const incl = Math.round(b * (1 + row.gst / 100));
                            setSolarCosts((prev: SolarCosts) => ({ ...prev, [row.key]: incl }));
