                  <span className="text-xs text-gray-400">Total: ₹{(solarPanelQty * (SOLAR_PANEL_OPTIONS.find(pp=>pp.model===solarPanelModel)?.wattage||580) * perWattRate).toLocaleString("en-IN")}</span>
