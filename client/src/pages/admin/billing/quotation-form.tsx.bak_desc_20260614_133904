                      const panelCost = qty * watt * perWattRate;
                      setSolarCosts(prev => ({...prev, solarPanels: panelCost}));
                    }}
                    className="w-16 h-7 text-xs text-center font-bold border-2 border-orange-300" />
                  <span className="text-xs text-muted-foreground">× {panel?.wattage}Wp</span>
                </div>
                <div className="flex items-center gap-2 mt-1.5">
