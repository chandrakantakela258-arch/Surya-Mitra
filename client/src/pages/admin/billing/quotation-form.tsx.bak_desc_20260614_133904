                }}>
                  <SelectTrigger className="h-9 text-xs"><SelectValue /></SelectTrigger>
                  <SelectContent>{SOLAR_PANEL_OPTIONS.filter(pp => pp.isDCR === (panelDcr === "dcr")).map(pp => <SelectItem key={pp.model} value={pp.model}>{pp.label} — {pp.wattage}Wp</SelectItem>)}</SelectContent>
