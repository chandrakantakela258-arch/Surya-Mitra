                        <span className="text-sm font-black text-green-800">₹{val.toLocaleString("en-IN")}</span>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          {/* Total bar */}
          <div className="mt-3 rounded-xl bg-blue-900 text-white px-4 py-3 flex items-center justify-between">
            <div>
              <div className="text-xs text-blue-300">Total GST</div>
              <div className="text-sm font-semibold">₹{visibleRows.reduce((s,r)=>s+gstSplit((activeCosts[r.key] as number)||0,r.gst).gst,0).toLocaleString("en-IN")}</div>
