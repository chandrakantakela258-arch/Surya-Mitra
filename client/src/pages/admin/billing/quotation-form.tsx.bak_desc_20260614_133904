                      <div className="flex justify-between items-center">
                        <span className="text-xs text-gray-500">GST Amt</span>
                        <span className="text-sm text-orange-600 font-medium">₹{gst.toLocaleString("en-IN")}</span>
                      </div>
                    </div>
                    {/* Right: rate/kw input + total */}
                    <div className="space-y-1">
                      <div>
                        <div className="text-[10px] text-gray-400 mb-0.5 text-right">Rate/KW (editable)</div>
