interface SolarCosts {
  solarPanels: number; inverter: number; battery: number;
  structure: number; cablesWiring: number; netMeter: number;
  transport: number; installation: number; miscAccessories: number;
  serviceCharge5yr: number; contractorProfit: number;
}
function solarDefaultCosts(plantType: string, kw: number, phase: string = "1ph", panelQty: number = 0, wattage: number = 580): SolarCosts {
  // Panel cost = qty × wattage × ₹32/watt (inclusive of GST)
  const panelCost = panelQty > 0 ? panelQty * wattage * (PANEL_RATE_PER_KW.dcr / 600) : kw * PANEL_RATE_PER_KW.dcr;
  const structure        = kw * 6000;
  const cablesWiring     = kw * 6000;
  const transport        = kw * 2000;
  const installation     = kw * 3000;
  const miscAccessories  = kw * 3500;
  const serviceCharge5yr = kw * 4000;
  const contractorProfit = kw * 3500;

  if (plantType === "hybrid") {
    const invRate = phase === "3ph" ? (kw <= 20 ? 27000 : 18000) : (kw <= 6 ? 16000 : kw <= 20 ? 27000 : 18000);
    return { solarPanels: panelCost, inverter: kw*invRate, battery: kw*13000,
      structure, cablesWiring, netMeter: kw*1000, transport, installation,
      miscAccessories, serviceCharge5yr, contractorProfit };
  }
  if (plantType === "offgrid") {
    const invRate = phase === "3ph" ? (kw <= 20 ? 27000 : 18000) : (kw <= 5 ? 12000 : kw <= 20 ? 27000 : 18000);
    return { solarPanels: panelCost, inverter: kw*invRate, battery: kw*13000,
      structure, cablesWiring, netMeter: 0, transport, installation,
      miscAccessories, serviceCharge5yr, contractorProfit };
  }
  if (plantType === "ongrid") {
    const invRate = phase === "3ph" ? 8000 : 6000;
    return { solarPanels: panelCost, inverter: kw*invRate, battery: 0,
      structure, cablesWiring, netMeter: kw*1000, transport, installation,
      miscAccessories, serviceCharge5yr, contractorProfit };
  }
  if (plantType === "vfd_offgrid") {
    return { solarPanels: panelCost, inverter: kw*2500, battery: 0,
      structure, cablesWiring, netMeter: 0, transport, installation,
      miscAccessories, serviceCharge5yr, contractorProfit };
  }
  if (plantType === "vfd_autogrid") {
    return { solarPanels: panelCost, inverter: kw*3000, battery: 0,
      structure, cablesWiring, netMeter: kw*1000, transport, installation,
      miscAccessories, serviceCharge5yr, contractorProfit };
  }
  return { solarPanels: panelCost, inverter: kw*16000, battery: kw*13000,
    structure, cablesWiring, netMeter: kw*1000, transport, installation,
    miscAccessories, serviceCharge5yr, contractorProfit };
}


