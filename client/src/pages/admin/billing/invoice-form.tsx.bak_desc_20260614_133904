// ── Types ────────────────────────────────────────────────────────────────────

interface Company { id: number; name: string; gstin: string; state_code: string; invoice_prefix: string; }
interface Product { id: number; name: string; hsn_code: string; unit: string; default_sale_price: string; gst_rate: string; category: string; }
interface Customer { id: number; name: string; gstin: string | null; phone: string; email?: string; state: string; state_code: string; address: string; city: string; district?: string; customer_type: string; }

interface LineItem {
  key: string; product_id: number | null; description: string; serial_numbers?: string;
  hsn_code: string; quantity: number; unit: string; rate: number;
  discount_percent: number; gst_rate: number; cess_rate: number;
  discount_amount: number; taxable_value: number;
  cgst_rate: number; cgst_amount: number;
  sgst_rate: number; sgst_amount: number;
  igst_rate: number; igst_amount: number;
  total_amount: number;
}

// ── Helpers ──────────────────────────────────────────────────────────────────

function uid(): string { return Math.random().toString(36).slice(2, 9); }

function formatINR(n: number): string {
  return new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(n);
}

function emptyItem(): LineItem {
  return {
    key: uid(), product_id: null, description: "", hsn_code: "", quantity: 1, unit: "Nos",
    rate: 0, discount_percent: 0, gst_rate: 12, cess_rate: 0,
    discount_amount: 0, taxable_value: 0,
    cgst_rate: 0, cgst_amount: 0, sgst_rate: 0, sgst_amount: 0,
    igst_rate: 0, igst_amount: 0, total_amount: 0,
  };
}

function calcItem(item: LineItem, sellerState: string, buyerState: string): LineItem {
  const gross = item.quantity * item.rate;
  const discAmt = Math.round(gross * item.discount_percent / 100 * 100) / 100;
  const taxable = Math.round((gross - discAmt) * 100) / 100;
  const inter = sellerState !== buyerState;
  const cgstR = inter ? 0 : item.gst_rate / 2;
  const sgstR = inter ? 0 : item.gst_rate / 2;
  const igstR = inter ? item.gst_rate : 0;
  const cgstA = Math.round(taxable * cgstR / 100 * 100) / 100;
  const sgstA = Math.round(taxable * sgstR / 100 * 100) / 100;
  const igstA = Math.round(taxable * igstR / 100 * 100) / 100;
  const total = Math.round((taxable + cgstA + sgstA + igstA) * 100) / 100;
  return { ...item, discount_amount: discAmt, taxable_value: taxable, cgst_rate: cgstR, cgst_amount: cgstA, sgst_rate: sgstR, sgst_amount: sgstA, igst_rate: igstR, igst_amount: igstA, total_amount: total };
}

const ONES = ["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen"];
const TENS = ["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];
function tw(n: number): string { if (n < 20) return ONES[n]; return TENS[Math.floor(n/10)] + (n%10 ? " "+ONES[n%10] : ""); }
function thr(n: number): string { if (!n) return ""; const h=Math.floor(n/100),r=n%100; let s=h?ONES[h]+" Hundred":""; if(r) s+=(h?" and ":"")+tw(r); return s; }
function amtWords(a: number): string {
  if (a === 0) return "Zero Rupees Only";
  const r=Math.floor(Math.abs(a)); let w="";
  const cr=Math.floor(r/10000000),lk=Math.floor((r%10000000)/100000),th=Math.floor((r%100000)/1000),hd=r%1000;
  if(cr) w+=thr(cr)+" Crore "; if(lk) w+=tw(lk)+" Lakh "; if(th) w+=tw(th)+" Thousand "; if(hd) w+=thr(hd);
  return "Rupees " + w.trim() + " Only";
}

