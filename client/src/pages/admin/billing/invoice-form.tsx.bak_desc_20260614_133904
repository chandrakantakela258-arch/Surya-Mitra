            <p className="text-sm text-gray-500">GST-compliant tax invoice</p>
          </div>
        </div>
        {savedInvoiceId && (
          <div className="flex gap-2">
            <Button variant="outline" onClick={downloadPDF}  size="sm">
              <Download className="w-4 h-4 mr-1" /> PDF
            </Button>
            <Button variant="outline" onClick={sendEmail} size="sm" className="text-blue-600 border-blue-300 hover:bg-blue-50">
              <Mail className="w-4 h-4 mr-1" /> Email
            </Button>
            <Button variant="outline" onClick={sendWhatsApp} size="sm" className="text-green-600 border-green-300 hover:bg-green-50">
              <Phone className="w-4 h-4 mr-1" /> WhatsApp
            </Button>
          </div>
        )}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Left: Form */}
        <div className="lg:col-span-2 space-y-6">

          {/* Company + Invoice Details */}
