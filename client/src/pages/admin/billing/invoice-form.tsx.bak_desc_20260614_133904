  "21": "Odisha", "22": "Chhattisgarh", "23": "Madhya Pradesh", "19": "West Bengal",
  "27": "Maharashtra", "07": "Delhi", "06": "Haryana", "33": "Tamil Nadu",
  "29": "Karnataka", "32": "Kerala", "36": "Telangana", "37": "Andhra Pradesh",
  "24": "Gujarat", "03": "Punjab", "05": "Uttarakhand", "02": "Himachal Pradesh",
  "11": "Sikkim", "18": "Assam", "01": "Jammu & Kashmir",
};

// ── Component ────────────────────────────────────────────────────────────────

export default function InvoiceForm() {
  const [, navigate] = useLocation();
  const [companies, setCompanies] = useState<Company[]>([]);
  const [products, setProducts] = useState<Product[]>([]);
  const [segments, setSegments] = useState<Record<string, any[]>>({});
  const [openSegs, setOpenSegs] = useState<Set<string>>(new Set());
  const [customers, setCustomers] = useState<Customer[]>([]);
  const [saving, setSaving] = useState(false);
  const [savedInvoiceId, setSavedInvoiceId] = useState<number | null>(null);
  const [savedInvoiceNo, setSavedInvoiceNo] = useState<string>("");
  // PDF opens in new tab, no loading state needed

  // Form state
  const [companyId, setCompanyId] = useState<number>(1);
  const [customerId, setCustomerId] = useState<string | null>(null);
  const [invoiceType, setInvoiceType] = useState("tax_invoice");
  const [invoiceDate, setInvoiceDate] = useState(new Date().toISOString().split("T")[0]);
  const [dueDate, setDueDate] = useState("");
  const [notes, setNotes] = useState("");
  const [terms, setTerms] = useState("100% Advance Payment before the goods dispatch.");
  const [paymentMode, setPaymentMode] = useState("cash");
  const [hypothecatedTo, setHypothecatedTo] = useState("");
  const [items, setItems] = useState<LineItem[]>([emptyItem()]);

  // BOS Auto-Calculate
  const [bosKw, setBosKw] = useState<string>("");
  const [bosType, setBosType] = useState<string>("hybrid_la_single");
  const [bosPhase, setBosPhase] = useState<string>("single");

  // Customer search
  const [customerSearch, setCustomerSearch] = useState("");
  const [showCustomerDropdown, setShowCustomerDropdown] = useState(false);
  const [selectedCustomer, setSelectedCustomer] = useState<Customer | null>(null);

  // New customer inline
  const [showNewCustomer, setShowNewCustomer] = useState(false);
  const [newCust, setNewCust] = useState({ name: "", phone: "", gstin: "", address: "", city: "", state: "Bihar", state_code: "10", pin: "", email: "" });

  // Derived
  const company = companies.find(c => c.id === companyId);
  const sellerState = company?.state_code || "10";
  const buyerState = selectedCustomer?.state_code || newCust.state_code || "10";
  const isInter = sellerState !== buyerState;

  // ── Load data ──────────────────────────────────────────────
  useEffect(() => {
    Promise.all([
      fetch("/api/billing/companies").then(r => r.json()),
      fetch("/api/billing/products").then(r => r.json()),
      fetch("/api/billing/products/segments").then(r => r.json()).catch(() => ({ segments: {} })),
    ]).then(([co, pr, seg]) => {
      setCompanies(co);
      setProducts(pr);
      if (seg && seg.segments) setSegments(seg.segments);
      if (co.length) setCompanyId(co[0].id);
    });
  }, []);

  // Search customers
  useEffect(() => {
    if (false) // allow empty search
    if (customerSearch.length < 0) { setCustomers([]); return; }
    const t = setTimeout(() => {
      fetch(`/api/billing/customers/search?q=${encodeURIComponent(customerSearch)}`).then(r => r.json()).then(d => setCustomers(d.customers || []));
    }, 300);
    return () => clearTimeout(t);
  }, [customerSearch]);

  // ── Recalculate items when state changes ───────────────────
  const recalcItems = useCallback((currentItems: LineItem[]) => {
    return currentItems.map(it => calcItem(it, sellerState, buyerState));
  }, [sellerState, buyerState]);

  useEffect(() => {
    setItems(prev => recalcItems(prev));
  }, [sellerState, buyerState, recalcItems]);

  // ── Line item handlers ─────────────────────────────────────
  const updateItem = (key: string, field: string, value: any) => {
    setItems(prev => {
      return prev.map(it => {
        if (it.key !== key) return it;
        const newIt = { ...it, [field]: value };
        return calcItem(newIt, sellerState, buyerState);
      });
    });
  };

  const addFromCatalog = (catProd: any) => {
    const p = products.find(x => x.id === catProd.id);
    if (!p) return;
    setItems(prev => {
      const existing = prev.findIndex(i => i.product_id === p.id);
      if (existing >= 0) {
        return prev.map((it, idx) => {
          if (idx !== existing) return it;
          return calcItem({ ...it, quantity: it.quantity + 1 }, sellerState, buyerState);
        });
      }
      const fresh = calcItem({
        key: uid(), product_id: p.id, description: p.name,
        hsn_code: p.hsn_code, quantity: 1, unit: p.unit,
        rate: parseFloat(p.default_sale_price), discount_percent: 0,
        gst_rate: parseFloat(p.gst_rate), cess_rate: 0,
        discount_amount: 0, taxable_value: 0,
        cgst_rate: 0, cgst_amount: 0, sgst_rate: 0, sgst_amount: 0,
        igst_rate: 0, igst_amount: 0, total_amount: 0,
      }, sellerState, buyerState);
      const emptyIdx = prev.findIndex(i => !i.product_id && !i.description);
      if (emptyIdx >= 0) return prev.map((it, idx) => idx === emptyIdx ? fresh : it);
      return [...prev, fresh];
    });
  };

  const toggleSeg = (s: string) => setOpenSegs(prev => { const n = new Set(prev); n.has(s) ? n.delete(s) : n.add(s); return n; });

  const selectProduct = (key: string, productId: string) => {
    const prod = products.find(p => p.id === parseInt(productId));
    if (!prod) return;
    setItems(prev => prev.map(it => {
      if (it.key !== key) return it;
      const newIt = {
        ...it, product_id: prod.id, description: prod.name,
        hsn_code: prod.hsn_code, unit: prod.unit,
        rate: parseFloat(prod.default_sale_price), gst_rate: parseFloat(prod.gst_rate),
      };
      return calcItem(newIt, sellerState, buyerState);
    }));
  };

  const addItem = () => setItems(prev => [...prev, emptyItem()]);
  const removeItem = (key: string) => setItems(prev => {
    const filtered = prev.filter(it => it.key !== key);
    return filtered.length === 0 ? [emptyItem()] : filtered;
  });

  // ── Totals ─────────────────────────────────────────────────
  const subtotal = items.reduce((s, i) => s + i.quantity * i.rate, 0);
  const totalDiscount = items.reduce((s, i) => s + i.discount_amount, 0);
  const taxableAmount = items.reduce((s, i) => s + i.taxable_value, 0);
  const cgstTotal = items.reduce((s, i) => s + i.cgst_amount, 0);
  const sgstTotal = items.reduce((s, i) => s + i.sgst_amount, 0);
  const igstTotal = items.reduce((s, i) => s + i.igst_amount, 0);
  const rawTotal = taxableAmount + cgstTotal + sgstTotal + igstTotal;
  const grandTotal = Math.round(rawTotal);
  const roundOff = Math.round((grandTotal - rawTotal) * 100) / 100;

  // ── Select customer ────────────────────────────────────────
  const pickCustomer = (c: Customer) => {
    setSelectedCustomer(c);
    setCustomerId(String(c.id));
    setCustomerSearch(c.name);
    setShowCustomerDropdown(false);
    setNewCust(prev => ({
      ...prev,
      name: c.name || prev.name,
      phone: c.phone || prev.phone,
      email: (c as any).email || prev.email,
      address: c.address || prev.address,
      city: c.city || c.district || prev.city,
      state: c.state || prev.state,
      state_code: c.state_code || prev.state_code,
    }));
  };

  // ── Create customer inline ─────────────────────────────────
  const createCustomer = async () => {
    try {
      const res = await fetch("/api/billing/customers", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(newCust) });
      const created = await res.json();
      pickCustomer(created);
      setShowNewCustomer(false);
    } catch (e) { console.error(e); }
  };

  // ── Submit — stays on page, sets savedInvoiceId ────────────
  const handleSubmit = async () => {
    if (!customerId) { alert("Please select a customer"); return; }
    if (items.length === 0 || items.every(i => !i.description)) { alert("Add at least one line item"); return; }

    setSaving(true);
    try {
      const payload = {
        company_id: companyId,
        customer_id: customerId,
        invoice_type: invoiceType,
        invoice_date: invoiceDate,
        due_date: dueDate || null,
        place_of_supply: buyerState,
        notes, hypothecated_to: hypothecatedTo || null, terms: paymentMode === "cash" ? terms + "\n\nNOTE: Please make a 70% advance payment to dispatch the item and the remaining 30% after the item reaches the execution site." : terms,
        // Include customer contact info for PDF generation
        buyer_phone: newCust.phone || selectedCustomer?.phone || "",
        buyer_email: newCust.email || (selectedCustomer as any)?.email || "",
        items: items.filter(i => i.description).map(i => ({
          product_id: i.product_id,
          description: i.serial_numbers ? `${i.description}\nSerial No: ${i.serial_numbers}` : i.description,
          hsn_code: i.hsn_code, quantity: i.quantity, unit: i.unit,
          rate: i.rate, discount_percent: i.discount_percent,
          gst_rate: i.gst_rate, cess_rate: i.cess_rate, serial_numbers: i.serial_numbers || null,
        })),
      };

      const res = await fetch("/api/billing/invoices", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const data = await res.json();

      if (res.ok) {
        const id = data.invoice?.id || data.id;
        const no = data.invoice?.invoice_no || data.invoice_no || "";
        setSavedInvoiceId(id);
        setSavedInvoiceNo(no);
        // Don't navigate away — stay on page to show share options
      } else {
        alert("Error: " + (data.error || "Failed to create invoice"));
      }
    } catch (e: any) {
      alert("Error: " + e.message);
    } finally { setSaving(false); }
  };

  // ── PDF / Email / WhatsApp ─────────────────────────────────
  function getPdfUrl(): string {
    return `${window.location.origin}/api/billing/invoices/${savedInvoiceId}/pdf`;
  }

  function downloadPDF() {
    if (!savedInvoiceId) return;
    window.open(`/api/billing/invoices/${savedInvoiceId}/pdf`, "_blank");
  }

  async function sendEmail() {
    if (!savedInvoiceId) return;
    const email = newCust.email || (selectedCustomer as any)?.email;
    if (!email) { alert("Enter customer email first"); return; }
    try {
      const res = await fetch(`/api/billing/invoices/${savedInvoiceId}/send-email`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (data.success) {
        alert("✅ Email sent to " + email);
      } else {
        alert("Email failed: " + (data.error || "Unknown error"));
      }
    } catch (err) { console.error(err); alert("Failed to send email"); }
  }

  function sendWhatsApp() {
    if (!savedInvoiceId) return;
    const phone = newCust.phone || selectedCustomer?.phone;
    if (!phone) { alert("Enter customer WhatsApp number first"); return; }
    const clean = phone.replace(/[^0-9]/g, "");
    const wa = clean.startsWith("91") ? clean : "91" + clean;
    const pdfUrl = getPdfUrl();
    const custName = newCust.name || selectedCustomer?.name || "Customer";

    const itemLines = items
      .filter(i => i.description)
      .slice(0, 5)
      .map((i, idx) => `${idx + 1}. ${i.description} × ${i.quantity} = ${formatINR(i.total_amount)}`)
      .join("\n");
    const moreCount = items.filter(i => i.description).length - 5;
    const moreText = moreCount > 0 ? `\n... and ${moreCount} more items` : "";

    const msg = encodeURIComponent(
      `*Invoice ${savedInvoiceNo} — Divyanshi Solar* ☀️\n\n` +
      `Dear ${custName},\n\n` +
      `${itemLines}${moreText}\n\n` +
      `*Total: ${formatINR(grandTotal)}*\n\n` +
      `📄 PDF: ${pdfUrl}\n\n` +
      `Thank you!\n_Divyanshi Solar_ | 📞 9801005212`
    );
    window.open(`https://wa.me/${wa}?text=${msg}`, "_blank");
  }

  // ── Segment colors ─────────────────────────────────────────
  const colors: Record<string, string> = {
    "Solar Panels": "#f59e0b", "Ongrid Inverter": "#10b981", "Offgrid Inverter": "#06b6d4",
    "Acid Lead Battery": "#ef4444", "Lithium Battery": "#22c55e", "Grid Interactive Hybrid": "#6366f1",
    "Small Inverters": "#f97316", "Solar Inverter IPD 21": "#3b82f6",
    "Solar High Frequency Inverter IP65": "#8b5cf6",
  };

  return (
    <div className="p-6 space-y-6 max-w-[1400px] mx-auto">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-4">
          <Button variant="ghost" size="sm" onClick={() => navigate("/admin/billing")}>
