            </CardHeader>
            <CardContent>
              {showNewCustomer ? (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  <div><Label>Name *</Label><Input value={newCust.name} onChange={e => setNewCust({...newCust, name: e.target.value})} /></div>
                  <div><Label>Phone</Label><Input value={newCust.phone} onChange={e => setNewCust({...newCust, phone: e.target.value})} /></div>
                  <div><Label>Email</Label><Input value={newCust.email} onChange={e => setNewCust({...newCust, email: e.target.value})} /></div>
                  <div><Label>GSTIN (B2B)</Label><Input value={newCust.gstin} onChange={e => setNewCust({...newCust, gstin: e.target.value})} placeholder="Leave blank for B2C" /></div>
                  <div className="col-span-2"><Label>Address</Label><Input value={newCust.address} onChange={e => setNewCust({...newCust, address: e.target.value})} /></div>
                  <div><Label>City</Label><Input value={newCust.city} onChange={e => setNewCust({...newCust, city: e.target.value})} /></div>
                  <div>
                    <Label>State</Label>
                    <Select value={newCust.state_code} onValueChange={v => setNewCust({...newCust, state_code: v, state: INDIAN_STATES[v] || ""})}>
                      <SelectTrigger><SelectValue /></SelectTrigger>
                      <SelectContent>{Object.entries(INDIAN_STATES).map(([code, name]) => <SelectItem key={code} value={code}>{name}</SelectItem>)}</SelectContent>
                    </Select>
                  </div>
                  <div><Label>PIN</Label><Input value={newCust.pin} onChange={e => setNewCust({...newCust, pin: e.target.value})} /></div>
                  <div className="col-span-3 flex justify-end"><Button size="sm" onClick={createCustomer} disabled={!newCust.name}>Create & Select</Button></div>
                </div>
              ) : (
                <div className="relative">
                  <div className="relative">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                    <Input
                      className="pl-9"
                      placeholder="Search customer by name, phone, or GSTIN..."
                      value={customerSearch}
                      onChange={e => { setCustomerSearch(e.target.value); setShowCustomerDropdown(true); }}
                      onFocus={() => { if(customerSearch.length===0){ fetch('/api/billing/customers/search?q=').then(r=>r.json()).then(d=>{ setCustomers(d.customers||[]); setShowCustomerDropdown(true); }); } else setShowCustomerDropdown(true); }}
                    />
                  </div>
                  {showCustomerDropdown && customers.length > 0 && (
                    <div className="absolute z-10 w-full mt-1 bg-white border rounded-lg shadow-lg max-h-48 overflow-y-auto">
                      {customers.map(c => (
                        <button key={c.id} className="w-full text-left px-4 py-2.5 hover:bg-gray-50 border-b last:border-0" onClick={() => pickCustomer(c)}>
                          <div className="flex items-center justify-between">
                            <span className="font-medium text-sm">{c.name}</span>
                            <Badge variant="outline" className="text-xs">{c.customer_type}</Badge>
                          </div>
                          <div className="text-xs text-gray-500">{c.phone} {c.gstin ? `| ${c.gstin}` : ""} | {c.state}</div>
                        </button>
                      ))}
                    </div>
                  )}
                  {selectedCustomer && (
                    <div className="mt-3 p-3 bg-blue-50 rounded-lg text-sm">
                      <div className="flex justify-between">
                        <span className="font-medium">{selectedCustomer.name}</span>
                        <Badge>{selectedCustomer.customer_type}</Badge>
                      </div>
                      <div className="text-gray-600 mt-1">
                        {selectedCustomer.phone} | {selectedCustomer.state} ({selectedCustomer.state_code})
                        {selectedCustomer.gstin && <span> | GSTIN: {selectedCustomer.gstin}</span>}
                      </div>
                      {isInter && (
                        <div className="mt-1 text-orange-600 font-medium text-xs">
                          ⚠ Inter-state supply — IGST will apply
                        </div>
                      )}
                    </div>
                  )}
                </div>
              )}
            </CardContent>
          </Card>

          {/* BOS Auto-Calculate */}
          <Card className="border-blue-200 bg-blue-50">
            <CardHeader className="pb-2">
              <CardTitle className="text-sm text-blue-800">⚡ BOS Auto-Calculate — Add All BOS Items by Plant Capacity</CardTitle>
            </CardHeader>
            <CardContent className="pt-0 space-y-3">
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <Label className="text-xs">Plant Capacity (kW)</Label>
                  <Input type="number" placeholder="e.g. 5" value={bosKw} onChange={e => setBosKw(e.target.value)} className="h-8 text-sm" />
                </div>
                <div>
                  <Label className="text-xs">System Type</Label>
                  <Select value={bosType} onValueChange={setBosType}>
                    <SelectTrigger className="h-8 text-xs"><SelectValue /></SelectTrigger>
                    <SelectContent>
                      <SelectItem value="ongrid_single">On-Grid Single Phase</SelectItem>
                      <SelectItem value="ongrid_three">On-Grid Three Phase</SelectItem>
                      <SelectItem value="hybrid_la_single">Hybrid Lead Acid — Single Phase</SelectItem>
                      <SelectItem value="hybrid_la_three">Hybrid Lead Acid — Three Phase</SelectItem>
                      <SelectItem value="hybrid_li_single">Hybrid Lithium — Single Phase</SelectItem>
                      <SelectItem value="hybrid_li_three">Hybrid Lithium — Three Phase</SelectItem>
                      <SelectItem value="vfd_offgrid_single">VFD Off-Grid — Single Phase</SelectItem>
                      <SelectItem value="vfd_offgrid_three">VFD Off-Grid — Three Phase</SelectItem>
                      <SelectItem value="vfd_autogrid_single">VFD Auto-Grid — Single Phase</SelectItem>
                      <SelectItem value="vfd_autogrid_three">VFD Auto-Grid — Three Phase</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
              </div>
              <div className="grid grid-cols-2 gap-2 text-xs text-blue-700 bg-white rounded p-2 border border-blue-100">
                {(() => {
                  const kw = parseFloat(bosKw) || 0;
                  const rateMap: Record<string,number> = { ongrid_single:4500, ongrid_three:4800, hybrid_la_single:5500, hybrid_la_three:5800, hybrid_li_single:5500, hybrid_li_three:5800, vfd_offgrid_single:4500, vfd_offgrid_three:4800, vfd_autogrid_single:4800, vfd_autogrid_three:5000 };
                  const bosRate = rateMap[bosType] || 5500;
                  return <>
                    <span>BOS: ₹{(kw * bosRate).toLocaleString("en-IN")}</span>
                    <span>Transport: ₹{(kw * 2000).toLocaleString("en-IN")}</span>
                    <span>Installation: ₹{(kw * 3500).toLocaleString("en-IN")}</span>
                    <span>Misc: ₹{(kw * 3000).toLocaleString("en-IN")}</span>
                    <span>Net Metering: ₹{(kw * 2000).toLocaleString("en-IN")}</span>
                    <span className="font-bold">Total: ₹{(kw*(bosRate+2000+3500+3000+2000)).toLocaleString("en-IN")}</span>
                  </>;
                })()}
              </div>
              <Button size="sm" className="w-full bg-blue-600 hover:bg-blue-700 text-white text-xs" onClick={() => {
                const kw = parseFloat(bosKw);
                if (!kw || kw <= 0) return;
                const rateMap: Record<string,number> = { ongrid_single:4500, ongrid_three:4800, hybrid_la_single:5500, hybrid_la_three:5800, hybrid_li_single:5500, hybrid_li_three:5800, vfd_offgrid_single:4500, vfd_offgrid_three:4800, vfd_autogrid_single:4800, vfd_autogrid_three:5000 };
                const bosRate = rateMap[bosType] || 5500;
                const newItems = [
                  { description: `BOS (Balance of System) — ${bosType.replace("_"," ")} ${kw}kW`, hsn_code: "8504", quantity: kw, unit: "kW", rate: bosRate,  gst_rate: 18, product_id: null },
                  { description: `Transportation Charges — ${kw}kW Plant`,                          hsn_code: "9967", quantity: kw, unit: "kW", rate: 2000,    gst_rate: 18, product_id: null },
                  { description: `Installation Charges — ${kw}kW Plant`,                            hsn_code: "9987", quantity: kw, unit: "kW", rate: 3500,    gst_rate: 18, product_id: null },
                  { description: `Miscellaneous Expenses — ${kw}kW Plant`,                          hsn_code: "9987", quantity: kw, unit: "kW", rate: 3000,    gst_rate: 18, product_id: null },
                  { description: `Net Metering Charges — ${kw}kW Plant`,                            hsn_code: "9987", quantity: kw, unit: "kW", rate: 2000,    gst_rate: 18, product_id: null },
                ].map(i => ({ ...emptyItem(), key: Math.random().toString(36).slice(2), product_id: null, description: i.description, hsn_code: i.hsn_code, quantity: i.quantity, unit: i.unit, rate: i.rate, gst_rate: i.gst_rate, discount_percent: 0, cess_rate: 0 }));
                setItems(prev => {
                  const clean = prev.filter(x => x.description || x.product_id);
                  return [...clean, ...newItems];
                });
              }}>
                ➕ Add All BOS + Services to Invoice ({bosKw || "0"} kW)
              </Button>
            </CardContent>
          </Card>

          {/* Product Catalog */}
          {Object.keys(segments).length > 0 && (
            <Card>
              <CardHeader className="pb-2"><CardTitle className="text-sm">📦 Product Catalog — Click to Add</CardTitle></CardHeader>
              <CardContent className="pt-0">
                <div className="max-h-[350px] overflow-y-auto space-y-1">
                  {Object.entries(segments).map(([seg, prods]) => (
                    <div key={seg} className="border rounded-lg overflow-hidden">
                      <button onClick={() => toggleSeg(seg)} className="w-full flex items-center justify-between p-2 px-3 hover:bg-gray-50 text-sm font-medium" style={{ borderLeft: "4px solid " + (colors[seg] || "#6b7280") }}>
                        <span>{seg} <span className="text-xs text-gray-400 ml-1">({(prods as any[]).length})</span></span>
                        {openSegs.has(seg) ? <ChevronDown className="w-4 h-4" /> : <ChevronRight className="w-4 h-4" />}
                      </button>
                      {openSegs.has(seg) && (
                        <div className="border-t divide-y">
                          {(prods as any[]).map((p: any) => (
                            <div key={p.id} className="flex items-center justify-between p-1.5 px-3 hover:bg-green-50 cursor-pointer text-xs" onClick={() => addFromCatalog(p)}>
                              <span className="truncate font-medium">{p.name}</span>
                              <span className="text-green-700 font-semibold ml-2 whitespace-nowrap">₹{parseFloat(p.price || p.default_sale_price || "0").toLocaleString("en-IN")}</span>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          )}

          {/* Line Items */}
          <Card>
            <CardHeader className="flex flex-row items-center justify-between">
              <CardTitle className="text-base">Line Items</CardTitle>
              <Button variant="outline" size="sm" onClick={addItem}><Plus className="w-3 h-3 mr-1" />Add Item</Button>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b text-xs text-gray-500 uppercase">
                      <th className="text-left pb-2 w-8">#</th>
                      <th className="text-left pb-2 min-w-[200px]">Product / Description</th>
                      <th className="text-left pb-2 w-20">HSN</th>
                      <th className="text-right pb-2 w-16">Qty</th>
                      <th className="text-right pb-2 w-24">Rate</th>
                      <th className="text-right pb-2 w-16">Disc%</th>
                      <th className="text-right pb-2 w-20">GST%</th>
                      <th className="text-right pb-2 w-24">Taxable</th>
                      <th className="text-right pb-2 w-20">{isInter ? "IGST" : "CGST"}</th>
                      {!isInter && <th className="text-right pb-2 w-20">SGST</th>}
                      <th className="text-right pb-2 w-24">Total</th>
                      <th className="w-8"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {items.map((item, idx) => (
                      <tr key={item.key} className="border-b last:border-0">
                        <td className="py-2 text-gray-400">{idx + 1}</td>
                        <td className="py-2 pr-2">
                          <Select value={item.product_id ? String(item.product_id) : ""} onValueChange={v => selectProduct(item.key, v)}>
                            <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select product..." /></SelectTrigger>
                            <SelectContent>
                              {products.map(p => (
                                <SelectItem key={p.id} value={String(p.id)}>
                                  <span className="text-xs">{p.name} — {formatINR(parseFloat(p.default_sale_price))}</span>
                                </SelectItem>
                              ))}
                            </SelectContent>
                          </Select>
                          <Input className="mt-1 h-7 text-xs" placeholder="Custom description" value={item.description} onChange={e => updateItem(item.key, "description", e.target.value)} />
                          <Input className="mt-1 h-7 text-xs" placeholder="Serial No. (Panel/Inverter/Battery)" value={item.serial_numbers || ""} onChange={e => updateItem(item.key, "serial_numbers", e.target.value)} />
                        </td>
                        <td className="py-2"><Input className="h-8 text-xs w-20" value={item.hsn_code} onChange={e => updateItem(item.key, "hsn_code", e.target.value)} /></td>
                        <td className="py-2"><Input type="number" className="h-8 text-xs text-right w-16" min={0} value={item.quantity} onChange={e => updateItem(item.key, "quantity", parseFloat(e.target.value) || 0)} /></td>
                        <td className="py-2"><Input type="number" className="h-8 text-xs text-right w-24" min={0} value={item.rate} onChange={e => updateItem(item.key, "rate", parseFloat(e.target.value) || 0)} /></td>
                        <td className="py-2"><Input type="number" className="h-8 text-xs text-right w-16" min={0} max={100} value={item.discount_percent} onChange={e => updateItem(item.key, "discount_percent", parseFloat(e.target.value) || 0)} /></td>
                        <td className="py-2">
                          <Select value={String(item.gst_rate)} onValueChange={v => updateItem(item.key, "gst_rate", parseFloat(v))}>
                            <SelectTrigger className="h-8 text-xs w-20"><SelectValue /></SelectTrigger>
                            <SelectContent>
                              {[0, 5, 12, 18, 28].map(r => <SelectItem key={r} value={String(r)}>{r}%</SelectItem>)}
                            </SelectContent>
                          </Select>
                        </td>
                        <td className="py-2 text-right text-xs font-medium">{formatINR(item.taxable_value)}</td>
                        <td className="py-2 text-right text-xs">{formatINR(isInter ? item.igst_amount : item.cgst_amount)}</td>
                        {!isInter && <td className="py-2 text-right text-xs">{formatINR(item.sgst_amount)}</td>}
                        <td className="py-2 text-right text-xs font-bold">{formatINR(item.total_amount)}</td>
                        <td className="py-2">
                          {items.length > 1 && (
                            <Button variant="ghost" size="sm" className="h-7 w-7 p-0 text-red-400 hover:text-red-600" onClick={() => removeItem(item.key)}>
                              <Trash2 className="w-3 h-3" />
                            </Button>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>

          {/* Notes & Terms */}
          <Card>
            <CardContent className="pt-6 space-y-4">
              {/* Payment Mode — shown for proforma invoices */}
              {invoiceType === "proforma" && (
                <div>
                  <Label className="text-sm font-semibold mb-2 block">Payment Mode</Label>
                  <div className="flex gap-3 flex-wrap">
                    {[
                      { value: "cash",    label: "💵 Cash Payment" },
                      { value: "loan",    label: "🏦 Bank Loan" },
                      { value: "paisaloo", label: "📱 Paisaloo NBFC Loan" },
                    ].map(opt => (
                      <button key={opt.value} type="button"
                        onClick={() => setPaymentMode(opt.value)}
                        className={`px-4 py-2 rounded-lg border-2 text-sm font-semibold transition-all ${
                          paymentMode === opt.value
                            ? "border-orange-500 bg-orange-50 text-orange-700"
                            : "border-gray-200 bg-white text-gray-600 hover:border-orange-300"
                        }`}>
                        {opt.label}
                      </button>
                    ))}
                  </div>
                  {paymentMode === "cash" && (
                    <div className="mt-3 p-4 rounded-xl border-2 border-red-400 bg-red-50">
                      <p className="text-red-700 font-black text-base tracking-wide uppercase">
                        ⚠️ NOTE — ADVANCE PAYMENT REQUIRED
                      </p>
                      <p className="text-red-800 font-bold text-sm mt-1">
                        Please make a <span className="text-red-600 text-base underline underline-offset-2">70% advance payment</span> to dispatch the item and the remaining <span className="text-red-600 text-base underline underline-offset-2">30%</span> after the item reaches the execution site.
                      </p>
                    </div>
                  )}
                  {paymentMode === "loan" && (
                    <div className="mt-3 p-3 rounded-lg border border-blue-300 bg-blue-50">
                      <p className="text-blue-800 font-semibold text-sm">🏦 Bank Loan — Payment will be processed through bank financing. Loan sanction letter required before dispatch.</p>
                    </div>
                  )}
                  {paymentMode === "paisaloo" && (
                    <div className="mt-3 p-3 rounded-lg border border-purple-300 bg-purple-50">
                      <p className="text-purple-800 font-semibold text-sm">📱 Paisaloo NBFC Loan — Financed through Paisaloo. Loan disbursement confirmation required before dispatch.</p>
                    </div>
                  )}
                </div>
              )}
              {/* Hypothecation */}
              <div className="p-4 rounded-xl border-2 border-orange-200 bg-orange-50">
                <Label className="text-sm font-semibold text-orange-800 mb-2 block">🏦 Hypothecation (Financing Institution)</Label>
                <select
                  value={hypothecatedTo}
                  onChange={e => setHypothecatedTo(e.target.value)}
                  className="w-full border border-orange-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-orange-400"
                >
                  <option value="">-- None / Self Financed --</option>
                  <option value="Paisalo Digital Limited">Paisalo Digital Limited</option>
                  <option value="Solfin Sustainable Finance Private Limited">Solfin Sustainable Finance Private Limited</option>
                  <option value="Metafin Cleantech Finance Private Limited">Metafin Cleantech Finance Private Limited</option>
                  <option value="Ecofy Finance Private Limited">Ecofy Finance Private Limited</option>
                  <option value="Annapurna Finance Private Limited">Annapurna Finance Private Limited</option>
                  <option value="State Bank of India">State Bank of India</option>
                  <option value="Bank of India">Bank of India</option>
                  <option value="Punjab National Bank">Punjab National Bank</option>
                  <option value="Canara Bank">Canara Bank</option>
                  <option value="Union Bank of India">Union Bank of India</option>
                  <option value="HDFC Bank">HDFC Bank</option>
                  <option value="ICICI Bank">ICICI Bank</option>
                  <option value="Axis Bank">Axis Bank</option>
                  <option value="Other NBFC / Bank">Other NBFC / Bank</option>
                </select>
                {hypothecatedTo && (
                  <p className="mt-2 text-orange-900 font-bold text-sm border border-orange-400 bg-white rounded-lg px-3 py-2">
                    ⚠️ This asset is hypothecated to: <span className="text-orange-700 uppercase">{hypothecatedTo}</span>
                  </p>
                )}
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <Label>Notes</Label>
                  <Textarea rows={3} value={notes} onChange={e => setNotes(e.target.value)} placeholder="Additional notes..." />
                </div>
                <div>
                  <Label>Terms & Conditions</Label>
                  <Textarea rows={3} value={terms} onChange={e => setTerms(e.target.value)} />
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Post-save Share Card */}
          {savedInvoiceId && (
            <Card className="border-green-300 bg-green-50/50">
              <CardContent className="pt-4">
                <p className="text-sm font-medium text-green-800 mb-3">
                  ✅ Invoice {savedInvoiceNo} saved! Send to customer:
                </p>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                  <div>
                    <Label className="text-xs">Customer Email</Label>
                    <Input value={newCust.email} onChange={e => setNewCust(p => ({...p, email: e.target.value}))} placeholder="customer@email.com" className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Customer WhatsApp No.</Label>
                    <Input value={newCust.phone} onChange={e => setNewCust(p => ({...p, phone: e.target.value}))} placeholder="9876543210" className="h-8 text-sm" />
                  </div>
                </div>
                <div className="flex flex-wrap gap-2">
                  <Button size="sm" onClick={downloadPDF}  className="bg-amber-500 hover:bg-amber-600">
                    <Download className="w-4 h-4 mr-2" />
                    Download PDF
                  </Button>
                  <Button size="sm" onClick={sendEmail} className="bg-blue-500 hover:bg-blue-600">
                    <Mail className="w-4 h-4 mr-2" /> Send Email
                  </Button>
                  <Button size="sm" onClick={sendWhatsApp} className="bg-green-600 hover:bg-green-700">
                    <SendIcon className="w-4 h-4 mr-2" /> Send WhatsApp
                  </Button>
                </div>
              </CardContent>
            </Card>
          )}
        </div>

        {/* Right: Summary */}
        <div className="space-y-4">
          <Card className="sticky top-6">
            <CardHeader><CardTitle className="text-base">Invoice Summary</CardTitle></CardHeader>
            <CardContent className="space-y-3">
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Subtotal</span><span>{formatINR(subtotal)}</span>
              </div>
              {totalDiscount > 0 && (
                <div className="flex justify-between text-sm">
                  <span className="text-gray-500">Discount</span><span className="text-red-600">-{formatINR(totalDiscount)}</span>
                </div>
              )}
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Taxable Amount</span><span className="font-medium">{formatINR(taxableAmount)}</span>
              </div>
              <div className="border-t pt-2">
                {isInter ? (
                  <div className="flex justify-between text-sm">
                    <span className="text-gray-500">IGST</span><span>{formatINR(igstTotal)}</span>
                  </div>
                ) : (
                  <>
                    <div className="flex justify-between text-sm">
                      <span className="text-gray-500">CGST</span><span>{formatINR(cgstTotal)}</span>
                    </div>
                    <div className="flex justify-between text-sm">
                      <span className="text-gray-500">SGST</span><span>{formatINR(sgstTotal)}</span>
                    </div>
                  </>
                )}
              </div>
              {roundOff !== 0 && (
                <div className="flex justify-between text-sm">
                  <span className="text-gray-500">Round Off</span><span>{roundOff > 0 ? "+" : ""}{roundOff.toFixed(2)}</span>
                </div>
              )}
              <div className="border-t pt-3 flex justify-between">
                <span className="text-base font-bold">Grand Total</span>
                <span className="text-xl font-bold text-emerald-700">{formatINR(grandTotal)}</span>
              </div>
              <div className="text-xs text-gray-500 italic border-t pt-2">
                {amtWords(grandTotal)}
              </div>

              <div className="pt-4 space-y-2">
                <Button className="w-full" size="lg" onClick={handleSubmit} disabled={saving || !customerId}>
                  {saving ? <><Loader2 className="w-4 h-4 animate-spin mr-2" />Creating...</> : <><Save className="w-4 h-4 mr-2" />{savedInvoiceId ? "Update Invoice" : "Create Invoice"}</>}
                </Button>
                {savedInvoiceId ? (
                  <p className="text-xs text-center text-green-600 font-medium">✅ {savedInvoiceNo} — scroll down to share</p>
                ) : (
                  <p className="text-xs text-center text-gray-400">Invoice number will be auto-generated</p>
                )}
                {savedInvoiceId && (
                  <Button variant="outline" className="w-full" size="sm" onClick={() => navigate(`/admin/billing/invoices/${savedInvoiceId}`)}>
                    View Invoice Detail →
                  </Button>
                )}
              </div>
            </CardContent>
          </Card>

          {/* GST Info */}
          <Card>
            <CardContent className="pt-4">
              <div className="text-xs space-y-1.5">
                <div className="flex justify-between">
                  <span className="text-gray-500">Supply Type</span>
                  <Badge variant="outline" className="text-xs">{isInter ? "Inter-State (IGST)" : "Intra-State (CGST+SGST)"}</Badge>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Seller State</span>
                  <span>{INDIAN_STATES[sellerState] || sellerState}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Buyer State</span>
                  <span>{selectedCustomer ? (INDIAN_STATES[buyerState] || buyerState) : "—"}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">GST Category</span>
                  <span>{selectedCustomer?.gstin ? "B2B" : "B2C"}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Items</span>
                  <span>{items.filter(i => i.description).length}</span>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
}
