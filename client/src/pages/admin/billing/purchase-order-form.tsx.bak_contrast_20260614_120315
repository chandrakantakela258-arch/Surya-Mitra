              {poCalcType === "offgrid" && (<>
                <div>
                  <Label className="text-xs text-gray-600">Battery Model</Label>
                  <select value={poCalcBattery} onChange={e => setPoCalcBattery(e.target.value)}
                    className="w-full h-7 text-xs border border-orange-300 rounded px-1 mt-0.5 bg-white">
                    {Object.entries(PO_BATTERIES).map(([k,v]) => (
                      <option key={k} value={k}>{v.name} — ₹{v.price.toLocaleString("en-IN")}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <Label className="text-xs text-gray-600">Battery Qty</Label>
                  <Input type="number" min={1} max={100} value={poCalcBattQty}
                    onChange={e => setPoCalcBattQty(Number(e.target.value))}
                    className="h-7 text-xs border-orange-300 mt-0.5" />
                </div>
              </>)}
              {/* Preview */}
              <div className="bg-white rounded border border-orange-200 p-2 text-xs">
                <div className="text-gray-500 font-semibold mb-1">Preview (at distributor price):</div>
                {(() => {
                  const panel = PO_PANELS[poCalcPanel];
                  const panelQty = Math.ceil((poCalcKw * 1000) / panel.watt);
                  const panelTotal = panelQty * panel.price;
                  let invName = "", invPrice = 0;
                  if (poCalcType !== "offgrid") {
                    const is3ph = poCalcType === "ongrid_3ph";
                    const bestKey = Object.keys(PO_GI).find(k => {
                      const n = parseInt(PO_GI[k].name.match(/\d+/)?.[0]||"0");
                      return n >= poCalcKw && PO_GI[k].name.includes("3Ph") === is3ph;
                    }) || (is3ph ? "LGTLS324GIG3" : "LGTFES601POGGI");
                    invName = PO_GI[bestKey].name; invPrice = PO_GI[bestKey].price;
                  } else {
                    const elegKey = poCalcKw <= 3 ? "ELEGORIALG3K48M" : poCalcKw <= 5 ? "ELEGORIALG5K48M" : "ELEGORIALG10K48M";
                    invName = PO_ELEGORIA[elegKey].name; invPrice = PO_ELEGORIA[elegKey].price;
                  }
                  const batTotal = poCalcType === "offgrid" ? (PO_BATTERIES[poCalcBattery]?.price||0) * poCalcBattQty : 0;
                  const grandTotal = panelTotal + invPrice + batTotal;
                  return (<>
                    <div className="flex justify-between"><span>Panels ({panelQty} × ₹{panel.price.toLocaleString("en-IN")})</span><span className="font-bold">₹{panelTotal.toLocaleString("en-IN")}</span></div>
                    <div className="flex justify-between"><span>Inverter ({invName})</span><span className="font-bold">₹{invPrice.toLocaleString("en-IN")}</span></div>
                    {poCalcType === "offgrid" && <div className="flex justify-between"><span>Battery (×{poCalcBattQty})</span><span className="font-bold">₹{batTotal.toLocaleString("en-IN")}</span></div>}
                    <div className="flex justify-between border-t border-orange-200 pt-1 mt-1 font-bold text-orange-800"><span>Total (excl. GST)</span><span>₹{grandTotal.toLocaleString("en-IN")}</span></div>
                  </>);
                })()}
              </div>
              <Button size="sm" onClick={calcPoItems}
                className="w-full h-8 text-xs bg-orange-600 hover:bg-orange-700 text-white">
                ➕ Add to PO Line Items
              </Button>
            </div>
          </div>

          <h3 className="font-semibold text-xs text-muted-foreground uppercase tracking-wider mb-2">
            Product Catalog (Purchase Price)
          </h3>
          {sortedSegs.map(([seg, ps]) => {
            const isKit = seg.includes("Kit");
            const color = colors[seg] || "#6b7280";
            return (
            <div key={seg} className="border rounded-lg overflow-hidden shadow-sm">
              <button onClick={() => toggle(seg)}
                className="w-full flex items-center justify-between p-2 px-3 hover:bg-gray-50 text-sm font-semibold"
                style={{ borderLeft: "4px solid " + color, background: open.has(seg) ? "#fafafa" : "white" }}>
                <div className="flex items-center gap-2">
                  <span style={{color}} className="text-xs font-bold">{isKit?"📦":"🔧"}</span>
                  <span>{seg}</span>
                  <span className="text-xs text-gray-400 font-normal">({(ps as any[]).length})</span>
                </div>
                {open.has(seg) ? <ChevronDown className="w-4 h-4 text-gray-500" /> : <ChevronRight className="w-4 h-4 text-gray-400" />}
              </button>
              {open.has(seg) && (
                <div className="border-t divide-y bg-white">
                  {(ps as any[]).map((p: any) => {
                    const price = parseFloat(p.default_purchase_price || p.price || "0");
                    const gst = parseFloat(p.gst_rate || "0");
                    const gstAmt = price * gst / 100;
                    const parts = isKit ? parseKitDesc(p.description || p.name || "") : null;
                    return (
                    <div key={p.id}
                      className="p-2 px-3 hover:bg-purple-50 cursor-pointer group transition-colors"
                      onClick={() => addProd(p)}>
                      {/* Product name row */}
                      <div className="flex items-start justify-between gap-2">
                        <div className="flex-1 min-w-0">
                          <div className="text-xs font-semibold text-gray-800 leading-tight">{p.name}</div>
                          {p.model_code && (
                            <div className="text-xs text-gray-400 font-mono mt-0.5">{p.model_code}</div>
                          )}
                        </div>
                        <div className="flex items-center gap-1 shrink-0">
                          <Plus className="w-3 h-3 opacity-0 group-hover:opacity-100 text-purple-600 transition-opacity" />
                        </div>
                      </div>
                      {/* Kit components breakdown */}
                      {isKit && parts && (
                        <div className="mt-1.5 grid grid-cols-1 gap-0.5">
                          {parts.inv   && <div className="text-xs text-indigo-700 bg-indigo-50 rounded px-1.5 py-0.5">⚡ Inverter: {parts.inv}</div>}
                          {parts.bat   && <div className="text-xs text-green-700 bg-green-50 rounded px-1.5 py-0.5">🔋 Battery: {parts.bat}</div>}
                          {parts.panel && <div className="text-xs text-amber-700 bg-amber-50 rounded px-1.5 py-0.5">☀️ Panel: {parts.panel}</div>}
                        </div>
                      )}
                      {/* Price row */}
                      <div className="flex items-center justify-between mt-1.5">
                        <div className="flex items-center gap-2">
                          <span className="text-xs text-gray-500">Basic: <span className="font-bold text-purple-700">{fmt(price)}</span></span>
                          <span className="text-xs text-gray-400">+{gst}% GST</span>
                          <span className="text-xs text-gray-500">= <span className="font-semibold text-green-700">{fmt(price+gstAmt)}</span></span>
                        </div>
                        <span className="text-xs bg-purple-100 text-purple-700 rounded px-1.5 py-0.5 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">+ Add</span>
                      </div>
                    </div>
                  )})}
                </div>
              )}
            </div>
          )})}
        </div>

        {/* ═══ RIGHT: PO Form ═══ */}
        <div className="lg:col-span-2 space-y-4">
          {/* Company & Vendor */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {/* Company */}
            <Card>
              <CardHeader className="pb-2">
                <CardTitle className="text-sm">Billing Company</CardTitle>
              </CardHeader>
              <CardContent>
                <Select value={String(coId)} onValueChange={x => setCoId(Number(x))}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>{cos.map((c: any) => <SelectItem key={c.id} value={String(c.id)}>{c.name}</SelectItem>)}</SelectContent>
                </Select>
                <div className="grid grid-cols-2 gap-2 mt-2">
                  <div>
                    <Label className="text-xs">PO Date</Label>
                    <Input type="date" value={poDate} onChange={e => setPoDate(e.target.value)} className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Delivery Date</Label>
                    <Input type="date" value={delDate} onChange={e => setDelDate(e.target.value)} className="h-8 text-sm" />
                  </div>
                </div>
              </CardContent>
            </Card>

            {/* Vendor */}
            <Card>
              <CardHeader className="pb-2">
                <CardTitle className="text-sm">Vendor / Supplier</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="relative mb-2">
                  <Label className="text-xs">Search Existing Vendor</Label>
                  <div className="relative">
                    <Search className="absolute left-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400" />
                    <Input value={vendorSearch}
                      onChange={e => { setVendorSearch(e.target.value); setSelectedVendorId(null); }}
                      placeholder="Type vendor name, GSTIN, phone..."
                      className="h-8 text-sm pl-7" />
                  </div>
                  {showVendorDrop && vendorResults.length > 0 && (
                    <div className="absolute z-50 w-full mt-1 bg-white border rounded-lg shadow-lg max-h-48 overflow-y-auto">
                      {vendorResults.map((vn: any) => (
                        <div key={vn.id} className="p-2 px-3 hover:bg-purple-50 cursor-pointer border-b text-sm" onClick={() => pickVendor(vn)}>
                          <div className="font-medium">{vn.name}</div>
                          <div className="text-xs text-gray-500">
                            {vn.phone || ""} {vn.gstin ? "| " + vn.gstin : ""} {vn.state ? "| " + vn.state : ""}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                  {selectedVendorId && <p className="text-xs text-green-600 mt-1">✅ Auto-filled from saved vendor</p>}
                </div>
                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <Label className="text-xs">Name *</Label>
                    <Input value={v.name} onChange={e => setV(p => ({...p, name: e.target.value}))} className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">GSTIN</Label>
                    <Input value={v.gstin} onChange={e => setV(p => ({...p, gstin: e.target.value}))} className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Phone</Label>
                    <Input value={v.phone} onChange={e => setV(p => ({...p, phone: e.target.value}))} className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Email</Label>
                    <Input value={v.email} onChange={e => setV(p => ({...p, email: e.target.value}))} className="h-8 text-sm" placeholder="vendor@email.com" />
                  </div>
                  <div className="col-span-2">
                    <Label className="text-xs">Address</Label>
                    <Input value={v.addr} onChange={e => setV(p => ({...p, addr: e.target.value}))} className="h-8 text-sm" placeholder="Vendor address" />
                  </div>
                  <div>
                    <Label className="text-xs">City</Label>
                    <Input value={v.city} onChange={e => setV(p => ({...p, city: e.target.value}))} className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">State</Label>
                    <Select value={v.sc} onValueChange={x => { const s = STATES.find(st => st.code === x); setV(p => ({...p, state: s?.name||"", sc: x})); }}>
                      <SelectTrigger className="h-8 text-sm"><SelectValue /></SelectTrigger>
                      <SelectContent>{STATES.map(s => <SelectItem key={s.code} value={s.code}>{s.name}</SelectItem>)}</SelectContent>
                    </Select>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Line Items */}
          <Card>
            <CardHeader className="flex flex-row items-center justify-between pb-2">
              <CardTitle className="text-sm">Line Items</CardTitle>
              <Button variant="outline" size="sm" onClick={() => setItems(p => [...p, blank()])}>
                <Plus className="w-3 h-3 mr-1" />Add
              </Button>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b text-xs text-gray-500">
                      <th className="text-left pb-2 w-8">#</th>
                      <th className="text-left pb-2 min-w-[200px]">Product</th>
                      <th className="pb-2 w-20">HSN</th>
                      <th className="text-right pb-2 w-14">Qty</th>
                      <th className="text-right pb-2 w-24">Rate</th>
                      <th className="text-right pb-2 w-14">Disc%</th>
                      <th className="text-right pb-2 w-14">GST%</th>
                      <th className="text-right pb-2 w-24">Total</th>
                      <th className="w-8"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {items.map((item, idx) => {
                      const t = total(item);
                      return (
                        <tr key={item.key} className="border-b">
                          <td className="py-1 text-gray-400">{idx+1}</td>
                          <td className="py-1 pr-1">
                            <Input className="h-7 text-xs" value={item.desc}
                              onChange={e => upd(item.key, "desc", e.target.value)} placeholder="Product name" />
                          </td>
                          <td className="py-1">
                            <Input className="h-7 text-xs w-20" value={item.hsn}
                              onChange={e => upd(item.key, "hsn", e.target.value)} />
                          </td>
                          <td className="py-1">
                            <Input type="number" className="h-7 text-xs text-right w-14" value={item.qty}
                              onChange={e => upd(item.key, "qty", parseFloat(e.target.value)||0)} />
                          </td>
                          <td className="py-1">
                            <Input type="number" className="h-7 text-xs text-right w-24" value={item.rate}
                              onChange={e => upd(item.key, "rate", parseFloat(e.target.value)||0)} />
                          </td>
                          <td className="py-1">
                            <Input type="number" className="h-7 text-xs text-right w-14" value={item.disc}
                              onChange={e => upd(item.key, "disc", parseFloat(e.target.value)||0)} />
                          </td>
                          <td className="py-1">
                            <Input type="number" className="h-7 text-xs text-right w-14" value={item.gst}
                              onChange={e => upd(item.key, "gst", parseFloat(e.target.value)||0)} />
                          </td>
                          <td className="py-1 text-right font-medium">{fmt(t.grand)}</td>
                          <td className="py-1">
                            <Button variant="ghost" size="sm" onClick={() => del(item.key)}
                              className="h-6 w-6 p-0 text-red-500">
                              <Trash2 className="w-3 h-3" />
                            </Button>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              {/* Notes + Totals */}
              <div className="flex justify-between mt-4">
                <div className="w-64">
                  <Label className="text-xs">Notes</Label>
                  <Textarea value={notes} onChange={e => setNotes(e.target.value)}
                    rows={3} className="text-sm" placeholder="Additional notes..." />
                </div>
                <div className="w-60 text-sm space-y-1">
                  <div className="flex justify-between">
                    <span>Subtotal</span><span>{fmt(tots.sub)}</span>
                  </div>
                  <div className="flex justify-between text-muted-foreground">
                    <span>GST</span><span>{fmt(tots.tax)}</span>
                  </div>
                  <div className="flex justify-between font-bold text-lg text-purple-700 pt-2 border-t-2 border-purple-700">
                    <span>Grand Total</span><span>{fmt(tots.grand)}</span>
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Action Buttons */}
          <div className="flex justify-end gap-3">
            <Button variant="outline" onClick={() => nav("/admin/billing")}>Cancel</Button>
            <Button onClick={savePO} disabled={saving} className="bg-purple-600 hover:bg-purple-700 min-w-[180px]">
              {saving ? <Loader2 className="w-4 h-4 mr-2 animate-spin" /> : <Save className="w-4 h-4 mr-2" />}
              {savedId ? "Update PO" : "Save Purchase Order"}
            </Button>
          </div>

          {/* Post-save Share Card — ONLY shown after save */}
          {savedId && (
            <Card className="border-purple-300 bg-purple-50/50">
              <CardContent className="pt-4">
                <p className="text-sm font-medium text-purple-800 mb-3">
                  ✅ PO {savedPoNo} saved! Send to vendor:
                </p>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                  <div>
                    <Label className="text-xs">Vendor Email</Label>
                    <Input value={v.email} onChange={e => setV(p => ({...p, email: e.target.value}))}
                      placeholder="vendor@email.com" className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Vendor WhatsApp No.</Label>
                    <Input value={v.phone} onChange={e => setV(p => ({...p, phone: e.target.value}))}
                      placeholder="9876543210" className="h-8 text-sm" />
                  </div>
                </div>
                <div className="flex flex-wrap gap-2">
                  <Button size="sm" onClick={downloadPDF} 
                    className="bg-amber-500 hover:bg-amber-600">
                    <Download className="w-4 h-4 mr-2" />
                    Download PDF
                  </Button>
                  <Button size="sm" onClick={sendEmail} className="bg-blue-500 hover:bg-blue-600">
                    <Mail className="w-4 h-4 mr-2" /> Send Email
                  </Button>
                  <Button size="sm" onClick={sendWhatsApp} className="bg-green-600 hover:bg-green-700">
                    <Send className="w-4 h-4 mr-2" /> Send WhatsApp
                  </Button>
                </div>
              </CardContent>
            </Card>
          )}
        </div>
      </div>
    </div>
  );
}
