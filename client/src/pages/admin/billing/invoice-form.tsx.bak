/**
 * Invoice Form — /admin/billing/invoices/new
 * Full GST-compliant invoice creation with:
 *   - Company selector (Divyanshi / Prayga)
 *   - Customer search + create inline
 *   - Product catalog line items with auto-pricing
 *   - Auto CGST/SGST vs IGST based on state
 *   - Real-time totals with amount in words
 */
import { useState, useEffect, useCallback } from "react";
import { useLocation } from "wouter";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { Badge } from "@/components/ui/badge";
import { Plus, Trash2, Save, ArrowLeft, Search, Loader2 } from "lucide-react";

// ── Types ────────────────────────────────────────────────────────────────────

interface Company { id: number; name: string; gstin: string; state_code: string; invoice_prefix: string; }
interface Product { id: number; name: string; hsn_code: string; unit: string; default_sale_price: string; gst_rate: string; category: string; }
interface Customer { id: number; name: string; gstin: string | null; phone: string; state: string; state_code: string; address: string; city: string; customer_type: string; }

interface LineItem {
  key: string;
  product_id: number | null;
  description: string;
  hsn_code: string;
  quantity: number;
  unit: string;
  rate: number;
  discount_percent: number;
  gst_rate: number;
  cess_rate: number;
  // Calculated
  discount_amount: number;
  taxable_value: number;
  cgst_rate: number; cgst_amount: number;
  sgst_rate: number; sgst_amount: number;
  igst_rate: number; igst_amount: number;
  total_amount: number;
}

// ── Helpers ──────────────────────────────────────────────────────────────────

function uid(): string { return Math.random().toString(36).slice(2, 9); }

function formatINR(n: number): string {
  return new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(n);
}

function emptyItem(): LineItem {
  return {
    key: uid(), product_id: null, description: "", hsn_code: "", quantity: 1, unit: "Nos",
    rate: 0, discount_percent: 0, gst_rate: 12, cess_rate: 0,
    discount_amount: 0, taxable_value: 0,
    cgst_rate: 0, cgst_amount: 0, sgst_rate: 0, sgst_amount: 0,
    igst_rate: 0, igst_amount: 0, total_amount: 0,
  };
}

function calcItem(item: LineItem, sellerState: string, buyerState: string): LineItem {
  const gross = item.quantity * item.rate;
  const discAmt = Math.round(gross * item.discount_percent / 100 * 100) / 100;
  const taxable = Math.round((gross - discAmt) * 100) / 100;
  const inter = sellerState !== buyerState;
  const cgstR = inter ? 0 : item.gst_rate / 2;
  const sgstR = inter ? 0 : item.gst_rate / 2;
  const igstR = inter ? item.gst_rate : 0;
  const cgstA = Math.round(taxable * cgstR / 100 * 100) / 100;
  const sgstA = Math.round(taxable * sgstR / 100 * 100) / 100;
  const igstA = Math.round(taxable * igstR / 100 * 100) / 100;
  const total = Math.round((taxable + cgstA + sgstA + igstA) * 100) / 100;
  return { ...item, discount_amount: discAmt, taxable_value: taxable, cgst_rate: cgstR, cgst_amount: cgstA, sgst_rate: sgstR, sgst_amount: sgstA, igst_rate: igstR, igst_amount: igstA, total_amount: total };
}

const ONES = ["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen"];
const TENS = ["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];
function tw(n: number): string { if (n < 20) return ONES[n]; return TENS[Math.floor(n/10)] + (n%10 ? " "+ONES[n%10] : ""); }
function thr(n: number): string { if (!n) return ""; const h=Math.floor(n/100),r=n%100; let s=h?ONES[h]+" Hundred":""; if(r) s+=(h?" and ":"")+tw(r); return s; }
function amtWords(a: number): string {
  if (a === 0) return "Zero Rupees Only";
  const r=Math.floor(Math.abs(a)); let w="";
  const cr=Math.floor(r/10000000),lk=Math.floor((r%10000000)/100000),th=Math.floor((r%100000)/1000),hd=r%1000;
  if(cr) w+=thr(cr)+" Crore "; if(lk) w+=tw(lk)+" Lakh "; if(th) w+=tw(th)+" Thousand "; if(hd) w+=thr(hd);
  return "Rupees " + w.trim() + " Only";
}

const INDIAN_STATES: Record<string, string> = {
  "10": "Bihar", "08": "Rajasthan", "09": "Uttar Pradesh", "20": "Jharkhand",
  "21": "Odisha", "22": "Chhattisgarh", "23": "Madhya Pradesh", "19": "West Bengal",
  "27": "Maharashtra", "07": "Delhi", "06": "Haryana", "33": "Tamil Nadu",
  "29": "Karnataka", "32": "Kerala", "36": "Telangana", "37": "Andhra Pradesh",
  "24": "Gujarat", "03": "Punjab", "05": "Uttarakhand", "02": "Himachal Pradesh",
  "11": "Sikkim", "18": "Assam", "01": "Jammu & Kashmir",
};

// ── Component ────────────────────────────────────────────────────────────────

export default function InvoiceForm() {
  const [, navigate] = useLocation();
  const [companies, setCompanies] = useState<Company[]>([]);
  const [products, setProducts] = useState<Product[]>([]);
  const [customers, setCustomers] = useState<Customer[]>([]);
  const [saving, setSaving] = useState(false);

  // Form state
  const [companyId, setCompanyId] = useState<number>(1);
  const [customerId, setCustomerId] = useState<number | null>(null);
  const [invoiceType, setInvoiceType] = useState("tax_invoice");
  const [invoiceDate, setInvoiceDate] = useState(new Date().toISOString().split("T")[0]);
  const [dueDate, setDueDate] = useState("");
  const [notes, setNotes] = useState("");
  const [terms, setTerms] = useState("Payment due within 15 days of invoice date.");
  const [items, setItems] = useState<LineItem[]>([emptyItem()]);

  // Customer search
  const [customerSearch, setCustomerSearch] = useState("");
  const [showCustomerDropdown, setShowCustomerDropdown] = useState(false);
  const [selectedCustomer, setSelectedCustomer] = useState<Customer | null>(null);

  // New customer inline
  const [showNewCustomer, setShowNewCustomer] = useState(false);
  const [newCust, setNewCust] = useState({ name: "", phone: "", gstin: "", address: "", city: "", state: "Bihar", state_code: "10", pin: "", email: "" });

  // Derived
  const company = companies.find(c => c.id === companyId);
  const sellerState = company?.state_code || "10";
  const buyerState = selectedCustomer?.state_code || "10";
  const isInter = sellerState !== buyerState;

  // ── Load data ──────────────────────────────────────────────
  useEffect(() => {
    Promise.all([
      fetch("/api/billing/companies").then(r => r.json()),
      fetch("/api/billing/products").then(r => r.json()),
    ]).then(([co, pr]) => {
      setCompanies(co);
      setProducts(pr);
      if (co.length) setCompanyId(co[0].id);
    });
  }, []);

  // Search customers
  useEffect(() => {
    if (customerSearch.length < 2) { setCustomers([]); return; }
    const t = setTimeout(() => {
      fetch(`/api/billing/customers?search=${encodeURIComponent(customerSearch)}`).then(r => r.json()).then(setCustomers);
    }, 300);
    return () => clearTimeout(t);
  }, [customerSearch]);

  // ── Recalculate items when state changes ───────────────────
  const recalcItems = useCallback((currentItems: LineItem[]) => {
    return currentItems.map(it => calcItem(it, sellerState, buyerState));
  }, [sellerState, buyerState]);

  useEffect(() => {
    setItems(prev => recalcItems(prev));
  }, [sellerState, buyerState, recalcItems]);

  // ── Line item handlers ─────────────────────────────────────
  const updateItem = (key: string, field: string, value: any) => {
    setItems(prev => {
      const updated = prev.map(it => {
        if (it.key !== key) return it;
        const newIt = { ...it, [field]: value };
        return calcItem(newIt, sellerState, buyerState);
      });
      return updated;
    });
  };

  const selectProduct = (key: string, productId: string) => {
    const prod = products.find(p => p.id === parseInt(productId));
    if (!prod) return;
    setItems(prev => prev.map(it => {
      if (it.key !== key) return it;
      const newIt = {
        ...it,
        product_id: prod.id,
        description: prod.name,
        hsn_code: prod.hsn_code,
        unit: prod.unit,
        rate: parseFloat(prod.default_sale_price),
        gst_rate: parseFloat(prod.gst_rate),
      };
      return calcItem(newIt, sellerState, buyerState);
    }));
  };

  const addItem = () => setItems(prev => [...prev, emptyItem()]);
  const removeItem = (key: string) => setItems(prev => prev.filter(it => it.key !== key));

  // ── Totals ─────────────────────────────────────────────────
  const subtotal = items.reduce((s, i) => s + i.quantity * i.rate, 0);
  const totalDiscount = items.reduce((s, i) => s + i.discount_amount, 0);
  const taxableAmount = items.reduce((s, i) => s + i.taxable_value, 0);
  const cgstTotal = items.reduce((s, i) => s + i.cgst_amount, 0);
  const sgstTotal = items.reduce((s, i) => s + i.sgst_amount, 0);
  const igstTotal = items.reduce((s, i) => s + i.igst_amount, 0);
  const rawTotal = taxableAmount + cgstTotal + sgstTotal + igstTotal;
  const grandTotal = Math.round(rawTotal);
  const roundOff = Math.round((grandTotal - rawTotal) * 100) / 100;

  // ── Select customer ────────────────────────────────────────
  const pickCustomer = (c: Customer) => {
    setSelectedCustomer(c);
    setCustomerId(c.id);
    setCustomerSearch(c.name);
    setShowCustomerDropdown(false);
  };

  // ── Create customer inline ─────────────────────────────────
  const createCustomer = async () => {
    try {
      const res = await fetch("/api/billing/customers", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(newCust) });
      const created = await res.json();
      pickCustomer(created);
      setShowNewCustomer(false);
      setNewCust({ name: "", phone: "", gstin: "", address: "", city: "", state: "Bihar", state_code: "10", pin: "", email: "" });
    } catch (e) { console.error(e); }
  };

  // ── Submit ─────────────────────────────────────────────────
  const handleSubmit = async () => {
    if (!customerId) { alert("Please select a customer"); return; }
    if (items.length === 0 || items.every(i => !i.description)) { alert("Add at least one line item"); return; }

    setSaving(true);
    try {
      const payload = {
        company_id: companyId,
        customer_id: customerId,
        invoice_type: invoiceType,
        invoice_date: invoiceDate,
        due_date: dueDate || null,
        place_of_supply: buyerState,
        notes, terms,
        items: items.filter(i => i.description).map(i => ({
          product_id: i.product_id,
          description: i.description,
          hsn_code: i.hsn_code,
          quantity: i.quantity,
          unit: i.unit,
          rate: i.rate,
          discount_percent: i.discount_percent,
          gst_rate: i.gst_rate,
          cess_rate: i.cess_rate,
        })),
      };

      const res = await fetch("/api/billing/invoices", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const invoice = await res.json();

      if (res.ok) {
        navigate(`/admin/billing/invoices/${invoice.id}`);
      } else {
        alert("Error: " + (invoice.error || "Failed to create invoice"));
      }
    } catch (e: any) {
      alert("Error: " + e.message);
    } finally { setSaving(false); }
  };

  return (
    <div className="p-6 space-y-6 max-w-[1400px] mx-auto">
      {/* Header */}
      <div className="flex items-center gap-4">
        <Button variant="ghost" size="sm" onClick={() => navigate("/admin/billing")}>
          <ArrowLeft className="w-4 h-4 mr-1" />Back
        </Button>
        <div>
          <h1 className="text-2xl font-bold">Create Invoice</h1>
          <p className="text-sm text-gray-500">GST-compliant tax invoice</p>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Left: Form */}
        <div className="lg:col-span-2 space-y-6">

          {/* Company + Invoice Details */}
          <Card>
            <CardHeader><CardTitle className="text-base">Invoice Details</CardTitle></CardHeader>
            <CardContent className="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div className="col-span-2">
                <Label>Billing Company</Label>
                <Select value={String(companyId)} onValueChange={v => setCompanyId(parseInt(v))}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>
                    {companies.map(c => <SelectItem key={c.id} value={String(c.id)}>{c.name}</SelectItem>)}
                  </SelectContent>
                </Select>
              </div>
              <div>
                <Label>Invoice Type</Label>
                <Select value={invoiceType} onValueChange={setInvoiceType}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>
                    <SelectItem value="tax_invoice">Tax Invoice</SelectItem>
                    <SelectItem value="proforma">Proforma</SelectItem>
                    <SelectItem value="credit_note">Credit Note</SelectItem>
                    <SelectItem value="debit_note">Debit Note</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div>
                <Label>Invoice Date</Label>
                <Input type="date" value={invoiceDate} onChange={e => setInvoiceDate(e.target.value)} />
              </div>
              <div>
                <Label>Due Date</Label>
                <Input type="date" value={dueDate} onChange={e => setDueDate(e.target.value)} />
              </div>
              <div>
                <Label>GSTIN</Label>
                <Input value={company?.gstin || ""} disabled className="bg-gray-50" />
              </div>
            </CardContent>
          </Card>

          {/* Customer Selection */}
          <Card>
            <CardHeader className="flex flex-row items-center justify-between">
              <CardTitle className="text-base">Bill To (Customer)</CardTitle>
              <Button variant="outline" size="sm" onClick={() => setShowNewCustomer(!showNewCustomer)}>
                <Plus className="w-3 h-3 mr-1" />{showNewCustomer ? "Cancel" : "New Customer"}
              </Button>
            </CardHeader>
            <CardContent>
              {showNewCustomer ? (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  <div><Label>Name *</Label><Input value={newCust.name} onChange={e => setNewCust({...newCust, name: e.target.value})} /></div>
                  <div><Label>Phone</Label><Input value={newCust.phone} onChange={e => setNewCust({...newCust, phone: e.target.value})} /></div>
                  <div><Label>GSTIN (B2B)</Label><Input value={newCust.gstin} onChange={e => setNewCust({...newCust, gstin: e.target.value})} placeholder="Leave blank for B2C" /></div>
                  <div className="col-span-2"><Label>Address</Label><Input value={newCust.address} onChange={e => setNewCust({...newCust, address: e.target.value})} /></div>
                  <div><Label>City</Label><Input value={newCust.city} onChange={e => setNewCust({...newCust, city: e.target.value})} /></div>
                  <div>
                    <Label>State</Label>
                    <Select value={newCust.state_code} onValueChange={v => setNewCust({...newCust, state_code: v, state: INDIAN_STATES[v] || ""})}>
                      <SelectTrigger><SelectValue /></SelectTrigger>
                      <SelectContent>{Object.entries(INDIAN_STATES).map(([code, name]) => <SelectItem key={code} value={code}>{name}</SelectItem>)}</SelectContent>
                    </Select>
                  </div>
                  <div><Label>PIN</Label><Input value={newCust.pin} onChange={e => setNewCust({...newCust, pin: e.target.value})} /></div>
                  <div className="col-span-3 flex justify-end"><Button size="sm" onClick={createCustomer} disabled={!newCust.name}>Create & Select</Button></div>
                </div>
              ) : (
                <div className="relative">
                  <div className="relative">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
                    <Input
                      className="pl-9"
                      placeholder="Search customer by name, phone, or GSTIN..."
                      value={customerSearch}
                      onChange={e => { setCustomerSearch(e.target.value); setShowCustomerDropdown(true); }}
                      onFocus={() => customerSearch.length >= 2 && setShowCustomerDropdown(true)}
                    />
                  </div>
                  {showCustomerDropdown && customers.length > 0 && (
                    <div className="absolute z-10 w-full mt-1 bg-white border rounded-lg shadow-lg max-h-48 overflow-y-auto">
                      {customers.map(c => (
                        <button key={c.id} className="w-full text-left px-4 py-2.5 hover:bg-gray-50 border-b last:border-0" onClick={() => pickCustomer(c)}>
                          <div className="flex items-center justify-between">
                            <span className="font-medium text-sm">{c.name}</span>
                            <Badge variant="outline" className="text-xs">{c.customer_type}</Badge>
                          </div>
                          <div className="text-xs text-gray-500">{c.phone} {c.gstin ? `| ${c.gstin}` : ""} | {c.state}</div>
                        </button>
                      ))}
                    </div>
                  )}
                  {selectedCustomer && (
                    <div className="mt-3 p-3 bg-blue-50 rounded-lg text-sm">
                      <div className="flex justify-between">
                        <span className="font-medium">{selectedCustomer.name}</span>
                        <Badge>{selectedCustomer.customer_type}</Badge>
                      </div>
                      <div className="text-gray-600 mt-1">
                        {selectedCustomer.phone} | {selectedCustomer.state} ({selectedCustomer.state_code})
                        {selectedCustomer.gstin && <span> | GSTIN: {selectedCustomer.gstin}</span>}
                      </div>
                      {isInter && (
                        <div className="mt-1 text-orange-600 font-medium text-xs">
                          ⚠ Inter-state supply — IGST will apply
                        </div>
                      )}
                    </div>
                  )}
                </div>
              )}
            </CardContent>
          </Card>

          {/* Line Items */}
          <Card>
            <CardHeader className="flex flex-row items-center justify-between">
              <CardTitle className="text-base">Line Items</CardTitle>
              <Button variant="outline" size="sm" onClick={addItem}><Plus className="w-3 h-3 mr-1" />Add Item</Button>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b text-xs text-gray-500 uppercase">
                      <th className="text-left pb-2 w-8">#</th>
                      <th className="text-left pb-2 min-w-[200px]">Product / Description</th>
                      <th className="text-left pb-2 w-20">HSN</th>
                      <th className="text-right pb-2 w-16">Qty</th>
                      <th className="text-right pb-2 w-24">Rate</th>
                      <th className="text-right pb-2 w-16">Disc%</th>
                      <th className="text-right pb-2 w-20">GST%</th>
                      <th className="text-right pb-2 w-24">Taxable</th>
                      <th className="text-right pb-2 w-20">{isInter ? "IGST" : "CGST"}</th>
                      {!isInter && <th className="text-right pb-2 w-20">SGST</th>}
                      <th className="text-right pb-2 w-24">Total</th>
                      <th className="w-8"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {items.map((item, idx) => (
                      <tr key={item.key} className="border-b last:border-0">
                        <td className="py-2 text-gray-400">{idx + 1}</td>
                        <td className="py-2 pr-2">
                          <Select value={item.product_id ? String(item.product_id) : ""} onValueChange={v => selectProduct(item.key, v)}>
                            <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select product..." /></SelectTrigger>
                            <SelectContent>
                              {products.map(p => (
                                <SelectItem key={p.id} value={String(p.id)}>
                                  <span className="text-xs">{p.name} — {formatINR(parseFloat(p.default_sale_price))}</span>
                                </SelectItem>
                              ))}
                            </SelectContent>
                          </Select>
                          <Input className="mt-1 h-7 text-xs" placeholder="Custom description" value={item.description} onChange={e => updateItem(item.key, "description", e.target.value)} />
                        </td>
                        <td className="py-2"><Input className="h-8 text-xs w-20" value={item.hsn_code} onChange={e => updateItem(item.key, "hsn_code", e.target.value)} /></td>
                        <td className="py-2"><Input type="number" className="h-8 text-xs text-right w-16" min={0} value={item.quantity} onChange={e => updateItem(item.key, "quantity", parseFloat(e.target.value) || 0)} /></td>
                        <td className="py-2"><Input type="number" className="h-8 text-xs text-right w-24" min={0} value={item.rate} onChange={e => updateItem(item.key, "rate", parseFloat(e.target.value) || 0)} /></td>
                        <td className="py-2"><Input type="number" className="h-8 text-xs text-right w-16" min={0} max={100} value={item.discount_percent} onChange={e => updateItem(item.key, "discount_percent", parseFloat(e.target.value) || 0)} /></td>
                        <td className="py-2">
                          <Select value={String(item.gst_rate)} onValueChange={v => updateItem(item.key, "gst_rate", parseFloat(v))}>
                            <SelectTrigger className="h-8 text-xs w-20"><SelectValue /></SelectTrigger>
                            <SelectContent>
                              {[0, 5, 12, 18, 28].map(r => <SelectItem key={r} value={String(r)}>{r}%</SelectItem>)}
                            </SelectContent>
                          </Select>
                        </td>
                        <td className="py-2 text-right text-xs font-medium">{formatINR(item.taxable_value)}</td>
                        <td className="py-2 text-right text-xs">{formatINR(isInter ? item.igst_amount : item.cgst_amount)}</td>
                        {!isInter && <td className="py-2 text-right text-xs">{formatINR(item.sgst_amount)}</td>}
                        <td className="py-2 text-right text-xs font-bold">{formatINR(item.total_amount)}</td>
                        <td className="py-2">
                          {items.length > 1 && (
                            <Button variant="ghost" size="sm" className="h-7 w-7 p-0 text-red-400 hover:text-red-600" onClick={() => removeItem(item.key)}>
                              <Trash2 className="w-3 h-3" />
                            </Button>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>

          {/* Notes & Terms */}
          <Card>
            <CardContent className="grid grid-cols-2 gap-4 pt-6">
              <div>
                <Label>Notes</Label>
                <Textarea rows={3} value={notes} onChange={e => setNotes(e.target.value)} placeholder="Additional notes..." />
              </div>
              <div>
                <Label>Terms & Conditions</Label>
                <Textarea rows={3} value={terms} onChange={e => setTerms(e.target.value)} />
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Right: Summary */}
        <div className="space-y-4">
          <Card className="sticky top-6">
            <CardHeader><CardTitle className="text-base">Invoice Summary</CardTitle></CardHeader>
            <CardContent className="space-y-3">
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Subtotal</span>
                <span>{formatINR(subtotal)}</span>
              </div>
              {totalDiscount > 0 && (
                <div className="flex justify-between text-sm">
                  <span className="text-gray-500">Discount</span>
                  <span className="text-red-600">-{formatINR(totalDiscount)}</span>
                </div>
              )}
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Taxable Amount</span>
                <span className="font-medium">{formatINR(taxableAmount)}</span>
              </div>
              <div className="border-t pt-2">
                {isInter ? (
                  <div className="flex justify-between text-sm">
                    <span className="text-gray-500">IGST</span>
                    <span>{formatINR(igstTotal)}</span>
                  </div>
                ) : (
                  <>
                    <div className="flex justify-between text-sm">
                      <span className="text-gray-500">CGST</span>
                      <span>{formatINR(cgstTotal)}</span>
                    </div>
                    <div className="flex justify-between text-sm">
                      <span className="text-gray-500">SGST</span>
                      <span>{formatINR(sgstTotal)}</span>
                    </div>
                  </>
                )}
              </div>
              {roundOff !== 0 && (
                <div className="flex justify-between text-sm">
                  <span className="text-gray-500">Round Off</span>
                  <span>{roundOff > 0 ? "+" : ""}{roundOff.toFixed(2)}</span>
                </div>
              )}
              <div className="border-t pt-3 flex justify-between">
                <span className="text-base font-bold">Grand Total</span>
                <span className="text-xl font-bold text-emerald-700">{formatINR(grandTotal)}</span>
              </div>
              <div className="text-xs text-gray-500 italic border-t pt-2">
                {amtWords(grandTotal)}
              </div>

              <div className="pt-4 space-y-2">
                <Button className="w-full" size="lg" onClick={handleSubmit} disabled={saving || !customerId}>
                  {saving ? <><Loader2 className="w-4 h-4 animate-spin mr-2" />Creating...</> : <><Save className="w-4 h-4 mr-2" />Create Invoice</>}
                </Button>
                <p className="text-xs text-center text-gray-400">
                  Invoice number will be auto-generated
                </p>
              </div>
            </CardContent>
          </Card>

          {/* GST Info */}
          <Card>
            <CardContent className="pt-4">
              <div className="text-xs space-y-1.5">
                <div className="flex justify-between">
                  <span className="text-gray-500">Supply Type</span>
                  <Badge variant="outline" className="text-xs">{isInter ? "Inter-State (IGST)" : "Intra-State (CGST+SGST)"}</Badge>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Seller State</span>
                  <span>{INDIAN_STATES[sellerState] || sellerState}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Buyer State</span>
                  <span>{selectedCustomer ? (INDIAN_STATES[buyerState] || buyerState) : "—"}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">GST Category</span>
                  <span>{selectedCustomer?.gstin ? "B2B" : "B2C"}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Items</span>
                  <span>{items.filter(i => i.description).length}</span>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
}
