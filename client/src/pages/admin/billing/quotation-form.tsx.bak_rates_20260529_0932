function solarDefaultCosts(plantType: string, kw: number): SolarCosts {
  const hybrid: Record<number, SolarCosts> = {
    3:  { solarPanels:81000,  inverter:80000,  battery:39000,  structure:18000, cablesWiring:18000, netMeter:3000, transport:6000,  installation:9000,  miscAccessories:4500,  serviceCharge5yr:12000, contractorProfit:10500 },
    5:  { solarPanels:108000, inverter:95000,  battery:39000,  structure:22000, cablesWiring:22000, netMeter:3000, transport:7000,  installation:12000, miscAccessories:6000,  serviceCharge5yr:15000, contractorProfit:15000 },
    10: { solarPanels:216000, inverter:150000, battery:78000,  structure:35000, cablesWiring:30000, netMeter:3000, transport:10000, installation:18000, miscAccessories:8000,  serviceCharge5yr:20000, contractorProfit:25000 },
    20: { solarPanels:432000, inverter:280000, battery:156000, structure:60000, cablesWiring:55000, netMeter:3000, transport:15000, installation:30000, miscAccessories:12000, serviceCharge5yr:35000, contractorProfit:45000 },
  };
  // Off-grid rates from xlsx (ELEGORIALG + LGMSFI22572PTT + 600W default combo)
  // Kit price split: ~40% inverter, ~35% panels, ~25% battery from GST-incl kit price
  const offgrid: Record<number, SolarCosts> = {
    3:  { solarPanels:51450, inverter:58800, battery:36750, structure:18000, cablesWiring:15000, netMeter:0, transport:6000,  installation:9000,  miscAccessories:20000, serviceCharge5yr:12000, contractorProfit:30000 },
    5:  { solarPanels:70340, inverter:80388, battery:50242, structure:30000, cablesWiring:25000, netMeter:0, transport:8000,  installation:12000, miscAccessories:36000, serviceCharge5yr:15000, contractorProfit:50000 },
    10: { solarPanels:126156,inverter:144179,battery:90112, structure:40000, cablesWiring:30000, netMeter:0, transport:10000, installation:18000, miscAccessories:45000, serviceCharge5yr:20000, contractorProfit:60000 },
  };
  // On-grid rates (LG Solar Pro+ pricing wef May 2026)
  const ongrid: Record<number, SolarCosts> = {
    3:  { solarPanels:81117, inverter:66612, battery:0, structure:15000, cablesWiring:15000, netMeter:3000, transport:5000,  installation:10000, miscAccessories:4500,  serviceCharge5yr:10000, contractorProfit:8000 },
    5:  { solarPanels:120484,inverter:99699, battery:0, structure:22000, cablesWiring:22000, netMeter:3000, transport:7000,  installation:15000, miscAccessories:6000,  serviceCharge5yr:14000, contractorProfit:12000 },
    10: { solarPanels:220000,inverter:140000,battery:0, structure:35000, cablesWiring:30000, netMeter:3000, transport:10000, installation:22000, miscAccessories:8000,  serviceCharge5yr:22000, contractorProfit:20000 },
  };
  const map = plantType === "offgrid" ? offgrid : plantType === "ongrid" ? ongrid : hybrid;
  return map[kw] ?? map[3] ?? hybrid[3];
}


