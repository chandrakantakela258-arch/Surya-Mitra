    { model:"EARTH-LA-KIT",    spec:"Earth Rod 1m + Chamber Box + Chemical 15kg + LA Conv. 1m + Cable 10sqmm 50m",   cat:"Earthing",    qty:"1 Kit",                  brand:"COPPER / REPUTED" },
    { model:"POLYCAB-CABLES",  spec:"DC: 1Cx4sqmm XLPO Solar | AC: 2Cx4sqmm Cu XLPE | LT: 2Cx10sqmm AL-CCA",        cat:"Cables",      qty:"As req.",                brand:"POLYCAB" },
    { model:"ACC-SOLAR-STD",   spec:"HDPE Conduit, Bends, Lugs, MC4 Connectors, Cable Ties, Saddles",                cat:"Accessories", qty:"1 Set",                  brand:"REPUTED" },
