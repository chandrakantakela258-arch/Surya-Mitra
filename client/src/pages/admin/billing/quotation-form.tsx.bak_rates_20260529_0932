              <tbody>
                {COST_ROWS.map((row, i) => {
                  const val = (activeCosts[row.key] as number)||0;
                  const { base, gst } = gstSplit(val, row.gst);
                  return (
                    <tr key={row.key} className={`border-b hover:bg-accent/20 ${i%2===0?"":"bg-muted/30"}`}>
                      <td className="py-2.5 px-4 text-sm font-medium text-gray-700">{row.label}</td>
                      <td className="py-2.5 px-3 text-right text-sm text-muted-foreground">{base.toLocaleString("en-IN")}</td>
                      <td className="py-2.5 px-3 text-center">
                        <Badge variant="outline" className={`text-xs font-bold ${row.gst===5?"border-green-400 text-green-700 bg-green-50":"border-orange-400 text-orange-700 bg-orange-50"}`}>{row.gst}%</Badge>
                      </td>
                      <td className="py-2.5 px-3 text-right text-sm text-muted-foreground">{gst.toLocaleString("en-IN")}</td>
                      <td className="py-2.5 px-4 text-right">
                        <Input type="number" value={solarCosts[row.key] as number}
                          onChange={e => { setSolarRatesEdited(true); setSolarCosts((prev: SolarCosts) => ({ ...prev, [row.key]: Number(e.target.value) })); }}
                          className="w-36 h-8 text-right text-sm font-semibold border-2 focus:border-blue-500" />
                      </td>
                    </tr>
                  );
                })}
              </tbody>
              <tfoot>
                <tr className="bg-blue-900 text-white font-bold">
                  <td className="py-3 px-4 text-base" colSpan={3}>TOTAL</td>
                  <td className="py-3 px-3 text-right text-xs text-blue-200">GST: ₹{COST_ROWS.reduce((s,r)=>s+gstSplit((activeCosts[r.key] as number)||0,r.gst).gst,0).toLocaleString("en-IN")}</td>
                  <td className="py-3 px-4 text-right text-lg">₹{total.toLocaleString("en-IN")}</td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p className="text-xs text-muted-foreground italic px-4 py-2">Panels / Inverters / Batteries @ 5% GST · Structure / Cables / Accessories / Service / Contractor @ 18% GST</p>
        </CardContent>
      </Card>

      <div className="grid grid-cols-3 gap-4">
        {[{label:"PLANT COST",sub:"incl. all GST",val:total,bg:"from-blue-700 to-blue-900"},{label:"DOWN PAYMENT (25%)",sub:"advance payment",val:downPmt,bg:"from-orange-500 to-orange-700"},{label:"LOAN AMOUNT",sub:"EMI financing",val:loan,bg:"from-green-600 to-green-800"}].map(c => (
          <div key={c.label} className={`bg-gradient-to-br ${c.bg} rounded-xl p-4 text-white shadow`}>
            <p className="text-xs font-bold uppercase tracking-wide text-white/70 mb-1">{c.label}</p>
            <p className="text-2xl font-black">₹{c.val.toLocaleString("en-IN")}</p>
            <p className="text-xs text-white/50 mt-1">{c.sub}</p>
          </div>
        ))}
      </div>

      <Card>
        <CardHeader className="pb-2 pt-4 cursor-pointer" onClick={() => setSolarShowBom(!solarShowBom)}>
          <div className="flex items-center justify-between">
            <CardTitle className="text-sm font-bold text-gray-700 uppercase tracking-wide">📋 Bill of Materials — {bomRows.length} items</CardTitle>
            {solarShowBom ? <ChevronDown className="w-4 h-4 text-muted-foreground" /> : <ChevronRight className="w-4 h-4 text-muted-foreground" />}
          </div>
        </CardHeader>
        {solarShowBom && (
          <CardContent className="px-0 pb-0">
            <div className="overflow-x-auto">
              <table className="w-full text-xs">
                <thead>
                  <tr className="bg-blue-900 text-white">
                    <th className="py-2 px-3 text-left w-8">#</th><th className="py-2 px-2 text-left w-44">Model / Code</th>
                    <th className="py-2 px-2 text-left">Specification</th><th className="py-2 px-2 text-left w-24">Category</th>
                    <th className="py-2 px-2 text-center w-20">Qty</th><th className="py-2 px-3 text-left w-28">Brand</th>
                  </tr>
                </thead>
                <tbody>
                  {bomRows.map((row, i) => (
                    <tr key={i} className={`border-b hover:bg-accent/20 ${i%2===0?"":"bg-muted/30"}`}>
                      <td className="py-2 px-3 text-muted-foreground">{i+1}</td>
                      <td className="py-2 px-2 font-mono text-blue-700 font-semibold text-xs">{row.model}</td>
                      <td className="py-2 px-2 text-gray-600 leading-snug">{row.spec}</td>
                      <td className="py-2 px-2"><Badge variant="secondary" className="text-xs">{row.cat}</Badge></td>
                      <td className="py-2 px-2 text-center font-semibold">{row.qty}</td>
                      <td className="py-2 px-3 text-muted-foreground">{row.brand}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </CardContent>
        )}
      </Card>
    </div>
  );
}


export default function QuotationForm() {
  const { toast } = useToast();

  // ── State ──────────────────────────────────────────────────
  const [companyId, setCompanyId] = useState("1");
  const [companies, setCompanies] = useState<any[]>([]);
  const [segments, setSegments] = useState<Record<string, Product[]>>({});
  const [expandedSegments, setExpandedSegments] = useState<Set<string>>(new Set());
  const [expandedKits, setExpandedKits] = useState<Set<number>>(new Set());
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  // Customer
  const [customerSearch, setCustomerSearch] = useState("");
  const [customerResults, setCustomerResults] = useState<Customer[]>([]);
  const [showCustomerDropdown, setShowCustomerDropdown] = useState(false);
  const [selectedCustomer, setSelectedCustomer] = useState<Customer | null>(null);
  const [customerForm, setCustomerForm] = useState({
    name: "", phone: "", email: "", gstin: "",
    address: "", city: "", state: "Bihar", state_code: "10", pin: ""
  });

  // Line items
  const [lineItems, setLineItems] = useState<LineItem[]>([createEmptyLine()]);

  // Quotation meta
  const [notes, setNotes] = useState("");
  const [validDays, setValidDays] = useState("15");
  const [savedQuotationId, setSavedQuotationId] = useState<number | null>(null);
  const [savedQuotationNo, setSavedQuotationNo] = useState<string>("");

  // ── Solar Quotation state ────────────────────────────────────────────────
  const [solarEnabled, setSolarEnabled] = useState(false);
  const [solarPlantType, setSolarPlantType] = useState<"hybrid"|"offgrid"|"ongrid">("hybrid");
  const [solarCapacityKw, setSolarCapacityKw] = useState(3);
  const [solarPanelModel, setSolarPanelModel] = useState("LGTPV580WBNTOPDCR");
  const [solarPanelQty, setSolarPanelQty] = useState(6);
  const [solarInverterModel, setSolarInverterModel] = useState("NOVARALG5648GIH");
  const [solarBatteryModel, setSolarBatteryModel] = useState("LGMSFI22572PTT");
  const [solarBatteryQty, setSolarBatteryQty] = useState(4);
  const [solarNetMeterOn, setSolarNetMeterOn] = useState(true);
  const [solarCosts, setSolarCosts] = useState<SolarCosts>(() => solarDefaultCosts("hybrid", 3));
  const [solarRatesEdited, setSolarRatesEdited] = useState(false);
  const [solarShowBom, setSolarShowBom] = useState(false);
  const [solarConsumerNo, setSolarConsumerNo] = useState("");
  const [solarSiteAddress, setSolarSiteAddress] = useState("");
  const [solarPartnerName, setSolarPartnerName] = useState("");
  const [solarPartnerMobile, setSolarPartnerMobile] = useState("");
  const [solarPdfLoading, setSolarPdfLoading] = useState(false);

  // PDF opens in new tab, no loading state needed

  const searchTimeout = useRef<NodeJS.Timeout | null>(null);

  // ── Load data ──────────────────────────────────────────────
  useEffect(() => {
    Promise.all([
      fetch("/api/billing/products/segments").then(r => r.json()),
      fetch("/api/billing/companies").then(r => r.json()),
    ]).then(([prodData, compData]) => {
      setSegments(prodData.segments || {});
      setCompanies(compData.companies || compData || []);
      setLoading(false);
    }).catch(err => {
      console.error(err);
      toast({ title: "Error", description: "Failed to load products", variant: "destructive" });
      setLoading(false);
    });
  }, []);

  // ── Customer search with debounce ──────────────────────────
  useEffect(() => {
    if (customerSearch.length < 2) {
      setCustomerResults([]);
      setShowCustomerDropdown(false);
      return;
    }
    if (searchTimeout.current) clearTimeout(searchTimeout.current);
    searchTimeout.current = setTimeout(async () => {
      try {
        const res = await fetch(`/api/billing/customers/search?q=${encodeURIComponent(customerSearch)}`);
        const data = await res.json();
        setCustomerResults(data.customers || []);
        setShowCustomerDropdown(true);
      } catch (err) {
        console.error(err);
      }
    }, 300);
  }, [customerSearch]);

  // ── Select customer from dropdown ──────────────────────────
  function selectCustomer(cust: Customer) {
    setSelectedCustomer(cust);
    setCustomerForm({
      name: cust.name || "",
      phone: cust.phone || "",
      email: cust.email || "",
      gstin: cust.gstin || "",
      address: cust.address || "",
      city: cust.city || cust.district || "",
      state: cust.state || "Bihar",
      state_code: cust.state_code || "10",
      pin: cust.pin || "",
    });
    setCustomerSearch(cust.name);
    setShowCustomerDropdown(false);
  }

  // ── Line item helpers ──────────────────────────────────────
  function createEmptyLine(): LineItem {
    return {
      key: Math.random().toString(36).slice(2),
      product_id: null, product_name: "", hsn_code: "",
      quantity: 1, unit: "Pcs", unit_price: 0,
      discount_percent: 0, gst_rate: 12,
    };
  }

  function addProductToQuotation(product: Product) {
    const existing = lineItems.find(li => li.product_id === product.id);
    if (existing) {
      setLineItems(prev => prev.map(li =>
        li.product_id === product.id ? { ...li, quantity: li.quantity + 1 } : li
      ));
      toast({ title: "Quantity Updated", description: `${product.name} qty +1` });
      return;
    }
    const newLine: LineItem = {
      key: Math.random().toString(36).slice(2),
      product_id: product.id, product_name: product.name,
      hsn_code: product.hsn_code, quantity: 1,
      unit: product.unit || "Pcs", unit_price: product.price,
      discount_percent: 0, gst_rate: product.gst_rate || 12,
      segment: product.segment,
    };
    const emptyIdx = lineItems.findIndex(li => !li.product_id && !li.product_name);
    if (emptyIdx >= 0) {
      setLineItems(prev => prev.map((li, i) => i === emptyIdx ? newLine : li));
    } else {
      setLineItems(prev => [...prev, newLine]);
    }
    toast({ title: "Added", description: product.name });
  }

  function updateLineItem(key: string, field: keyof LineItem, value: any) {
    setLineItems(prev => prev.map(li => li.key === key ? { ...li, [field]: value } : li));
  }

  function removeLine(key: string) {
    setLineItems(prev => {
      const filtered = prev.filter(li => li.key !== key);
      return filtered.length === 0 ? [createEmptyLine()] : filtered;
    });
  }

  // ── Calculations ───────────────────────────────────────────
  const companyState = companies.find(c => c.id === Number(companyId))?.state_code || "10";
  const isIntraState = companyState === customerForm.state_code;

  const calculations = lineItems.map(li => {
    const amount = li.quantity * li.unit_price;
    const discountAmt = amount * li.discount_percent / 100;
    const taxable = amount - discountAmt;
    const gstAmt = taxable * li.gst_rate / 100;
    const cgst = isIntraState ? gstAmt / 2 : 0;
    const sgst = isIntraState ? gstAmt / 2 : 0;
    const igst = isIntraState ? 0 : gstAmt;
    return { amount, discountAmt, taxable, cgst, sgst, igst, total: taxable + gstAmt };
  });

  const totals = calculations.reduce((acc, c) => ({
    subtotal: acc.subtotal + c.taxable,
    cgst: acc.cgst + c.cgst,
    sgst: acc.sgst + c.sgst,
    igst: acc.igst + c.igst,
    grand: acc.grand + c.total,
  }), { subtotal: 0, cgst: 0, sgst: 0, igst: 0, grand: 0 });

  function toggleSegment(seg: string) {
    setExpandedSegments(prev => {
      const next = new Set(prev);
      next.has(seg) ? next.delete(seg) : next.add(seg);
      return next;
    });
  }

  // ── Save quotation ────────────────────────────────────────
  async function saveQuotation() {
    if (!customerForm.name) {
      toast({ title: "Error", description: "Customer name is required", variant: "destructive" });
      return;
    }
    if (lineItems.every(li => !li.product_name && !li.product_id)) {
      toast({ title: "Error", description: "Add at least one product", variant: "destructive" });
      return;
    }
    setSaving(true);
    try {
      const payload = {
        company_id: Number(companyId),
        invoice_type: "quotation",
        customer_id: selectedCustomer?.id || null,
        customer_name: customerForm.name,
        buyer_gstin: customerForm.gstin,
        buyer_address: customerForm.address,
        buyer_city: customerForm.city,
        buyer_state: customerForm.state,
        buyer_state_code: customerForm.state_code,
        buyer_pin: customerForm.pin,
        buyer_phone: customerForm.phone,
        buyer_email: customerForm.email,
        due_date: new Date(Date.now() + Number(validDays) * 86400000).toISOString().split("T")[0],
        notes,
        items: lineItems.filter(li => li.product_name || li.product_id).map(li => ({
          product_id: li.product_id,
          description: li.product_name,
          product_name: li.product_name,
          hsn_code: li.hsn_code,
          quantity: li.quantity,
          unit: li.unit,
          unit_price: li.unit_price,
          discount_percent: li.discount_percent,
          gst_rate: li.gst_rate,
        })),
      };

      const res = await fetch("/api/billing/invoices", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to save");

      const id = data.invoice?.id || data.id;
      const no = data.invoice?.invoice_no || data.invoice_no || "";
      setSavedQuotationId(id);
      setSavedQuotationNo(no);
      toast({ title: "✅ Quotation Saved!", description: no || "Saved successfully" });
    } catch (err: any) {
      toast({ title: "Error", description: err.message, variant: "destructive" });
    } finally {
      setSaving(false);
    }
  }


  // ── Solar config auto-update ─────────────────────────────────────────────
  useEffect(() => {
    if (!solarRatesEdited) setSolarCosts(solarDefaultCosts(solarPlantType, solarCapacityKw));
    const invList = SOLAR_INVERTER_OPTIONS[solarPlantType]?.[solarCapacityKw] ?? [];
    if (invList.length && !invList.find((i: any) => i.model === solarInverterModel))
      setSolarInverterModel(invList[0].model);
    const watt = SOLAR_PANEL_OPTIONS.find(p => p.model === solarPanelModel)?.wattage ?? 580;
    setSolarPanelQty(SOLAR_DEFAULT_PANEL_QTY[watt]?.[solarCapacityKw] ?? Math.ceil((solarCapacityKw * 1000) / watt));
    if (solarPlantType === "offgrid") setSolarNetMeterOn(false); else setSolarNetMeterOn(true);
  }, [solarPlantType, solarCapacityKw, solarPanelModel]);

  // ── PDF / Email / WhatsApp ─────────────────────────────────
  function getPdfUrl(): string {
    return `${window.location.origin}/api/billing/invoices/${savedQuotationId}/pdf`;
  }

  function downloadPDF() {
    if (solarEnabled) {
      if (!savedQuotationId) {
        toast({ title: "Save first", description: "Please save the quotation before downloading PDF", variant: "destructive" });
        return;
      }
      setSolarPdfLoading(true);
      const panel   = SOLAR_PANEL_OPTIONS.find(p => p.model === solarPanelModel);
      const invList = SOLAR_INVERTER_OPTIONS[solarPlantType]?.[solarCapacityKw] ?? [];
      const inv     = invList.find((i: any) => i.model === solarInverterModel);
      const bat     = SOLAR_BATTERY_OPTIONS.find(b => b.model === solarBatteryModel);
      const activeCosts = { ...solarCosts,
        netMeter: solarNetMeterOn && solarPlantType !== "offgrid" ? solarCosts.netMeter : 0,
        battery:  solarPlantType === "ongrid" ? 0 : solarCosts.battery };
      fetch("/api/billing/quotations/solar-pdf", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          quotationId: savedQuotationId, companyId,
          customer: selectedCustomer ?? customerForm,
          consumerNo: solarConsumerNo, siteAddress: solarSiteAddress,
          partnerName: solarPartnerName, partnerMobile: solarPartnerMobile,
          system: {
            plantType: solarPlantType, capacityKw: solarCapacityKw,
            moduleCount: solarPanelQty, modulePower: panel?.wattage ?? 580,
            panelModel: solarPanelModel, panelType: panel?.panelType ?? "",
            inverterModel: solarInverterModel, inverterCapacity: inv?.capacity ?? solarInverterModel,
            batteryModel: solarBatteryModel, batterySpec: bat?.spec ?? "",
            batteryQty: solarPlantType === "ongrid" ? 0 : solarBatteryQty,
          },
          costs: activeCosts,
        }),
      })
      .then(r => { if (!r.ok) throw new Error("PDF failed"); return r.blob(); })
      .then(blob => {
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `Quotation_${(selectedCustomer?.name ?? customerForm.name).replace(/\s+/g,"_")}_${solarCapacityKw}KW.pdf`;
        a.click(); URL.revokeObjectURL(url);
        toast({ title: "✅ PDF Downloaded" });
      })
      .catch(() => toast({ title: "Error", description: "PDF generation failed", variant: "destructive" }))
      .finally(() => setSolarPdfLoading(false));
    } else {
      if (!savedQuotationId) {
        toast({ title: "Save first", description: "Please save the quotation before downloading PDF", variant: "destructive" });
        return;
      }
      window.open(`/api/billing/invoices/${savedQuotationId}/pdf`, "_blank");
      toast({ title: "✅ PDF Opened", description: "Use Ctrl+P to save as PDF" });
    }
  }

  async function sendEmail() {
    if (!savedQuotationId) {
      toast({ title: "Save first", description: "Please save the quotation first", variant: "destructive" });
      return;
    }
    const email = customerForm.email;
    if (!email) {
      toast({ title: "No email", description: "Please enter customer email address", variant: "destructive" });
      return;
    }
    try {
      const res = await fetch(`/api/billing/invoices/${savedQuotationId}/send-email`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (data.success) {
        toast({ title: "✅ Email Sent!", description: `Quotation sent to ${email}` });
      } else {
        toast({ title: "Email Failed", description: data.error || "Could not send email", variant: "destructive" });
      }
    } catch (err) {
      console.error(err);
      toast({ title: "Error", description: "Failed to send email", variant: "destructive" });
    }
  }

  function sendWhatsApp() {
    if (!savedQuotationId) {
      toast({ title: "Save first", description: "Please save the quotation first", variant: "destructive" });
      return;
    }
    const phone = customerForm.phone;
    if (!phone) {
      toast({ title: "No phone", description: "Please enter customer WhatsApp number", variant: "destructive" });
      return;
    }
    const clean = phone.replace(/[^0-9]/g, "");
    const wa = clean.startsWith("91") ? clean : "91" + clean;
    const pdfUrl = getPdfUrl();

    // Build item summary (max 5 items shown)
    const itemLines = lineItems
      .filter(li => li.product_name)
      .slice(0, 5)
      .map((li, i) => `${i + 1}. ${li.product_name} × ${li.quantity} = ₹${(li.quantity * li.unit_price).toLocaleString('en-IN')}`)
      .join("\n");
    const moreItems = lineItems.filter(li => li.product_name).length > 5
      ? `\n... and ${lineItems.filter(li => li.product_name).length - 5} more items`
      : "";

    const msg = encodeURIComponent(
      `*Quotation ${savedQuotationNo} — Divyanshi Solar* ☀️\n\n` +
      `Dear ${customerForm.name},\n\n` +
      `${itemLines}${moreItems}\n\n` +
      `*Total: ₹${totals.grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}*\n` +
      `Valid for: ${validDays} days\n\n` +
      `📄 PDF: ${pdfUrl}\n\n` +
      `Thank you!\n_Divyanshi Solar_ | 📞 9801005212`
    );
    window.open(`https://wa.me/${wa}?text=${msg}`, "_blank");
    toast({ title: "✅ WhatsApp", description: "Opening WhatsApp..." });
  }

  // ── Render ─────────────────────────────────────────────────
  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <Loader2 className="w-8 h-8 animate-spin text-primary" />
        <span className="ml-3 text-lg">Loading product catalog...</span>
      </div>
    );
  }

  const orderedSegments = SEGMENT_ORDER.filter(s => segments[s]?.length > 0);
  Object.keys(segments).forEach(s => {
    if (!orderedSegments.includes(s) && segments[s]?.length > 0) orderedSegments.push(s);
  });

  return (
    <div className="p-4 md:p-6 max-w-[1400px] mx-auto">
      {/* ── Header ──────────────────────────────────────────── */}
      <div className="flex items-center justify-between mb-6">
        <div className="flex items-center gap-3">
          <Button variant="ghost" size="sm" onClick={() => window.history.back()}>
            <ArrowLeft className="w-4 h-4" />
          </Button>
          <div>
            <h1 className="text-2xl font-bold text-primary">Create Quotation</h1>
            <p className="text-sm text-muted-foreground">Select products by segment, auto-fill customer</p>
          </div>
        </div>
        {savedQuotationId && (
          <div className="flex gap-2">
            <Button variant="outline" onClick={downloadPDF} >
              <Download className="w-4 h-4 mr-2" /> PDF
            </Button>
            <Button variant="outline" onClick={sendEmail}
              className="text-blue-600 border-blue-300 hover:bg-blue-50">
              <Mail className="w-4 h-4 mr-2" /> Email
            </Button>
            <Button variant="outline" onClick={sendWhatsApp}
              className="text-green-600 border-green-300 hover:bg-green-50">
              <Phone className="w-4 h-4 mr-2" /> WhatsApp
            </Button>
          </div>
        )}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* ═══ LEFT: Product Catalog by Segment ═══ */}
        <div className="lg:col-span-1 space-y-2 max-h-[85vh] overflow-y-auto pr-2">
          <h3 className="font-semibold text-sm text-muted-foreground uppercase tracking-wider mb-3">
            📦 Product Catalog
          </h3>
          {orderedSegments.map(segName => {
            const meta = SEGMENT_META[segName] || { icon: "📦", color: "#6b7280" };
            const products = segments[segName] || [];
            const isOpen = expandedSegments.has(segName);
            return (
              <div key={segName} className="border rounded-lg overflow-hidden">
                <button
                  onClick={() => toggleSegment(segName)}
                  className="w-full flex items-center justify-between p-3 hover:bg-accent/50 transition-colors"
                  style={{ borderLeft: `4px solid ${meta.color}` }}
                >
                  <span className="flex items-center gap-2 font-medium text-sm">
                    <span>{meta.icon}</span>
                    {segName}
                    <Badge variant="secondary" className="text-xs">{products.length}</Badge>
                  </span>
                  {isOpen ? <ChevronDown className="w-4 h-4" /> : <ChevronRight className="w-4 h-4" />}
                </button>
                {isOpen && (
                  <div className="border-t divide-y">
                    {products.map((prod: Product) => {
                      const isKitOpen = expandedKits.has(prod.id);
                      const KIT_SEGMENTS = ["Lead-Acid Hybrid Solar Kit","Lithium Hybrid Solar Kit","Off-Grid Solar Kit","On-Grid Solar System","Solar EPC Power Project"];
                      const isKit     = prod.is_combo || KIT_SEGMENTS.includes(prod.segment);
                      const kitSpecs: any = null;

                      // ── Kit / Combo product ──────────────────────────────
                      if (isKit) return (
                        <div key={prod.id} className="border-b last:border-0">
                          {/* Kit header row */}
                          <div className="flex items-center justify-between p-2 px-3 hover:bg-accent/30 group text-sm">
                            <div className="flex-1 min-w-0 cursor-pointer" onClick={() => addProductToQuotation(prod)}>
                              <div className="flex items-center gap-1.5 flex-wrap">
                                <span className="font-semibold text-blue-800 leading-tight">{prod.name}</span>
                                <Badge className="text-[9px] py-0 px-1 bg-blue-700 text-white">KIT</Badge>
                                {prod.sub_segment && (
                                  <Badge variant="outline" className="text-[9px] py-0 px-1">{prod.sub_segment}</Badge>
                                )}
                              </div>
                              <div className="text-xs text-muted-foreground mt-0.5">
                                HSN: {prod.hsn_code} | GST: {prod.gst_rate}%
                              </div>
                            </div>
                            <div className="flex items-center gap-1.5 ml-2 shrink-0">
                              <span className="font-bold text-primary whitespace-nowrap text-sm">
                                ₹{prod.price.toLocaleString('en-IN')}
                              </span>
                              {/* Expand specs button */}
                              <button
                                type="button"
                                onClick={(e) => { e.stopPropagation(); setExpandedKits(prev => { const n = new Set(prev); n.has(prod.id) ? n.delete(prod.id) : n.add(prod.id); return n; }); }}
                                className={`p-1 rounded transition-colors ${isKitOpen ? "bg-blue-100 text-blue-700" : "hover:bg-accent text-muted-foreground"}`}
                                title="View specifications"
                              >
                                {isKitOpen ? <ChevronDown className="w-3.5 h-3.5" /> : <ChevronRight className="w-3.5 h-3.5" />}
                              </button>
                              <button
                                type="button"
                                onClick={() => addProductToQuotation(prod)}
                                className="p-1 rounded hover:bg-green-100 text-green-600 transition-colors"
                                title="Add to quotation"
                              >
                                <Plus className="w-3.5 h-3.5" />
                              </button>
                            </div>
                          </div>

                          {/* Expandable spec panel */}
                          {isKitOpen && (
                            <div className="bg-blue-50/60 border-t border-blue-100 px-3 py-2.5 space-y-2">
                              {/* Spec grid */}
                              {kitSpecs && Object.keys(kitSpecs).length > 0 ? (
                                <div className="grid grid-cols-2 gap-x-4 gap-y-1">
                                  {Object.entries(kitSpecs).map(([k, v]) => (
                                    <div key={k} className="text-xs">
                                      <span className="text-muted-foreground">{k}: </span>
                                      <span className="font-semibold text-gray-800">{String(v)}</span>
                                    </div>
                                  ))}
                                </div>
                              ) : (
                                /* Parse from product name dynamically */
                                <div className="text-xs text-muted-foreground italic">Expand to see specifications from product name</div>
                              )}

                              {/* Fixed BOM items always shown for solar kits */}
                              <div className="pt-1.5 border-t border-blue-200">
                                <p className="text-[10px] font-semibold text-blue-700 uppercase tracking-wide mb-1">Includes in BOM</p>
                                <div className="grid grid-cols-1 gap-0.5">
                                  {[
                                    { icon:"🏗️", text:"G.I. Pipe Mounting Structure (60×40×2mm) — HINDUSTAR" },
                                    { icon:"⚡", text:"ACDB / DCDB — MCB & SPD — L&T / Havells" },
                                    { icon:"🌱", text:"Earthing & Lightning Arrestor — Copper / Reputed" },
                                    { icon:"🔌", text:"DC + AC + LT Cables — Polycab" },
                                    { icon:"🔧", text:"Conduit, Lugs, MC4 Connectors, Saddles — Reputed" },
                                    ...(!prod.segment?.toLowerCase().includes("off") ? [{ icon:"📟", text:"Net Energy Meter — SECURE" }] : []),
                                  ].map((item, i) => (
                                    <div key={i} className="flex items-start gap-1 text-[10px] text-gray-600">
                                      <span>{item.icon}</span>
                                      <span>{item.text}</span>
                                    </div>
                                  ))}
                                </div>
                              </div>

                              {/* Add button */}
                              <button
                                type="button"
                                onClick={() => addProductToQuotation(prod)}
                                className="w-full mt-1 py-1.5 rounded-md bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1"
                              >
                                <Plus className="w-3 h-3" /> Add to Quotation
                              </button>
                            </div>
                          )}
                        </div>
                      );

                      // ── Regular (non-kit) product ────────────────────────
                      return (
                        <div
                          key={prod.id}
                          className="flex items-center justify-between p-2 px-3 hover:bg-accent/30 cursor-pointer group text-sm border-b last:border-0"
                          onClick={() => addProductToQuotation(prod)}
                        >
                          <div className="flex-1 min-w-0">
                            <div className="font-medium truncate">{prod.name}</div>
                            <div className="text-xs text-muted-foreground">
                              HSN: {prod.hsn_code} | GST: {prod.gst_rate}%
                            </div>
                          </div>
                          <div className="flex items-center gap-2 ml-2">
                            <span className="font-semibold text-primary whitespace-nowrap">
                              ₹{prod.price.toLocaleString('en-IN')}
                            </span>
                            <Plus className="w-4 h-4 opacity-0 group-hover:opacity-100 text-green-600 transition-opacity" />
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {/* ═══ RIGHT: Quotation Form ═══ */}
        <div className="lg:col-span-2 space-y-6">
          {/* ── Company & Customer ─────────────────────────── */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <Card>
              <CardHeader className="pb-3">
                <CardTitle className="text-sm flex items-center gap-2">
                  <Building2 className="w-4 h-4" /> Billing Company
                </CardTitle>
              </CardHeader>
              <CardContent>
                <Select value={companyId} onValueChange={setCompanyId}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>
                    {companies.map((c: any) => (
                      <SelectItem key={c.id} value={String(c.id)}>{c.name}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </CardContent>
            </Card>

            <Card>
              <CardHeader className="pb-3">
                <CardTitle className="text-sm flex items-center gap-2">
                  <User className="w-4 h-4" /> Customer (Auto-populate)
                </CardTitle>
              </CardHeader>
              <CardContent>
                <div className="relative">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
                  <Input
                    placeholder="Search name, phone, email, GSTIN..."
                    value={customerSearch}
                    onChange={(e) => {
                      setCustomerSearch(e.target.value);
                      setSelectedCustomer(null);
                    }}
                    className="pl-9"
                  />
                  {showCustomerDropdown && customerResults.length > 0 && (
                    <div className="absolute z-50 w-full mt-1 bg-background border rounded-lg shadow-lg max-h-48 overflow-y-auto">
                      {customerResults.map(cust => (
                        <div
                          key={cust.id}
                          className="p-2 px-3 hover:bg-accent cursor-pointer border-b last:border-0"
                          onClick={() => selectCustomer(cust)}
                        >
                          <div className="font-medium text-sm">{cust.name}</div>
                          <div className="text-xs text-muted-foreground">
                            📞 {cust.phone} {cust.email && `| ✉️ ${cust.email}`}
                            {cust.gstin && ` | GST: ${cust.gstin}`}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
                {selectedCustomer && (
                  <p className="text-xs text-green-600 mt-1">✅ Auto-filled from: {selectedCustomer.name}</p>
                )}
              </CardContent>
            </Card>
          </div>

          {/* ── Customer details ──────────────────────────── */}
          <Card>
            <CardContent className="pt-4">
              <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div>
                  <Label className="text-xs">Customer Name *</Label>
                  <Input value={customerForm.name} onChange={e => setCustomerForm(f => ({ ...f, name: e.target.value }))} />
                </div>
                <div>
                  <Label className="text-xs">Phone</Label>
                  <Input value={customerForm.phone} onChange={e => setCustomerForm(f => ({ ...f, phone: e.target.value }))} />
                </div>
                <div>
                  <Label className="text-xs">Email</Label>
                  <Input value={customerForm.email} onChange={e => setCustomerForm(f => ({ ...f, email: e.target.value }))} />
                </div>
                <div>
                  <Label className="text-xs">GSTIN</Label>
                  <Input value={customerForm.gstin} onChange={e => setCustomerForm(f => ({ ...f, gstin: e.target.value }))} placeholder="Optional" />
                </div>
                <div className="col-span-2">
                  <Label className="text-xs">Address</Label>
                  <Input value={customerForm.address} onChange={e => setCustomerForm(f => ({ ...f, address: e.target.value }))} />
                </div>
                <div>
                  <Label className="text-xs">City</Label>
                  <Input value={customerForm.city} onChange={e => setCustomerForm(f => ({ ...f, city: e.target.value }))} />
                </div>
                <div>
                  <Label className="text-xs">State</Label>
                  <Select value={customerForm.state_code} onValueChange={v => {
                    const st = INDIAN_STATES.find(s => s.code === v);
                    setCustomerForm(f => ({ ...f, state: st?.name || "", state_code: v }));
                  }}>
                    <SelectTrigger><SelectValue /></SelectTrigger>
                    <SelectContent>
                      {INDIAN_STATES.map(s => (
                        <SelectItem key={s.code} value={s.code}>{s.name}</SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* ── Line Items Table ──────────────────────────── */}
          <Card>
            <CardHeader className="pb-2">
              <CardTitle className="text-sm flex items-center justify-between">
                <span className="flex items-center gap-2">
                  <Package className="w-4 h-4" /> Line Items
                </span>
                <Button size="sm" variant="outline" onClick={() => setLineItems(prev => [...prev, createEmptyLine()])}>
                  <Plus className="w-3 h-3 mr-1" /> Add Row
                </Button>
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="bg-primary/5 text-left">
                      <th className="p-2 w-8">#</th>
                      <th className="p-2">Product</th>
                      <th className="p-2 w-16">HSN</th>
                      <th className="p-2 w-16">Qty</th>
                      <th className="p-2 w-24">Rate (₹)</th>
                      <th className="p-2 w-16">Disc%</th>
                      <th className="p-2 w-16">GST%</th>
                      <th className="p-2 w-24 text-right">Amount</th>
                      <th className="p-2 w-8"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {lineItems.map((li, idx) => {
                      const calc = calculations[idx];
                      return (
                        <tr key={li.key} className="border-b hover:bg-accent/20">
                          <td className="p-2 text-center text-muted-foreground">{idx + 1}</td>
                          <td className="p-2">
                            <Input
                              value={li.product_name}
                              onChange={e => updateLineItem(li.key, "product_name", e.target.value)}
                              placeholder="Product name or custom description"
                              className="h-8 text-sm"
                            />
                            {li.segment && (
                              <span className="text-[10px] text-muted-foreground">{li.segment}</span>
                            )}
                          </td>
                          <td className="p-2">
                            <Input value={li.hsn_code} onChange={e => updateLineItem(li.key, "hsn_code", e.target.value)} className="h-8 text-sm w-16" />
                          </td>
                          <td className="p-2">
                            <Input type="number" value={li.quantity} min={1}
                              onChange={e => updateLineItem(li.key, "quantity", Number(e.target.value))} className="h-8 text-sm w-16" />
                          </td>
                          <td className="p-2">
                            <Input type="number" value={li.unit_price} min={0}
                              onChange={e => updateLineItem(li.key, "unit_price", Number(e.target.value))} className="h-8 text-sm w-24" />
                          </td>
                          <td className="p-2">
                            <Input type="number" value={li.discount_percent} min={0} max={100}
                              onChange={e => updateLineItem(li.key, "discount_percent", Number(e.target.value))} className="h-8 text-sm w-16" />
                          </td>
                          <td className="p-2">
                            <Select value={String(li.gst_rate)} onValueChange={v => updateLineItem(li.key, "gst_rate", Number(v))}>
                              <SelectTrigger className="h-8 text-sm w-16"><SelectValue /></SelectTrigger>
                              <SelectContent>
                                {GST_RATES.map(r => <SelectItem key={r} value={r}>{r}%</SelectItem>)}
                              </SelectContent>
                            </Select>
                          </td>
                          <td className="p-2 text-right font-medium">
                            ₹{(calc?.total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                          </td>
                          <td className="p-2">
                            <Button variant="ghost" size="sm" onClick={() => removeLine(li.key)}
                              className="h-7 w-7 p-0 text-destructive hover:text-destructive">
                              <Trash2 className="w-3 h-3" />
                            </Button>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              {/* ── Totals ────────────────────────────────── */}
              <div className="flex justify-between mt-4">
                <div className="space-y-2 w-64">
                  <div>
                    <Label className="text-xs">Notes</Label>
                    <Textarea value={notes} onChange={e => setNotes(e.target.value)}
                      placeholder="Additional notes..." rows={3} className="text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Valid for (days)</Label>
                    <Input type="number" value={validDays} onChange={e => setValidDays(e.target.value)}
                      className="w-24 h-8 text-sm" />
                  </div>
                </div>

                <div className="w-72 space-y-1 text-sm">
                  <div className="flex justify-between">
                    <span>Subtotal</span>
                    <span className="font-medium">₹{totals.subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                  </div>
                  {isIntraState ? (
                    <>
                      <div className="flex justify-between text-muted-foreground">
                        <span>CGST</span><span>₹{totals.cgst.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                      </div>
                      <div className="flex justify-between text-muted-foreground">
                        <span>SGST</span><span>₹{totals.sgst.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                      </div>
                    </>
                  ) : (
                    <div className="flex justify-between text-muted-foreground">
                      <span>IGST</span><span>₹{totals.igst.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                    </div>
                  )}
                  <div className="flex justify-between pt-2 border-t-2 border-primary font-bold text-lg text-primary">
                    <span>Grand Total</span>
                    <span>₹{totals.grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                  </div>
                  <p className="text-xs text-muted-foreground">
                    {isIntraState ? "Intra-State (CGST + SGST)" : "Inter-State (IGST)"}
                  </p>
                </div>
              </div>
            </CardContent>
          </Card>

                    <SolarQuotationSection
            solarEnabled={solarEnabled} setSolarEnabled={setSolarEnabled}
            solarPlantType={solarPlantType} setSolarPlantType={setSolarPlantType}
            solarCapacityKw={solarCapacityKw} setSolarCapacityKw={setSolarCapacityKw}
            solarPanelModel={solarPanelModel} setSolarPanelModel={setSolarPanelModel}
            solarPanelQty={solarPanelQty}
            solarInverterModel={solarInverterModel} setSolarInverterModel={setSolarInverterModel}
            solarBatteryModel={solarBatteryModel} setSolarBatteryModel={setSolarBatteryModel}
            solarBatteryQty={solarBatteryQty} setSolarBatteryQty={setSolarBatteryQty}
            solarNetMeterOn={solarNetMeterOn} setSolarNetMeterOn={setSolarNetMeterOn}
            solarCosts={solarCosts} setSolarCosts={setSolarCosts}
            solarRatesEdited={solarRatesEdited} setSolarRatesEdited={setSolarRatesEdited}
            solarShowBom={solarShowBom} setSolarShowBom={setSolarShowBom}
            solarConsumerNo={solarConsumerNo} setSolarConsumerNo={setSolarConsumerNo}
            solarSiteAddress={solarSiteAddress} setSolarSiteAddress={setSolarSiteAddress}
            solarPartnerName={solarPartnerName} setSolarPartnerName={setSolarPartnerName}
            solarPartnerMobile={solarPartnerMobile} setSolarPartnerMobile={setSolarPartnerMobile}
          />
          {/* ── Action Buttons ────────────────────────────── */}
          <div className="flex justify-end gap-3">
            <Button variant="outline" onClick={() => window.history.back()}>Cancel</Button>
            <Button onClick={saveQuotation} disabled={saving} className="min-w-[160px]">
              {saving ? <Loader2 className="w-4 h-4 mr-2 animate-spin" /> : <FileText className="w-4 h-4 mr-2" />}
              {savedQuotationId ? "Update Quotation" : "Save Quotation"}
            </Button>
          </div>

          {/* ── Post-save share actions ───────────────────── */}
          {savedQuotationId && (
            <Card className="border-green-300 bg-green-50/50">
              <CardContent className="pt-4">
                <p className="text-sm font-medium text-green-800 mb-3">
                  ✅ Quotation {savedQuotationNo} saved! Share with customer:
                </p>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                  <div>
                    <Label className="text-xs">Customer Email</Label>
                    <Input value={customerForm.email}
                      onChange={e => setCustomerForm(f => ({ ...f, email: e.target.value }))}
                      placeholder="customer@email.com" className="h-8 text-sm" />
                  </div>
                  <div>
                    <Label className="text-xs">Customer WhatsApp No.</Label>
                    <Input value={customerForm.phone}
                      onChange={e => setCustomerForm(f => ({ ...f, phone: e.target.value }))}
                      placeholder="9876543210" className="h-8 text-sm" />
                  </div>
                </div>
                <div className="flex flex-wrap gap-2">
                  <Button size="sm" onClick={downloadPDF} 
                    className="bg-amber-500 hover:bg-amber-600">
                    <Download className="w-4 h-4 mr-2" />
                    Download PDF
                  </Button>
                  <Button size="sm" onClick={sendEmail} className="bg-blue-500 hover:bg-blue-600">
                    <Mail className="w-4 h-4 mr-2" /> Send via Email
                  </Button>
                  <Button size="sm" onClick={sendWhatsApp} className="bg-green-600 hover:bg-green-700">
                    <Send className="w-4 h-4 mr-2" /> Send via WhatsApp
                  </Button>
                </div>
              </CardContent>
            </Card>
          )}
        </div>
      </div>
    </div>
  );
}
