  service: 0.18, contractor: 0.18,
};

// Extract base from inclusive amount
function splitGST(inclusive: number, gstPct: number) {
  const base = Math.round(inclusive / (1 + gstPct));
  const gst = inclusive - base;
  return { base, gst, total: inclusive };
}

