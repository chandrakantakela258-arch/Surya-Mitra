                  </tr>
                </tbody>
              </table>

              {notes && <div style={{marginTop:12,padding:"8px 14px",background:"#FFF3E0",borderRadius:6,border:"1px solid #FFE0B2",fontSize:11}}><strong style={{color:"#E65100"}}>Additional Note:</strong> {notes}</div>}

