                  </tr>
                  <tr>
                    <td style={{textAlign:"center",fontWeight:700,verticalAlign:"top",background:"#f0f4f8"}}>8</td>
                    <td style={{fontWeight:700,verticalAlign:"top",background:"#f0f4f8"}}>Solar System Warranty</td>
