              {/* Page 2 Footer */}
              <div style={{marginTop:24,borderTop:"2px solid #333",paddingTop:8}}>
                <div style={{fontSize:9}}>
                  <strong>Office:</strong> Bank of India Building, Naubatpur, Mashurhi Road, Vill-Piprawan, Block-Naubatpur, Patna, Bihar 801109
                </div>
                <div style={{fontSize:8,marginTop:4,color:"#666"}}>
