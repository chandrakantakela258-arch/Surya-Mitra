import { useState, useRef, useMemo } from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Switch } from "@/components/ui/switch";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { FileText, Printer, X, Battery, Download, Loader2 } from "lucide-react";
import { jsPDF } from "jspdf";
import html2canvas from "html2canvas";
import { calculateSubsidy, formatINR, getInverterOptions } from "@/components/subsidy-calculator";
import type { SubsidyResult, InverterType } from "@/components/subsidy-calculator";
import type { Customer } from "@shared/schema";

const LOGO = "data:image/jpeg;base64,";


interface EquipmentOptions {
  moduleMakes: { make: string; models: string[] }[];
  inverterMakes: { make: string; models: string[] }[];
  batteryMakes: { make: string; models: string[] }[];
}

interface Props { customer: Customer; subsidyInfo: SubsidyResult | null; open: boolean; onClose: () => void; equipmentOptions?: EquipmentOptions | null; }

// GST rates - rates from calculator are INCLUSIVE of tax
const GST_RATES: Record<string, number> = {
  panels: 0.05, inverter: 0.05, battery: 0.05,
  structure: 0.18, wiring: 0.18, netMeter: 0.18,
  transport: 0.18, installation: 0.18, misc: 0.18,
  service: 0.18, contractor: 0.18,
};

// Extract base from inclusive amount
function splitGST(inclusive: number, gstPct: number) {
  const base = Math.round(inclusive / (1 + gstPct));
  const gst = inclusive - base;
  return { base, gst, total: inclusive };
}

// Inverter capacity options
const INV_CAPACITIES = ["1","2","3","3.6","4","5","6","8","10","15","20","25","30","50"];

export function QuotationGenerator({ customer, subsidyInfo, open, onClose, equipmentOptions }: Props) {
  const [view, setView] = useState<"config" | "preview">("config");
  const printRef = useRef<HTMLDivElement>(null);

  const [plantType, setPlantType] = useState<"residential"|"commercial"|"industrial">((customer.customerType as any) || "residential");
  const [invType, setInvType] = useState<InverterType>(customer.inverterType === "ongrid" || customer.inverterType === "on-grid" ? "ongrid" : "hybrid");
  const [panelType, setPanelType] = useState<"dcr"|"non_dcr">(customer.panelType === "non_dcr" ? "non_dcr" : "dcr");
  const [invCapacity, setInvCapacity] = useState(String(subsidyInfo?.inverterCapacityKW || "0"));
  const [withBattery, setWithBattery] = useState(false);
  const [batteryType, setBatteryType] = useState<"lead_acid"|"lithium_ion">("lithium_ion");
  const [downloading, setDownloading] = useState(false);
  const [panelWatt, setPanelWatt] = useState(540);
  const [downPaymentPct, setDownPaymentPct] = useState(15);
  const [selModuleMake, setSelModuleMake] = useState("");
  const [selModuleModel, setSelModuleModel] = useState("");
  const [selInvMake, setSelInvMake] = useState("");
  const [selInvModel, setSelInvModel] = useState("");
  const [selBatMake, setSelBatMake] = useState("");
  const [selBatModel, setSelBatModel] = useState("");
  const [discount, setDiscount] = useState("0");
  const [validity, setValidity] = useState("30");
  const [notes, setNotes] = useState("");
  const [useCustomRates, setUseCustomRates] = useState(false);
  const [netMeterOn, setNetMeterOn] = useState(true);

  const [rates, setRates] = useState({
    panels: 30000, inverter: 16000, structure: 6000, wiring: 6000,
    netMeter: 1000, transport: 2000, installation: 3000, misc: 3500,
    service: 4000, contractor: 3500,
  });

  const capacity = parseFloat(customer.proposedCapacity || "0") || 0;
  const panels = Math.ceil(capacity * 1000 / panelWatt);
  const invCapKW = parseFloat(invCapacity) || 0;

  const customRatePerKW = rates.panels + rates.inverter + rates.structure + rates.wiring
    + (netMeterOn ? rates.netMeter : 0) + rates.transport + rates.installation
    + rates.misc + rates.service + rates.contractor;

  const calc = useMemo(() => {
    if (capacity <= 0) return null;
    return calculateSubsidy(
      capacity, customer.state || "", panelType, invType, plantType,
      6, 7, 15,
      useCustomRates ? (customRatePerKW / 1000) : null,
      withBattery, batteryType as any, invCapKW
    );
  }, [capacity, customer.state, panelType, invType, plantType, withBattery, batteryType, useCustomRates, customRatePerKW, invCapKW]);

  // Update inv capacity when calc returns
  useMemo(() => {
    if (calc && invCapacity === "0") setInvCapacity(String(calc.inverterCapacityKW || capacity));
  }, [calc]);

  const subsidyAmt = calc?.totalSubsidy || 0;
  const ratePerWatt = calc?.ratePerWatt || 0;
  const batteryCost = calc?.batteryCostAmount || 0;
  const actualInvCap = calc?.inverterCapacityKW || invCapKW || capacity;

  // Plant cost = itemized total (always match)
  const itemizedBase = (rates.panels * capacity) + (rates.inverter * (parseFloat(invCapacity) || capacity))
    + (rates.structure * capacity) + (rates.wiring * capacity)
    + (netMeterOn ? rates.netMeter * capacity : 0) + (rates.transport * capacity)
    + (rates.installation * capacity) + (rates.misc * capacity)
    + (rates.service * capacity) + (rates.contractor * capacity)
    + (withBattery ? batteryCost : 0);
  const totalCost = itemizedBase;
  const disc = parseInt(discount) || 0;
  const downPayment = Math.round(totalCost * downPaymentPct / 100);
  const loanAmount = totalCost - downPayment - disc;

  const today = new Date();
  const fmtD = today.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  const custHash = (customer.id || "").split("").reduce((a: number, c: string) => a + c.charCodeAt(0), 0) % 9000 + 1000;
  const qn = `SXP/${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,"0")}/${custHash}`;
  const plantLabel = `${capacity} KW ${invType === "ongrid" ? "On-Grid" : "Hybrid"} Solar Plant`;

  // GST breakdown - rates are INCLUSIVE, split into base + gst
  const gstRows = [
    { label: "Solar Panels", inclusive: rates.panels * capacity, gst: GST_RATES.panels, gstLabel: "5%" },
    { label: `Inverter (${actualInvCap} KW)`, inclusive: rates.inverter * (parseFloat(invCapacity) || capacity), gst: GST_RATES.inverter, gstLabel: "5%" },
    ...(withBattery ? [{ label: `Battery (${batteryType === "lithium_ion" ? "Li-Ion" : "Lead Acid"})`, inclusive: batteryCost, gst: GST_RATES.battery, gstLabel: "5%" }] : []),
    { label: "Structure", inclusive: rates.structure * capacity, gst: GST_RATES.structure, gstLabel: "18%" },
    { label: "Cables & Wiring", inclusive: rates.wiring * capacity, gst: GST_RATES.wiring, gstLabel: "18%" },
    ...(netMeterOn ? [{ label: "Net Meter", inclusive: rates.netMeter * capacity, gst: GST_RATES.netMeter, gstLabel: "18%" }] : []),
    { label: "Transport", inclusive: rates.transport * capacity, gst: GST_RATES.transport, gstLabel: "18%" },
    { label: "Installation", inclusive: rates.installation * capacity, gst: GST_RATES.installation, gstLabel: "18%" },
    { label: "Misc & Accessories", inclusive: rates.misc * capacity, gst: GST_RATES.misc, gstLabel: "18%" },
    { label: "Service Charge (5yr)", inclusive: rates.service * capacity, gst: GST_RATES.service, gstLabel: "18%" },
    { label: "Contractor Profit", inclusive: rates.contractor * capacity, gst: GST_RATES.contractor, gstLabel: "18%" },
  ].map(r => ({ ...r, ...splitGST(r.inclusive, r.gst) }));

  const totBase = gstRows.reduce((s, r) => s + r.base, 0);
  const totGST = gstRows.reduce((s, r) => s + r.gst, 0);
  const totInc = gstRows.reduce((s, r) => s + r.total, 0);

  // Print quotation
  const handlePrint = () => {
    const el = printRef.current;
    if (!el) return;
    const w = window.open("", "_blank");
    if (!w) return;
    w.document.write(`<!DOCTYPE html><html><head><title>Quotation_${customer.name?.replace(/\s+/g,"_")}_${capacity}KW</title>
      <style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui,sans-serif;color:#222;background:#fff;font-size:12px;line-height:1.4}
      @media print{body{-webkit-print-color-adjust:exact;print-color-adjust:exact}.noprint{display:none!important}}
      table{width:100%;border-collapse:collapse}th,td{border:1px solid #bbb;padding:7px 10px;text-align:left}th{background:#e8edf2;font-weight:700;font-size:10px;text-transform:uppercase;color:#333}
      .box{background:#f5f7fa;border:1.5px solid #d0d5dd;border-radius:8px;padding:14px;text-align:center}
      .box-hl{background:#e3f2fd;border:2px solid #1565C0;border-radius:8px;padding:14px;text-align:center}
      </style></head><body>${el.innerHTML}</body></html>`);
    w.document.close();
    setTimeout(() => w.print(), 600);
  };

  // Download as PDF file for bank submission
  const handleDownload = async () => {
    const el = printRef.current;
    if (!el) return;
    setDownloading(true);
    try {
      const canvas = await html2canvas(el, { scale: 2, useCORS: true, allowTaint: true, backgroundColor: "#ffffff", logging: false });
      const imgData = canvas.toDataURL("image/jpeg", 0.95);
      const pdf = new jsPDF("p", "mm", "a4");
      const pdfW = pdf.internal.pageSize.getWidth();
      const pdfH = pdf.internal.pageSize.getHeight();
      const imgW = pdfW - 16;
      const imgH = (canvas.height * imgW) / canvas.width;
      let left = imgH;
      let pos = 8;
      pdf.addImage(imgData, "JPEG", 8, pos, imgW, imgH);
      left -= pdfH;
      while (left > 0) {
        pos = left - imgH + 8;
        pdf.addPage();
        pdf.addImage(imgData, "JPEG", 8, pos, imgW, imgH);
        left -= pdfH;
      }
      pdf.save(`Quotation_${customer.name?.replace(/\s+/g,"_")}_${capacity}KW.pdf`);
    } catch (err) {
      console.error("PDF failed:", err);
      handlePrint();
    } finally {
      setDownloading(false);
    }
  };

  if (!open) return null;

  const Tog = ({ label, value, options, onChange, colors }: any) => (
    <div>
      {label && <Label className="text-[10px] font-bold uppercase text-muted-foreground tracking-wide">{label}</Label>}
      <div className="flex gap-1 mt-1">
        {options.map((o: any) => (
          <button key={o.v} onClick={() => onChange(o.v)}
            className={`px-3 py-1.5 text-xs font-semibold rounded-md border transition-all ${value === o.v ? (colors || "bg-primary text-primary-foreground border-primary") : "bg-muted border-border hover:bg-accent"}`}>
            {o.l}
          </button>
        ))}
      </div>
    </div>
  );

  // ===== CONFIG =====
  if (view === "config") return (
    <Dialog open={open} onOpenChange={onClose}>
      <DialogContent className="max-w-4xl max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2 text-base">
            <FileText className="w-5 h-5" />Generate Quotation &mdash; {customer.name} ({capacity} KW)
          </DialogTitle>
        </DialogHeader>
        <div className="space-y-4">
          {/* Toggles Row 1 */}
          <div className="grid grid-cols-3 gap-4">
            <Tog label="Plant Type" value={plantType} onChange={setPlantType}
              options={[{v:"residential",l:"Residential"},{v:"commercial",l:"Commercial"},{v:"industrial",l:"Industrial"}]} />
            <Tog label="Panel Type" value={panelType} onChange={setPanelType}
              colors="bg-green-600 text-white border-green-600"
              options={[{v:"dcr",l:"DCR"},{v:"non_dcr",l:"Non-DCR"}]} />
            <Tog label="Inverter Type" value={invType} onChange={setInvType}
              colors="bg-blue-600 text-white border-blue-600"
              options={[{v:"ongrid",l:"On-Grid"},{v:"hybrid",l:"Hybrid"}]} />
          </div>

          {/* Inverter Capacity + Battery */}
          <div className="grid grid-cols-2 gap-4">
            <div className="p-3 rounded-lg border bg-muted/30">
              <Label className="text-[10px] font-bold uppercase text-muted-foreground tracking-wide mb-2 block">Inverter Capacity (KW)</Label>
              <div className="flex gap-1 flex-wrap">
                {["3.6","5","6","8","10","15","20","25"].map(cap => (
                  <button key={cap} onClick={() => setInvCapacity(cap)}
                    className={`px-3 py-1.5 text-xs font-semibold rounded-md border transition-all ${invCapacity === cap ? "bg-purple-600 text-white border-purple-600" : "bg-background border-border hover:bg-accent"}`}>
                    {cap} KW
                  </button>
                ))}
                <Input type="number" value={invCapacity} onChange={e => setInvCapacity(e.target.value)}
                  className="w-20 h-8 text-xs" placeholder="Custom" />
              </div>
            </div>
            <div className="p-3 rounded-lg border bg-muted/30">
              <div className="flex items-center gap-3 mb-2">
                <Switch checked={withBattery} onCheckedChange={setWithBattery} />
                <Label className="text-sm font-medium flex items-center gap-1"><Battery className="w-4 h-4" /> Battery</Label>
                {withBattery && batteryCost > 0 && <Badge variant="outline" className="ml-auto text-xs">{formatINR(batteryCost)}</Badge>}
              </div>
              {withBattery && <Tog label="" value={batteryType} onChange={setBatteryType}
                colors="bg-orange-600 text-white border-orange-600"
                options={[{v:"lithium_ion",l:"Lithium Ion"},{v:"lead_acid",l:"Lead Acid"}]} />}
            </div>
          </div>


          {/* Equipment Selection — Make & Model */}
          <Card className="border-slate-300">
            <CardContent className="pt-4">
              <span className="text-sm font-semibold text-muted-foreground mb-3 block">Solar Equipment Selection</span>
              <table className="w-full text-xs">
                <thead>
                  <tr className="border-b">
                    <th className="text-left py-2 px-2 text-[10px] uppercase text-muted-foreground w-[120px]">Equipment</th>
                    <th className="text-left py-2 px-2 text-[10px] uppercase text-muted-foreground">Make</th>
                    <th className="text-left py-2 px-2 text-[10px] uppercase text-muted-foreground">Model</th>
                  </tr>
                </thead>
                <tbody>
                  <tr className="border-b">
                    <td className="py-2 px-2 font-semibold">Solar Module</td>
                    <td className="py-2 px-2">
                      {(equipmentOptions?.moduleMakes?.length ?? 0) > 0 ? (
                        <Select value={selModuleMake || undefined} onValueChange={(v) => { setSelModuleMake(v); setSelModuleModel(""); }}>
                          <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select Make" /></SelectTrigger>
                          <SelectContent>{equipmentOptions!.moduleMakes.map(m => <SelectItem key={m.make} value={m.make}>{m.make}</SelectItem>)}</SelectContent>
                        </Select>
                      ) : <Input className="h-8 text-xs" placeholder="e.g. WAAREE" value={selModuleMake} onChange={e => setSelModuleMake(e.target.value)} />}
                    </td>
                    <td className="py-2 px-2">
                      {selModuleMake && (equipmentOptions?.moduleMakes?.find(m => m.make === selModuleMake)?.models?.length ?? 0) > 0 ? (
                        <Select value={selModuleModel || undefined} onValueChange={setSelModuleModel}>
                          <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select Model" /></SelectTrigger>
                          <SelectContent>{(equipmentOptions?.moduleMakes?.find(m => m.make === selModuleMake)?.models || []).map(m => <SelectItem key={m} value={m}>{m}</SelectItem>)}</SelectContent>
                        </Select>
                      ) : <Input className="h-8 text-xs" placeholder="Model" value={selModuleModel} onChange={e => setSelModuleModel(e.target.value)} />}
                    </td>
                  </tr>
                  <tr className="border-b">
                    <td className="py-2 px-2 font-semibold">Inverter</td>
                    <td className="py-2 px-2">
                      {(equipmentOptions?.inverterMakes?.length ?? 0) > 0 ? (
                        <Select value={selInvMake || undefined} onValueChange={(v) => { setSelInvMake(v); setSelInvModel(""); }}>
                          <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select Make" /></SelectTrigger>
                          <SelectContent>{equipmentOptions!.inverterMakes.map(m => <SelectItem key={m.make} value={m.make}>{m.make}</SelectItem>)}</SelectContent>
                        </Select>
                      ) : <Input className="h-8 text-xs" placeholder="e.g. GROWATT" value={selInvMake} onChange={e => setSelInvMake(e.target.value)} />}
                    </td>
                    <td className="py-2 px-2">
                      {selInvMake && (equipmentOptions?.inverterMakes?.find(m => m.make === selInvMake)?.models?.length ?? 0) > 0 ? (
                        <Select value={selInvModel || undefined} onValueChange={setSelInvModel}>
                          <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select Model" /></SelectTrigger>
                          <SelectContent>{(equipmentOptions?.inverterMakes?.find(m => m.make === selInvMake)?.models || []).map(m => <SelectItem key={m} value={m}>{m}</SelectItem>)}</SelectContent>
                        </Select>
                      ) : <Input className="h-8 text-xs" placeholder="Model" value={selInvModel} onChange={e => setSelInvModel(e.target.value)} />}
                    </td>
                  </tr>
                  <tr>
                    <td className="py-2 px-2 font-semibold">{withBattery ? "Battery" : <span className="text-muted-foreground">Battery (off)</span>}</td>
                    <td className="py-2 px-2">
                      {(equipmentOptions?.batteryMakes?.length ?? 0) > 0 ? (
                        <Select value={selBatMake || undefined} onValueChange={(v) => { setSelBatMake(v); setSelBatModel(""); }} disabled={!withBattery}>
                          <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select Make" /></SelectTrigger>
                          <SelectContent>{equipmentOptions!.batteryMakes.map(m => <SelectItem key={m.make} value={m.make}>{m.make}</SelectItem>)}</SelectContent>
                        </Select>
                      ) : <Input className="h-8 text-xs" placeholder="e.g. LIVGUARD" value={selBatMake} onChange={e => setSelBatMake(e.target.value)} disabled={!withBattery} />}
                    </td>
                    <td className="py-2 px-2">
                      {withBattery && selBatMake && (equipmentOptions?.batteryMakes?.find(m => m.make === selBatMake)?.models?.length ?? 0) > 0 ? (
                        <Select value={selBatModel || undefined} onValueChange={setSelBatModel}>
                          <SelectTrigger className="h-8 text-xs"><SelectValue placeholder="Select Model" /></SelectTrigger>
                          <SelectContent>{(equipmentOptions?.batteryMakes?.find(m => m.make === selBatMake)?.models || []).map(m => <SelectItem key={m} value={m}>{m}</SelectItem>)}</SelectContent>
                        </Select>
                      ) : <Input className="h-8 text-xs" placeholder="Model" value={selBatModel} onChange={e => setSelBatModel(e.target.value)} disabled={!withBattery} />}
                    </td>
                  </tr>
                </tbody>
              </table>
            </CardContent>
          </Card>

          {/* Itemized Rates */}
          <Card className="border-slate-300">
            <CardContent className="pt-4">
              <div className="flex items-center justify-between mb-3">
                <span className="text-sm text-muted-foreground italic">Itemized Per-kW Rates (Rs/kW) &mdash; inclusive of applicable GST</span>
                <div className="flex gap-2 items-center">
                  <Switch checked={useCustomRates} onCheckedChange={setUseCustomRates} />
                  <Label className="text-xs font-medium">{useCustomRates ? "Custom Active" : "Auto Rates"}</Label>
                </div>
              </div>
              <div className="grid grid-cols-6 gap-2 mb-2">
                {([["Solar Panels","panels"],["Inverter","inverter"],["Structure","structure"],["Wiring","wiring"],["Net Meter","netMeter"],["Transport","transport"]] as const).map(([label, key]) => (
                  <div key={key}>
                    <Label className="text-[10px] text-muted-foreground font-medium">{label}</Label>
                    <Input type="number" value={rates[key]} className="h-9 text-sm font-mono bg-background"
                      onChange={e => setRates(prev => ({ ...prev, [key]: parseInt(e.target.value) || 0 }))} />
                  </div>
                ))}
              </div>
              <div className="grid grid-cols-4 gap-2 mb-3">
                {([["Installation","installation"],["Misc","misc"],["Service 5yr","service"],["Contractor","contractor"]] as const).map(([label, key]) => (
                  <div key={key}>
                    <Label className="text-[10px] text-muted-foreground font-medium">{label}</Label>
                    <Input type="number" value={rates[key]} className="h-9 text-sm font-mono bg-background"
                      onChange={e => setRates(prev => ({ ...prev, [key]: parseInt(e.target.value) || 0 }))} />
                  </div>
                ))}
              </div>
              <div className="flex items-center justify-between">
                <div className="flex gap-2">
                  <Button variant={netMeterOn?"default":"outline"} size="sm" className={`h-7 text-xs ${netMeterOn?"bg-green-600 hover:bg-green-700":""}`}
                    onClick={()=>setNetMeterOn(!netMeterOn)}>Net Meter: {netMeterOn?"ON":"OFF"}</Button>
                  {useCustomRates && <Badge className="bg-green-600 text-[10px]">Rates Auto-Applied</Badge>}
                  <Button variant="outline" size="sm" className="h-7 text-xs"
                    onClick={()=>setRates({panels:30000,inverter:16000,structure:6000,wiring:6000,netMeter:1000,transport:2000,installation:3000,misc:3500,service:4000,contractor:3500})}>Reset to Default</Button>
                  {useCustomRates && <Badge variant="outline" className="text-[10px]">Rates Applied</Badge>}
                </div>
                <span className="text-sm text-muted-foreground font-mono">
                  Total: Rs {customRatePerKW.toLocaleString("en-IN")}/kW = Rs {(customRatePerKW * capacity).toLocaleString("en-IN")} ({capacity}kW)
                </span>
              </div>
            </CardContent>
          </Card>

          {/* Live Pricing - BOX FORMAT */}
          {calc && (
            <div className="grid grid-cols-4 gap-3">
              {[
                {l:"Plant Cost",v:formatINR(totalCost),sub:withBattery?"incl. battery":"excl. battery"},
                {l:`Down Payment (${downPaymentPct}%)`,v:formatINR(downPayment),c:"text-orange-600",sub:"advance"},
                ...(disc>0?[{l:"Discount",v:formatINR(disc),sub:"applied"}]:[] as any[]),
                {l:"Loan Amount",v:formatINR(loanAmount),c:"text-primary",bold:true,sub:"EMI financing"},
              ].map((x:any,i)=>(
                <div key={i} className={`rounded-xl p-4 text-center border-2 ${x.bold?"bg-primary/10 border-primary shadow-sm":"bg-muted/40 border-border"}`}>
                  <p className="text-[9px] text-muted-foreground uppercase font-bold tracking-wider mb-1">{x.l}</p>
                  <p className={`text-lg font-extrabold ${x.c||""}`}>{x.v}</p>
                  <p className="text-[9px] text-muted-foreground mt-1">{x.sub}</p>
                </div>
              ))}
            </div>
          )}

          {/* Down Payment, Discount, Validity, Panel Watt */}
          <div className="grid grid-cols-5 gap-3">
            <div><Label className="text-xs">Panel Watt</Label><Input type="number" value={panelWatt} onChange={e=>setPanelWatt(parseInt(e.target.value)||540)}/></div>
            <div><Label className="text-xs">Down Payment %</Label><Input type="number" value={downPaymentPct} onChange={e=>setDownPaymentPct(parseInt(e.target.value)||15)}/></div>
            <div><Label className="text-xs">Discount (\u20B9)</Label><Input type="number" value={discount} onChange={e=>setDiscount(e.target.value)} placeholder="0"/></div>
            <div><Label className="text-xs">Validity (Days)</Label><Input type="number" value={validity} onChange={e=>setValidity(e.target.value)}/></div>
            <div><Label className="text-xs">Notes</Label><Input value={notes} onChange={e=>setNotes(e.target.value)} placeholder="Extra notes..."/></div>
          </div>

          <Button onClick={()=>setView("preview")} className="w-full" size="lg">Preview & Download Quotation &rarr;</Button>
        </div>
      </DialogContent>
    </Dialog>
  );

  // ===== PREVIEW =====
  return (
    <Dialog open={open} onOpenChange={onClose}>
      <DialogContent className="max-w-4xl max-h-[95vh] overflow-y-auto p-0">
