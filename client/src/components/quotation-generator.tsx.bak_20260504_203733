import { FileText, Printer, X, Download, Building2, Shield } from "lucide-react";
import { formatINR } from "@/components/subsidy-calculator";
import type { SubsidyResult } from "@/components/subsidy-calculator";
import type { Customer } from "@shared/schema";

const BOM = [
  { item: "Mono Bifacial Solar Module (540Wp)", make: "WAAREE / ADANI" },
  { item: "Grid Tie / Hybrid Inverter", make: "SOLARYAAN / GROWATT" },
  { item: "G.I. Pipe Mounting Structure (60x40x2mm)", make: "HINDUSTAR" },
  { item: "DC Cable — 1C x 2.5 SQMM", make: "POLYCAB" },
  { item: "AC Cable — 1C x 2.5 SQMM", make: "POLYCAB" },
  { item: "PVC Conduit Pipes — 20mm", make: "POLYCAB" },
  { item: "Earthing Cable — 1C x 2.5 SQMM", make: "REPUTED" },
  { item: "Lightning Arrestor Cable — 1C x 16 SQMM", make: "REPUTED" },
  { item: "ACDB / DCDB — MCB & SPD", make: "L&T / HAVELLS & ELMEX" },
];

interface QuotationGeneratorProps {
  customer: Customer;
  subsidyInfo: SubsidyResult | null;
  open: boolean;
  onClose: () => void;
}

export function QuotationGenerator({ customer, subsidyInfo, open, onClose }: QuotationGeneratorProps) {
  const [view, setView] = useState<"config" | "preview">("config");
  const [discount, setDiscount] = useState("0");
  const [validity, setValidity] = useState("15");
  const [notes, setNotes] = useState("");
  const [roof, setRoof] = useState(customer.roofType || "RCC Flat Roof");
  const printRef = useRef<HTMLDivElement>(null);

  const capacity = parseFloat(customer.proposedCapacity || "0") || 0;
  const panels = Math.ceil(capacity * 1000 / 540);
  const totalCost = subsidyInfo?.totalCost || 0;
  const subsidyAmount = subsidyInfo?.totalSubsidy || 0;
  const netCost = subsidyInfo?.netCost || 0;
  const disc = parseInt(discount) || 0;
  const afterDisc = netCost - disc;
  const gst = Math.round(afterDisc * 0.18);
  const grand = afterDisc + gst;

  const invType = customer.inverterType === "ongrid" || customer.inverterType === "on-grid"
    ? `${capacity <= 3.5 ? "3.4" : capacity <= 5 ? "5" : capacity <= 6 ? "6" : "10"} KW On-Grid`
    : `${capacity <= 3.5 ? "3.4" : capacity <= 5 ? "5" : capacity <= 6 ? "6" : "10"} KW Hybrid`;

  const today = new Date();
  const fmtDate = today.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  const qn = `SXP/${today.getFullYear()}/${String(today.getMonth() + 1).padStart(2, "0")}${String(today.getDate()).padStart(2, "0")}/${Math.floor(Math.random() * 9000 + 1000)}`;

  const handlePrint = () => {
    const content = printRef.current;
    if (!content) return;
    const w = window.open("", "_blank");
    if (!w) return;
    w.document.write(`<!DOCTYPE html><html><head><title>Quotation - ${customer.name}</title>
      <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: system-ui, -apple-system, sans-serif; color: #222; background: #fff; }
        @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
      </style></head><body>${content.innerHTML}</body></html>`);
    w.document.close();
    setTimeout(() => { w.print(); }, 500);
  };

  if (!open) return null;

  // ===== CONFIG VIEW =====
  if (view === "config") return (
    <Dialog open={open} onOpenChange={onClose}>
      <DialogContent className="max-w-3xl max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <FileText className="w-5 h-5" />
            Generate Quotation — {customer.name}
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-4">
          {/* Customer Auto-populated */}
          <Card>
            <CardContent className="pt-4">
              <div className="flex items-center justify-between mb-2">
                <h3 className="font-semibold text-sm">Customer Details</h3>
                <Badge variant="secondary" className="text-xs">Auto-populated</Badge>
              </div>
              <div className="grid grid-cols-2 gap-2 text-sm text-muted-foreground">
                <div><strong className="text-foreground">{customer.name}</strong></div>
                <div>{customer.phone}</div>
                <div>{customer.email || "—"}</div>
                <div>{customer.address}, {customer.district}, {customer.state} - {customer.pincode}</div>
              </div>
            </CardContent>
          </Card>

          {/* Subsidy Rates from Calculator */}
          {subsidyInfo && (
            <Card className="border-green-200 bg-green-50/50 dark:bg-green-950/20">
              <CardContent className="pt-4">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="font-semibold text-sm text-green-800 dark:text-green-300">PM Surya Ghar — Subsidy Rates</h3>
                  <Badge className="bg-green-600 text-xs">From Calculator</Badge>
                </div>
                <div className="grid grid-cols-4 gap-3 text-center">
                  <div className="bg-white dark:bg-background rounded-lg p-3 border">
                    <p className="text-[10px] text-muted-foreground uppercase font-semibold">Capacity</p>
                    <p className="text-lg font-bold">{capacity} KW</p>
                    <p className="text-[10px] text-muted-foreground">{panels} panels</p>
                  </div>
                  <div className="bg-white dark:bg-background rounded-lg p-3 border">
                    <p className="text-[10px] text-muted-foreground uppercase font-semibold">System Cost</p>
                    <p className="text-lg font-bold">{formatINR(totalCost)}</p>
                  </div>
                  <div className="bg-white dark:bg-background rounded-lg p-3 border">
                    <p className="text-[10px] text-green-600 uppercase font-semibold">CFA Subsidy</p>
                    <p className="text-lg font-bold text-green-600">{formatINR(subsidyAmount)}</p>
                  </div>
                  <div className="bg-white dark:bg-background rounded-lg p-3 border">
                    <p className="text-[10px] text-muted-foreground uppercase font-semibold">After Subsidy</p>
                    <p className="text-lg font-bold text-primary">{formatINR(netCost)}</p>
