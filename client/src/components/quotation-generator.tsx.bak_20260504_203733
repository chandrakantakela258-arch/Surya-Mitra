                    <span style={{ fontSize: 12, fontWeight: r.b ? 700 : 500, color: "#444" }}>{r.l}</span>
                    <span style={{ fontSize: r.b ? 16 : 13, fontWeight: 800, color: r.g ? "#2E7D32" : r.hl ? "#0D47A1" : "#222" }}>{r.v}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Warranty */}
            <div style={{ marginBottom: 24 }}>
              <div style={{ fontSize: 9, fontWeight: 700, color: "#1565C0", letterSpacing: 1, marginBottom: 10 }}>WARRANTY & PERFORMANCE</div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 10, marginBottom: 10 }}>
                {[{ l: "Module Mfg.", v: "25 Years" }, { l: "Performance", v: "30 Years" }, { l: "Inverter", v: "10 Years" }].map((w, i) => (
                  <div key={i} style={{ background: "#F0F7FF", borderRadius: 8, padding: 12, textAlign: "center", border: "1px solid #D0E4F7" }}>
                    <div style={{ fontSize: 18, fontWeight: 800, color: "#1565C0" }}>{w.v}</div>
