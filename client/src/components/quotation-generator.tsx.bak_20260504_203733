                    <div key={i}>
                      <div style={{ fontSize: 8, color: "#999", fontWeight: 600 }}>{x.l}</div>
                      <div style={{ fontSize: 12, fontWeight: 700, marginTop: 1 }}>{x.v}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* BOM Table */}
            <div style={{ marginBottom: 24 }}>
              <div style={{ fontSize: 9, fontWeight: 700, color: "#1565C0", letterSpacing: 1, marginBottom: 10 }}>BILL OF MATERIALS</div>
              <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12 }}>
                <thead>
                  <tr style={{ background: "#F5F7FA" }}>
                    {["#", "Item Description", "Qty", "Make / Brand"].map((h, i) => (
                      <th key={i} style={{ padding: "8px 12px", textAlign: "left", fontWeight: 700, color: "#666", borderBottom: "2px solid #E2E5EA", fontSize: 10 }}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {BOM.map((b, i) => (
                    <tr key={i} style={{ background: i % 2 ? "#FAFBFC" : "#FFF" }}>
                      <td style={{ padding: "8px 12px", color: "#999", fontWeight: 600, borderBottom: "1px solid #F5F5F5" }}>{i + 1}</td>
                      <td style={{ padding: "8px 12px", fontWeight: 500, borderBottom: "1px solid #F5F5F5" }}>
                        {b.item}{i === 0 && <span style={{ color: "#999", marginLeft: 6, fontSize: 10 }}>({panels} nos.)</span>}
                      </td>
                      <td style={{ padding: "8px 12px", color: "#777", borderBottom: "1px solid #F5F5F5" }}>{i === 0 ? panels : i === 1 ? 1 : "As req."}</td>
                      <td style={{ padding: "8px 12px", fontWeight: 600, borderBottom: "1px solid #F5F5F5" }}>{b.make}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Pricing */}
            <div style={{ marginBottom: 24 }}>
              <div style={{ fontSize: 9, fontWeight: 700, color: "#1565C0", letterSpacing: 1, marginBottom: 10 }}>PRICING BREAKDOWN</div>
              <div style={{ maxWidth: 440 }}>
                {[
                  { l: "Total System Cost", v: formatINR(totalCost) },
                  { l: "PM Surya Ghar Subsidy", v: `– ${formatINR(subsidyAmount)}`, g: true },
                  ...(disc > 0 ? [{ l: "Discount", v: `– ${formatINR(disc)}`, g: true }] : []),
