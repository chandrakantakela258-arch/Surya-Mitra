                <div style={{ fontSize: 11, color: "#777", marginTop: 8 }}>Ref: <strong style={{ color: "#1565C0" }}>{qn}</strong></div>
                <div style={{ fontSize: 11, color: "#777", marginTop: 2 }}>Date: {fmtDate}</div>
                <div style={{ fontSize: 11, color: "#777", marginTop: 2 }}>Valid: {validity} days</div>
              </div>
            </div>

            {/* PM Surya Ghar Badge */}
            <div style={{ background: "#E8F5E9", padding: "8px 16px", borderRadius: 6, marginBottom: 20, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
