                  { l: "GST @ 18%", v: formatINR(gst) },
                  { l: "Grand Total Payable", v: formatINR(grand), b: true, hl: true },
                ].map((r: any, i) => (
                  <div key={i} style={{
                    display: "flex", justifyContent: "space-between", padding: r.b ? "10px 14px" : "7px 14px",
