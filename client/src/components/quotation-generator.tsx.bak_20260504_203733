                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
                  {[
                    { l: "Modules", v: `${panels} × 540Wp` },
                    { l: "Inverter", v: invType },
                    { l: "Roof", v: roof },
                    { l: "Phase", v: "Single Phase" },
                    { l: "Module Warranty", v: "25 Years" },
                    { l: "Performance", v: "30 Years" },
