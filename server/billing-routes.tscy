  app.post("/api/billing/stock/adjust", async (req: Request, res: Response) => {
    const client = await pool.connect();
    try {
      await client.query("BEGIN");
      const { product_id, quantity, notes, created_by } = req.body;
      await client.query("UPDATE billing_stock SET current_qty = current_qty + $1, updated_at = NOW() WHERE product_id = $2", [quantity, product_id]);
      await client.query(
        "INSERT INTO billing_stock_movements (product_id, movement_type, quantity, reference_type, notes, created_by) VALUES ($1, 'adjustment', $2, 'manual', $3, $4)",
        [product_id, quantity, notes||"Manual adjustment", created_by||null]
      );
      await client.query("COMMIT");
      res.json({ success: true });
    } catch (e: any) {
      await client.query("ROLLBACK");
      res.status(500).json({ error: e.message });
    } finally { client.release(); }
  });

  // ════════════════════════════════════════════════════════════════════════
  // PAYMENTS
  // ════════════════════════════════════════════════════════════════════════

  app.get("/api/billing/payments", async (req: Request, res: Response) => {
    try {
      const { rows } = await pool.query(`
        SELECT p.*,
          CASE WHEN p.party_type = 'customer' THEN c.name ELSE v.name END as party_name,
          i.invoice_no
        FROM billing_payments p
        LEFT JOIN customers c ON p.party_type = 'customer' AND c.id = p.party_id
        LEFT JOIN billing_vendors v ON p.party_type = 'vendor' AND v.id = p.party_id
        LEFT JOIN billing_invoices i ON i.id = p.invoice_id
        ORDER BY p.created_at DESC LIMIT 200
      `);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ════════════════════════════════════════════════════════════════════════
  // GST / GSTR-1
  // ════════════════════════════════════════════════════════════════════════

  app.get("/api/billing/gst/summary/:period", async (req: Request, res: Response) => {
    try {
      const { rows } = await pool.query(`
        SELECT record_type, COUNT(*) as count,
          SUM(taxable_value) as taxable, SUM(cgst) as cgst, SUM(sgst) as sgst, SUM(igst) as igst,
          SUM(invoice_value) as total_value
        FROM billing_gst_records
        WHERE filing_period = $1 AND gstr1_filed = FALSE
        GROUP BY record_type
        ORDER BY record_type
      `, [req.params.period]);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  app.get("/api/billing/gst/records/:period", async (req: Request, res: Response) => {
    try {
      const { type } = req.query;
      let query = "SELECT * FROM billing_gst_records WHERE filing_period = $1";
      const params: any[] = [req.params.period];
      if (type) { query += " AND record_type = $2"; params.push(type); }
      query += " ORDER BY invoice_date";
      const { rows } = await pool.query(query, params);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // GSTR-1 JSON export
  app.get("/api/billing/gst/export/:period", async (req: Request, res: Response) => {
    try {
      const period = req.params.period;
      const companyId = req.query.company_id || 1;

      const { rows: coRows } = await pool.query("SELECT gstin FROM billing_companies WHERE id = $1", [companyId]);
      const gstin = coRows[0]?.gstin || "";

      const { rows: records } = await pool.query(
        "SELECT * FROM billing_gst_records WHERE filing_period = $1 ORDER BY record_type, invoice_date", [period]
      );

      // HSN summary from line items of invoices in this period
      const { rows: hsnRows } = await pool.query(`
        SELECT li.hsn_code, li.description, li.unit,
          SUM(li.quantity) as total_qty, SUM(li.total_amount) as total_val,
          SUM(li.taxable_value) as taxable, SUM(li.cgst_amount) as cgst,
          SUM(li.sgst_amount) as sgst, SUM(li.igst_amount) as igst
        FROM billing_line_items li
        JOIN billing_invoices i ON i.id = li.parent_id AND li.parent_type = 'invoice'
        JOIN billing_gst_records g ON g.invoice_id = i.id AND g.filing_period = $1
        WHERE i.cancelled = FALSE
        GROUP BY li.hsn_code, li.description, li.unit
        ORDER BY li.hsn_code
      `, [period]);

      // Build GSTR-1 JSON structure
      const gstr1: any = { gstin, fp: period, b2b: [], b2cs: [], hsn: { data: [] } };

      // B2B
      const b2b = records.filter((r: any) => r.record_type === "B2B");
      const byGstin = new Map<string, any[]>();
      b2b.forEach((r: any) => {
        if (!byGstin.has(r.customer_gstin)) byGstin.set(r.customer_gstin, []);
        byGstin.get(r.customer_gstin)!.push(r);
      });
      gstr1.b2b = Array.from(byGstin.entries()).map(([ctin, invs]) => ({
        ctin,
        inv: invs.map((r: any) => ({
          inum: r.invoice_no,
          idt: new Date(r.invoice_date).toLocaleDateString("en-IN", { day: "2-digit", month: "2-digit", year: "numeric" }).replace(/\//g, "-"),
          val: parseFloat(r.invoice_value),
          pos: r.place_of_supply,
          rchrg: r.reverse_charge,
          inv_typ: "R",
          itms: [{ num: 1, itm_det: { txval: parseFloat(r.taxable_value), camt: parseFloat(r.cgst), samt: parseFloat(r.sgst), iamt: parseFloat(r.igst) } }]
        }))
      }));

      // B2CS
      const b2cs = records.filter((r: any) => r.record_type === "B2CS");
      gstr1.b2cs = b2cs.map((r: any) => ({
        sply_ty: parseFloat(r.igst) > 0 ? "INTER" : "INTRA",
        pos: r.place_of_supply, typ: "OE",
        txval: parseFloat(r.taxable_value),
        camt: parseFloat(r.cgst), samt: parseFloat(r.sgst), iamt: parseFloat(r.igst)
      }));

      // HSN
      gstr1.hsn.data = hsnRows.map((h: any, i: number) => ({
        num: i+1, hsn_sc: h.hsn_code, desc: h.description || "", uqc: h.unit === "Nos" ? "NOS" : h.unit,
        qty: parseFloat(h.total_qty), val: parseFloat(h.total_val), txval: parseFloat(h.taxable),
        camt: parseFloat(h.cgst), samt: parseFloat(h.sgst), iamt: parseFloat(h.igst), csamt: 0
      }));

      res.setHeader("Content-Type", "application/json");
      res.setHeader("Content-Disposition", `attachment; filename=GSTR1_${gstin}_${period}.json`);
      res.json(gstr1);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ════════════════════════════════════════════════════════════════════════
  // DASHBOARD STATS
  // ════════════════════════════════════════════════════════════════════════

  app.get("/api/billing/dashboard", async (_req: Request, res: Response) => {
    try {
      const thisMonth = new Date().toISOString().slice(0, 7); // YYYY-MM

      const [revenue, outstanding, invoiceCount, quotationCount, stockAlerts] = await Promise.all([
        pool.query("SELECT COALESCE(SUM(total_amount), 0) as total FROM billing_invoices WHERE cancelled = FALSE AND TO_CHAR(invoice_date, 'YYYY-MM') = $1", [thisMonth]),
        pool.query("SELECT COALESCE(SUM(balance_due), 0) as total FROM billing_invoices WHERE cancelled = FALSE AND balance_due > 0"),
        pool.query("SELECT COUNT(*) as count FROM billing_invoices WHERE cancelled = FALSE AND TO_CHAR(invoice_date, 'YYYY-MM') = $1", [thisMonth]),
        pool.query("SELECT COUNT(*) as count FROM billing_quotations WHERE status = 'draft' OR status = 'sent'"),
        pool.query("SELECT COUNT(*) as count FROM v_stock_status WHERE low_stock = TRUE"),
      ]);

      res.json({
        monthlyRevenue: parseFloat(revenue.rows[0].total),
        totalOutstanding: parseFloat(outstanding.rows[0].total),
        invoicesThisMonth: parseInt(invoiceCount.rows[0].count),
        pendingQuotations: parseInt(quotationCount.rows[0].count),
        lowStockAlerts: parseInt(stockAlerts.rows[0].count),
      });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });


  // ════════════════════════════════════════════════════════════════════════
  // COMPOSITE SOLAR EPC — 70% Goods (5%) + 30% Services (18%)
  // ════════════════════════════════════════════════════════════════════════

  app.post("/api/billing/epc-calculate", async (req: Request, res: Response) => {
    try {
      const { total_contract_value } = req.body;
      const cv = parseFloat(total_contract_value) || 0;
      const gv = Math.round(cv * 0.70 * 100) / 100;
      const sv = Math.round(cv * 0.30 * 100) / 100;
      const gg = Math.round(gv * 0.05 * 100) / 100;
      const sg = Math.round(sv * 0.18 * 100) / 100;
      const tg = Math.round((gg + sg) * 100) / 100;
      const ti = Math.round(cv + tg);
      res.json({
        contract_value: cv,
        goods: { value: gv, pct: 70, hsn: "85414011", gst_rate: 5, gst: gg },
        services: { value: sv, pct: 30, hsn: "99549", gst_rate: 18, gst: sg },
        total_gst: tg, total_invoice: ti,
        effective_rate: cv > 0 ? Math.round((tg / cv) * 10000) / 100 : 0,
        amount_in_words: amountInWords(ti),
      });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });


  // ═══════════════════════════════════════════════════════════
  // UPGRADE: Product Segments, Combos, PDF, Email, WhatsApp
  // ═══════════════════════════════════════════════════════════

  // GET /api/billing/products/segments — Products grouped by segment
  app.get("/api/billing/products/segments", async (req, res) => {
    try {
      const result = await pool.query(`
        SELECT id, name, description, category, default_sale_price as price, hsn_code, gst_rate, unit, subcategory, model_code, warranty,
               segment, sub_segment, is_combo, combo_items, specifications, sort_order
        FROM billing_products
        WHERE is_active != false
        ORDER BY segment, sort_order, name
      `);
      const segments: Record<string, any[]> = {};
      for (const row of result.rows) {
        const seg = row.segment || "General";
        if (!segments[seg]) segments[seg] = [];
        segments[seg].push(row);
      }
      res.json({ segments, total: result.rows.length });
    } catch (error: any) {
      console.error("Error fetching segments:", error);
      res.status(500).json({ error: error.message });
    }
  });

  // GET /api/billing/products/combos — Only combo/EPC packs
  app.get("/api/billing/products/combos", async (req, res) => {
    try {
      const result = await pool.query(`
        SELECT id, name, description, default_sale_price as price, hsn_code, gst_rate, unit, subcategory, model_code, warranty,
               segment, sub_segment, specifications
        FROM billing_products
        WHERE is_combo = true AND is_active != false
        ORDER BY sub_segment, sort_order, name
      `);
      const combos: Record<string, any[]> = {};
      for (const row of result.rows) {
        const sub = row.sub_segment || "General Combo";
        if (!combos[sub]) combos[sub] = [];
        combos[sub].push(row);
      }
      res.json({ combos, total: result.rows.length });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // GET /api/billing/customers/search?q=term — Customer auto-populate
  app.get("/api/billing/customers/search", async (req, res) => {
    try {
      const q = (req.query.q as string || "").trim();
      if (q.length < 2) return res.json({ customers: [] });
      const searchTerm = `%${q}%`;
      const result = await pool.query(`
        SELECT id, name, phone, email, address, district, state, pincode
        FROM customers
        WHERE name ILIKE $1 OR phone ILIKE $1 OR email ILIKE $1
        ORDER BY name LIMIT 10
      `, [searchTerm]);
      res.json({ customers: result.rows });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // GET /api/billing/quotations/:id/pdf — Generate quotation PDF
  app.get("/api/billing/quotations/:id/pdf", async (req, res) => {
    try {
      const { id } = req.params;
      const invResult = await pool.query(`
        SELECT i.*, c.name as company_name, c.gstin as company_gstin,
               c.address_line1 as company_address, c.city as company_city,
               c.state as company_state, c.state_code as company_state_code,
               c.pin as company_pin, c.phone as company_phone,
               c.email as company_email, c.website as company_website,
               c.bank_name, c.bank_account, c.bank_ifsc, c.bank_branch
        FROM billing_invoices i
        LEFT JOIN billing_companies c ON i.company_id = c.id
        WHERE i.id = $1
      `, [id]);
      if (invResult.rows.length === 0) return res.status(404).json({ error: "Not found" });
      const invoice = invResult.rows[0];
      const itemsResult = await pool.query(`
        SELECT li.*, p.hsn_code as product_hsn, p.segment
        FROM billing_invoice_items li
        LEFT JOIN billing_products p ON li.product_id = p.id
        WHERE li.invoice_id = $1 ORDER BY li.id
      `, [id]);
      const pdfHtml = generateQuotationPDF(invoice, itemsResult.rows);
      res.setHeader("Content-Type", "text/html");
      res.send(pdfHtml);
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // POST /api/billing/quotations/:id/send-email
  app.post("/api/billing/quotations/:id/send-email", async (req, res) => {
    try {
      const { id } = req.params;
      const { email } = req.body;
      if (!email) return res.status(400).json({ error: "Email required" });
      await pool.query(`
        UPDATE billing_invoices
        SET shared_via_email = true, email_sent_at = NOW(), recipient_email = $2
        WHERE id = $1
      `, [id, email]);
      res.json({ success: true, message: `Email tracked for ${email}` });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // POST /api/billing/quotations/:id/send-whatsapp
  app.post("/api/billing/quotations/:id/send-whatsapp", async (req, res) => {
    try {
      const { id } = req.params;
      const { phone } = req.body;
      if (!phone) return res.status(400).json({ error: "Phone required" });
      const invResult = await pool.query(
        `SELECT invoice_no, total_amount, customer_name FROM billing_invoices WHERE id = $1`, [id]
      );
      if (invResult.rows.length === 0) return res.status(404).json({ error: "Not found" });
      const inv = invResult.rows[0];
      await pool.query(`
        UPDATE billing_invoices
        SET shared_via_whatsapp = true, whatsapp_sent_at = NOW(), recipient_phone = $2
        WHERE id = $1
      `, [id, phone]);
      const cleanPhone = phone.replace(/[^0-9]/g, "");
      const waPhone = cleanPhone.startsWith("91") ? cleanPhone : `91${cleanPhone}`;
      const pdfUrl = `https://divyanshisolar.com/api/billing/quotations/${id}/pdf`;
      const waMessage = encodeURIComponent(
        `🌞 *Divyanshi Solar — Quotation*\n\nDear ${inv.customer_name},\n\nYour quotation *${inv.invoice_no}* is ready.\n💰 Total: ₹${Number(inv.total_amount).toLocaleString("en-IN")}\n\n📄 View: ${pdfUrl}\n\n📞 9801005212 | divyanshisolar.com`
      );
      res.json({
        success: true,
        whatsapp_url: `https://wa.me/${waPhone}?text=${waMessage}`,
        invoice_no: inv.invoice_no,
      });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });


  // ── GET /api/billing/documents/:id/pdf — Generic PDF for any billing doc ──
  app.get("/api/billing/documents/:id/pdf", async (req, res) => {
    // Redirect to existing quotation PDF route (works for all types)
    res.redirect(`/api/billing/quotations/${req.params.id}/pdf`);
  });

  // ── GET /api/billing/purchase-orders/:id/pdf — PO PDF ──
  app.get("/api/billing/purchase-orders/:id/pdf", async (req, res) => {
    try {
      const { id } = req.params;
      const poResult = await pool.query(`
        SELECT po.*, v.name as vendor_name, v.gstin as vendor_gstin, v.address as vendor_address,
               v.city as vendor_city, v.state as vendor_state, v.phone as vendor_phone, v.email as vendor_email,
               co.name as company_name, co.gstin as company_gstin, co.address_line1 as company_address,
               co.city as company_city, co.state as company_state, co.phone as company_phone, co.email as company_email
        FROM billing_purchase_orders po
        LEFT JOIN billing_vendors v ON v.id = po.vendor_id
        LEFT JOIN billing_companies co ON co.id = po.company_id
        WHERE po.id = $1
      `, [id]);
      if (poResult.rows.length === 0) return res.status(404).json({ error: "PO not found" });
      const po = poResult.rows[0];
      const itemsResult = await pool.query(`
        SELECT * FROM billing_line_items WHERE parent_type = 'purchase_order' AND parent_id = $1 ORDER BY sort_order
      `, [id]);
      const items = itemsResult.rows;
      const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${po.po_no}</title>
        <style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:sans-serif;background:#f3f4f6;color:#1f2937}
        .page{max-width:800px;margin:20px auto;background:#fff;padding:40px;box-shadow:0 2px 10px rgba(0,0,0,.1)}
        .header{display:flex;justify-content:space-between;border-bottom:3px solid #7c3aed;padding-bottom:16px;margin-bottom:24px}
        .title{font-size:22px;font-weight:700;color:#7c3aed}.info{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}
        .box{padding:12px;background:#f8fafc;border-radius:8px;border-left:4px solid #7c3aed;font-size:13px}
        .box h4{font-size:11px;text-transform:uppercase;color:#7c3aed;margin-bottom:6px}
        table{width:100%;border-collapse:collapse}th{background:#7c3aed;color:#fff;padding:8px;font-size:11px;text-transform:uppercase}
        td{padding:8px;border:1px solid #e5e7eb;font-size:12px}.total-row td{font-weight:700;background:#f3f0ff}
        .no-print{position:fixed;top:0;left:0;right:0;background:#7c3aed;padding:10px;text-align:center;z-index:100}
        .no-print button{padding:8px 20px;margin:0 8px;border:none;border-radius:6px;font-weight:600;cursor:pointer}
        @media print{.no-print{display:none}.page{margin:0;box-shadow:none}}</style></head><body>
        <div class="no-print"><button onclick="window.print()" style="background:#fbbf24;color:#1e293b">Print / Save PDF</button></div>
        <div class="page"><div class="header"><div><div class="title">PURCHASE ORDER</div>
        <p style="font-size:13px;margin-top:4px">${po.po_no}</p><p style="font-size:12px;color:#6b7280">Date: ${new Date(po.po_date).toLocaleDateString('en-IN')}</p>
        ${po.expected_delivery ? '<p style="font-size:12px;color:#6b7280">Delivery: ' + new Date(po.expected_delivery).toLocaleDateString('en-IN') + '</p>' : ''}</div>
        <div style="text-align:right"><div style="font-size:18px;font-weight:700;color:#1e293b">${po.company_name || 'Divyanshi Solar'}</div>
        <p style="font-size:11px;color:#6b7280">${po.company_address || ''}, ${po.company_city || 'Patna'}</p>
        <p style="font-size:11px;color:#6b7280">GSTIN: ${po.company_gstin || ''}</p>
        <p style="font-size:11px;color:#6b7280">${po.company_phone || '9801005212'} | ${po.company_email || ''}</p></div></div>
        <div class="info"><div class="box"><h4>Vendor / Supplier</h4><p><strong>${po.vendor_name || 'N/A'}</strong></p>
        <p>${po.vendor_address || ''} ${po.vendor_city || ''} ${po.vendor_state || ''}</p>
        <p>GSTIN: ${po.vendor_gstin || 'N/A'}</p><p>${po.vendor_phone || ''} ${po.vendor_email || ''}</p></div>
        <div class="box" style="border-left-color:#f59e0b"><h4>PO Summary</h4>
        <p>Subtotal: ₹${Number(po.taxable_amount || 0).toLocaleString('en-IN')}</p>
        <p>CGST: ₹${Number(po.cgst_total || 0).toLocaleString('en-IN')} | SGST: ₹${Number(po.sgst_total || 0).toLocaleString('en-IN')}</p>
        <p style="font-size:16px;font-weight:700;color:#7c3aed;margin-top:8px">Total: ₹${Number(po.total_amount || 0).toLocaleString('en-IN')}</p></div></div>
        <table><thead><tr><th>#</th><th>Product</th><th>HSN</th><th>Qty</th><th>Rate</th><th>Taxable</th><th>GST%</th><th>Total</th></tr></thead>
        <tbody>${items.map((it: any, i: number) => '<tr><td>' + (i+1) + '</td><td>' + (it.description||'') + '</td><td>' + (it.hsn_code||'') + '</td><td>' + it.quantity + ' ' + (it.unit||'') + '</td><td>₹' + Number(it.rate||0).toLocaleString('en-IN') + '</td><td>₹' + Number(it.taxable_value||0).toLocaleString('en-IN') + '</td><td>' + (it.gst_rate||0) + '%</td><td>₹' + Number(it.total_amount||0).toLocaleString('en-IN') + '</td></tr>').join('')}
        <tr class="total-row"><td colspan="5"></td><td>₹${Number(po.taxable_amount||0).toLocaleString('en-IN')}</td><td></td><td>₹${Number(po.total_amount||0).toLocaleString('en-IN')}</td></tr></tbody></table>
        ${po.notes ? '<p style="margin-top:16px;font-size:12px"><strong>Notes:</strong> ' + po.notes + '</p>' : ''}
        ${po.terms ? '<p style="margin-top:8px;font-size:12px"><strong>Terms:</strong> ' + po.terms + '</p>' : ''}
        <div style="margin-top:40px;text-align:right"><div style="border-top:1px solid #374151;width:200px;margin-left:auto;padding-top:8px;font-size:12px;color:#6b7280">Authorized Signatory</div></div>
        </div></body></html>`;
      res.setHeader("Content-Type", "text/html");
      res.send(html);
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // ── GET /api/billing/invoices/:id/pdf — Invoice PDF ──
  app.get("/api/billing/invoices/:id/pdf", async (req, res) => {
    // Redirect to existing quotation PDF route (works for invoices too)
    res.redirect("/api/billing/quotations/" + req.params.id + "/pdf");
  });

  // ── POST /api/billing/purchase-orders/:id/send-whatsapp ──
  app.post("/api/billing/purchase-orders/:id/send-whatsapp", async (req, res) => {
    try {
      const { phone } = req.body;
      if (!phone) return res.status(400).json({ error: "Phone required" });
      const { rows } = await pool.query("SELECT po_no, total_amount FROM billing_purchase_orders WHERE id = $1", [req.params.id]);
      if (!rows.length) return res.status(404).json({ error: "PO not found" });
      const po = rows[0];
      const clean = phone.replace(/[^0-9]/g, "");
      const wa = clean.startsWith("91") ? clean : "91" + clean;
      const url = "https://divyanshisolar.com/api/billing/purchase-orders/" + req.params.id + "/pdf";
      const msg = encodeURIComponent("*Purchase Order - Divyanshi Solar*\n\nPO: " + po.po_no + "\nTotal: ₹" + Number(po.total_amount).toLocaleString("en-IN") + "\n\nView: " + url + "\n\n9801005212");
      res.json({ success: true, whatsapp_url: "https://wa.me/" + wa + "?text=" + msg });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ── GET /api/billing/vendors/search — Vendor auto-populate ──
  app.get("/api/billing/vendors/search", async (req, res) => {
    try {
      const q = (req.query.q as string || "").trim();
      if (q.length < 2) return res.json({ vendors: [] });
      const { rows } = await pool.query(
        "SELECT * FROM billing_vendors WHERE name ILIKE $1 OR gstin ILIKE $1 OR phone ILIKE $1 ORDER BY name LIMIT 10",
        ["%" + q + "%"]
      );
      res.json({ vendors: rows });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });
  console.log("✓ Billing routes registered");
}
function generateQuotationPDF(invoice: any, items: any[]): string {
  const isIntraState = invoice.company_state_code === invoice.buyer_state_code;
  
  // Calculate totals
  let subtotal = 0;
  let totalCgst = 0;
  let totalSgst = 0;
  let totalIgst = 0;
  
  const itemRows = items.map((item, idx) => {
    const amount = Number(item.quantity) * Number(item.unit_price);
    const discount = Number(item.discount_amount || 0);
    const taxable = amount - discount;
    const gstRate = Number(item.gst_rate || 12);
    
    let cgst = 0, sgst = 0, igst = 0;
    if (isIntraState) {
      cgst = taxable * (gstRate / 2) / 100;
      sgst = taxable * (gstRate / 2) / 100;
    } else {
      igst = taxable * gstRate / 100;
    }
    
    subtotal += taxable;
    totalCgst += cgst;
    totalSgst += sgst;
    totalIgst += igst;
    
    return `
      <tr>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${idx + 1}</td>
        <td style="padding:8px;border:1px solid #d1d5db">
          <strong>${item.product_name || item.description}</strong>
          ${item.hsn_code ? `<br><small style="color:#6b7280">HSN: ${item.hsn_code}</small>` : ''}
          ${item.segment ? `<br><small style="color:#9ca3af">${item.segment}</small>` : ''}
        </td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${item.hsn_code || '-'}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${item.quantity} ${item.unit || 'Pcs'}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">₹${Number(item.unit_price).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">${discount > 0 ? '₹' + discount.toLocaleString('en-IN', {minimumFractionDigits: 2}) : '-'}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">₹${taxable.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${gstRate}%</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">₹${(cgst + sgst + igst).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
      </tr>
    `;
  }).join('');
  
  const totalTax = totalCgst + totalSgst + totalIgst;
  const grandTotal = subtotal + totalTax;
  
  // Amount in words
  const amountWords = numberToWordsINR(Math.round(grandTotal));
  
  const taxSummary = isIntraState ? `
    <tr><td style="padding:6px 12px;text-align:right" colspan="2">CGST</td><td style="padding:6px 12px;text-align:right">₹${totalCgst.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
    <tr><td style="padding:6px 12px;text-align:right" colspan="2">SGST</td><td style="padding:6px 12px;text-align:right">₹${totalSgst.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
  ` : `
    <tr><td style="padding:6px 12px;text-align:right" colspan="2">IGST</td><td style="padding:6px 12px;text-align:right">₹${totalIgst.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
  `;
  
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${invoice.invoice_no} — Divyanshi Solar</title>
  <style>
    @media print {
      body { margin: 0; padding: 0; }
      .no-print { display: none !important; }
      .page { box-shadow: none !important; margin: 0 !important; }
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f3f4f6; color: #1f2937; }
    .no-print { 
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: linear-gradient(135deg, #1e3a5f, #0f2544); padding: 12px 24px;
      display: flex; gap: 12px; align-items: center; justify-content: center;
    }
    .no-print button {
      padding: 10px 24px; border: none; border-radius: 8px; font-size: 14px;
      font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    .btn-print { background: #f59e0b; color: #1e3a5f; }
    .btn-download { background: #16a34a; color: white; }
    .btn-email { background: #3b82f6; color: white; }
    .btn-whatsapp { background: #25d366; color: white; }
    .page {
      max-width: 800px; margin: 70px auto 40px; background: white;
      box-shadow: 0 4px 24px rgba(0,0,0,0.1); padding: 40px;
    }
    table { width: 100%; border-collapse: collapse; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #1e3a5f; padding-bottom: 20px; }
    .company-name { font-size: 24px; font-weight: 700; color: #1e3a5f; }
    .doc-title { font-size: 20px; font-weight: 700; color: #f59e0b; text-align: right; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    .info-box { padding: 16px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #1e3a5f; }
    .info-box h4 { color: #1e3a5f; margin-bottom: 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }
    .info-box p { font-size: 13px; line-height: 1.6; color: #374151; }
    th { background: #1e3a5f; color: white; padding: 10px 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
    .totals-table { margin-left: auto; width: 300px; }
    .totals-table td { font-size: 14px; }
    .grand-total td { background: #1e3a5f; color: white; font-weight: 700; font-size: 16px; padding: 10px 12px !important; }
    .amount-words { background: #fef3c7; padding: 12px 16px; border-radius: 8px; margin: 16px 0; font-size: 13px; }
    .footer { margin-top: 30px; padding-top: 20px; border-top: 2px solid #e5e7eb; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .footer h4 { color: #1e3a5f; font-size: 12px; text-transform: uppercase; margin-bottom: 8px; }
    .footer p, .footer li { font-size: 12px; color: #6b7280; line-height: 1.6; }
    .signature-box { text-align: right; margin-top: 40px; }
    .signature-line { border-top: 1px solid #374151; width: 200px; margin-left: auto; padding-top: 8px; font-size: 12px; color: #6b7280; }
  </style>
</head>
<body>

  <div class="no-print">
    <button class="btn-print" onclick="window.print()">🖨️ Print / Save PDF</button>
    <button class="btn-email" onclick="sendEmail()">📧 Send Email</button>
    <button class="btn-whatsapp" onclick="sendWhatsApp()">💬 WhatsApp</button>
  </div>

  <div class="page">
    <div class="header">
      <div>
        <div class="company-name">🌞 ${invoice.company_name || 'Divyanshi Digital Services Pvt Ltd'}</div>
        <p style="font-size:12px;color:#6b7280;margin-top:4px">
          ${invoice.company_address || ''}, ${invoice.company_city || 'Patna'}, 
          ${invoice.company_state || 'Bihar'} - ${invoice.company_pin || '801109'}
        </p>
        <p style="font-size:12px;color:#6b7280">
          📞 ${invoice.company_phone || '9801005212'} | ✉️ ${invoice.company_email || 'info@divyanshisolar.in'}
        </p>
        <p style="font-size:12px;color:#6b7280">
          GSTIN: <strong>${invoice.company_gstin || '10AAGCD4586K1ZK'}</strong>
        </p>
      </div>
      <div style="text-align:right">
        <div class="doc-title">${invoice.invoice_type === 'quotation' ? 'QUOTATION' : 'TAX INVOICE'}</div>
        <p style="font-size:14px;font-weight:600;margin-top:8px">${invoice.invoice_no}</p>
        <p style="font-size:13px;color:#6b7280">Date: ${new Date(invoice.invoice_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</p>
        ${invoice.due_date ? `<p style="font-size:13px;color:#6b7280">Valid Until: ${new Date(invoice.due_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</p>` : ''}
      </div>
    </div>

    <div class="info-grid">
      <div class="info-box">
        <h4>Bill To</h4>
        <p>
          <strong>${invoice.customer_name || '-'}</strong><br>
          ${invoice.buyer_address || ''}<br>
          ${invoice.buyer_city || ''}, ${invoice.buyer_state || ''} - ${invoice.buyer_pin || ''}<br>
          ${invoice.buyer_gstin ? `GSTIN: ${invoice.buyer_gstin}` : ''}
          ${invoice.buyer_phone ? `<br>📞 ${invoice.buyer_phone}` : ''}
          ${invoice.buyer_email ? `<br>✉️ ${invoice.buyer_email}` : ''}
        </p>
      </div>
      <div class="info-box" style="border-left-color:#f59e0b">
        <h4>Ship To</h4>
        <p>
          <strong>${invoice.ship_to_name || invoice.customer_name || '-'}</strong><br>
          ${invoice.ship_to_address || invoice.buyer_address || ''}<br>
          ${invoice.ship_to_city || invoice.buyer_city || ''}, ${invoice.ship_to_state || invoice.buyer_state || ''}
        </p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width:40px">#</th>
          <th>Product / Description</th>
          <th style="width:70px">HSN</th>
          <th style="width:70px">Qty</th>
          <th style="width:90px">Rate</th>
          <th style="width:70px">Disc.</th>
          <th style="width:100px">Taxable</th>
          <th style="width:50px">GST%</th>
          <th style="width:90px">Tax</th>
        </tr>
      </thead>
      <tbody>
        ${itemRows}
      </tbody>
    </table>

    <div style="display:flex;justify-content:space-between;margin-top:20px">
      <div class="amount-words" style="flex:1;margin-right:20px">
        <strong>Amount in Words:</strong><br>
        ${amountWords}
      </div>
      <table class="totals-table">
        <tr><td style="padding:6px 12px;text-align:right" colspan="2">Subtotal</td><td style="padding:6px 12px;text-align:right;font-weight:600">₹${subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
        ${taxSummary}
        <tr class="grand-total">
          <td colspan="2" style="padding:10px 12px;text-align:right">GRAND TOTAL</td>
          <td style="padding:10px 12px;text-align:right">₹${grandTotal.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
        </tr>
      </table>
    </div>

    <div class="footer">
      <div>
        <h4>Terms & Conditions</h4>
        <ul style="padding-left:16px">
          <li>Payment due within 15 days of invoice date</li>
          <li>Prices are inclusive of GST as shown</li>
          <li>Warranty as per manufacturer terms</li>
          <li>Installation timeline: 7-15 working days after payment</li>
          <li>Subject to Bihar/applicable state jurisdiction</li>
        </ul>
      </div>
      <div>
        <h4>Bank Details</h4>
        <p>
          ${invoice.bank_name || 'Bank of India'}<br>
          A/C: ${invoice.bank_account || '-'}<br>
          IFSC: ${invoice.bank_ifsc || '-'}<br>
          Branch: ${invoice.bank_branch || '-'}
        </p>
        <div class="signature-box">
          <br><br>
          <div class="signature-line">Authorized Signatory</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function sendEmail() {
      const email = prompt("Enter customer email address:");
      if (!email) return;
      const subject = encodeURIComponent("Quotation ${invoice.invoice_no} — Divyanshi Solar");
      const body = encodeURIComponent(
        "Dear ${invoice.customer_name || 'Customer'},\\n\\n" +
        "Please find your quotation ${invoice.invoice_no} attached.\\n" +
        "Total Amount: ₹${grandTotal.toLocaleString('en-IN')}\\n\\n" +
        "View online: " + window.location.href + "\\n\\n" +
        "Thank you,\\nDivyanshi Solar\\n📞 9801005212"
      );
      window.open("mailto:" + email + "?subject=" + subject + "&body=" + body);
      
      // Track on server
      fetch("/api/billing/quotations/${id}/send-email", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });
    }
    
    function sendWhatsApp() {
      const phone = prompt("Enter customer WhatsApp number (with 91):");
      if (!phone) return;
      const cleanPhone = phone.replace(/[^0-9]/g, "");
      const waPhone = cleanPhone.startsWith("91") ? cleanPhone : "91" + cleanPhone;
      const msg = encodeURIComponent(
        "🌞 *Divyanshi Solar — Quotation*\\n\\n" +
        "Dear ${invoice.customer_name || 'Customer'},\\n\\n" +
        "Your quotation *${invoice.invoice_no}* is ready.\\n" +
        "💰 Total: ₹${grandTotal.toLocaleString('en-IN')}\\n\\n" +
        "📄 View: " + window.location.href + "\\n\\n" +
        "📞 9801005212 | divyanshisolar.com"
      );
      window.open("https://wa.me/" + waPhone + "?text=" + msg, "_blank");
      
      // Track on server
      fetch("/api/billing/quotations/${id}/send-whatsapp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone })
      });
    }
  </script>
</body>
</html>`;
}
function numberToWordsINR(num: number): string {
  if (num === 0) return "Zero Rupees Only";
  
  const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
    'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen',
    'Seventeen', 'Eighteen', 'Nineteen'];
  const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
  
  function convertGroup(n: number): string {
    if (n === 0) return '';
    if (n < 20) return ones[n];
    if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 ? ' ' + ones[n % 10] : '');
    return ones[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' and ' + convertGroup(n % 100) : '');
  }
  
  let result = '';
  if (num >= 10000000) { result += convertGroup(Math.floor(num / 10000000)) + ' Crore '; num %= 10000000; }
  if (num >= 100000) { result += convertGroup(Math.floor(num / 100000)) + ' Lakh '; num %= 100000; }
  if (num >= 1000) { result += convertGroup(Math.floor(num / 1000)) + ' Thousand '; num %= 1000; }
  if (num > 0) { result += convertGroup(num); }
  
  return result.trim() + ' Rupees Only';
}
