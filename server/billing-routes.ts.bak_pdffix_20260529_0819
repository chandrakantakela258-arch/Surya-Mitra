        const bfx = 46+Math.floor(i/2)*bf_col, bfy = y+8+(i%2)*30;
        doc.fillColor(MGY).fontSize(7).font("Helvetica").text(lbl,bfx,bfy);
        doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold").text(val,bfx,bfy+9);
      });
      y += 84;

      if (partnerName || partnerMobile) {
        doc.fillColor(BLUE).fontSize(8).font("Helvetica-Bold").text("DISTRICT PARTNER",40,y); y += 6;
        doc.fillColor(DGY).fontSize(8).font("Helvetica");
        if (partnerName)   { doc.text(`Name: ${partnerName}`,40,y);   y += 11; }
        if (partnerMobile) { doc.text(`Mobile: ${partnerMobile}`,40,y); y += 11; }
      }

      // ── PAGE 3: Terms ───────────────────────────────────────────────────────
      doc.addPage(); y = 40;
      doc.rect(40,y,W,24).fill(BLUE);
      doc.fillColor("white").fontSize(11).font("Helvetica-Bold")
        .text("TERMS & CONDITIONS",44,y+6,{width:W,align:"center"});
      y += 32;

      const terms = [
        { title:"MAKE", body:[
            `Solar Module: ${system.panelType} (${system.panelModel})`,
            `${plantLabel} Inverter: ${system.inverterCapacity} (${system.inverterModel})`,
            system.batteryQty > 0 ? `Battery: Lead Acid ${system.batterySpec} (${system.batteryModel})` : "",
            "DC Cable: Polycab 1C × 2.5 SQMM", "AC Cable: Polycab 1C × 2.5 SQMM",
            "Structure: Hot Dip Galvanized G.I. Pipe (60×40×2mm) — HINDUSTAR",
            "LA & Earthing: Copper / Reputed", "ACDB & DCDB: L&T / Havells",
            system.plantType !== "offgrid" ? "Net Meter: SECURE" : "",
          ].filter(Boolean).join("\n• ") },
        { title:"Payment Terms",     body:"100% Mobilization advance against Work Order (Structure, Module, Inverter, Other Items)." },
        { title:"Project Completion",body:"15-20 Days from date of Receipt Solar NOC of DISCOM & Commercially Clear order and Advance Payment." },
        { title:"Validity of Offer", body:"30 Days from the date of offer. After this period confirmation must be taken." },
        { title:"Client Scope", body:[
            "Cleaning of solar modules in client scope.",
            "Roof to be arranged and provided by the client.",
            "Electricity & Water to be provided by client during construction.",
            "Provide safe storage space for material.",
            "Provide Electricity supply to synchronize the inverter on commissioning.",
            "Provide connection space in LT panel to connect Inverter Output.",
            "Internet Connection to be provided by client for remote monitoring.",
          ].join("\n• ") },
        { title:"Transportation",    body:"All Transportation included of above BOM up to site of installation." },
        { title:"Net-Metering",      body: system.plantType==="offgrid" ? "Off-Grid system — net metering not required." : "All government DISCOM fees (File Charge, Demand, Testing, Electrical Inspector Report) in client scope." },
        { title:"Solar System Warranty", body:[
            "5 Year Complete System Warranty.",
            "Solar Module Performance Warranty: 30 Years.",
            `${plantLabel} Inverter Warranty: 8 Years (Manufacturer Terms & Conditions).`,
            "All rates inclusive of GST (Panels/Inverters/Batteries @ 5%, Others @ 18%).",
          ].join("\n• ") },
      ];

      terms.forEach((term, i) => {
        const bodyLines = term.body.split("\n");
        const bH = doc.heightOfString(term.body, { width:W-130, fontSize:7.5 });
        const rowH = Math.max(28, bH+14);
        if (y+rowH > 760) { doc.addPage(); y = 40; }
        doc.rect(40,y,W,rowH).fill(i%2===0?"white":LGRY).strokeColor("#cccccc").stroke();
        doc.rect(40,y,30,rowH).fill(BLUE);
        doc.fillColor("white").fontSize(9).font("Helvetica-Bold")
          .text(String(i+1),40,y+rowH/2-6,{width:30,align:"center"});
        doc.fillColor(BLUE).fontSize(8).font("Helvetica-Bold").text(term.title,75,y+6,{width:85});
        doc.fillColor(DGY).fontSize(7.5).font("Helvetica").text(bodyLines[0],162,y+6,{width:W-125});
        bodyLines.slice(1).forEach((ln,li) => doc.text(ln,162,y+18+li*11,{width:W-125}));
        y += rowH+2;
      });

      y += 18;
      if (y > 700) { doc.addPage(); y = 40; }
      doc.fillColor(DGY).fontSize(8).font("Helvetica")
        .text("Thanking you and assuring you of our very best & prompt attention at all times, we remain. Yours Faithfully",40,y,{width:W});
      y += 22;

      doc.rect(40,y,W/2-10,55).stroke();
      doc.rect(W/2+50,y,W/2-10,55).stroke();
      doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold")
        .text(`For, ${comp.name||"Solarixa Power"}`,46,y+6)
        .text("Authorised Signatory",46,y+46);
      doc.fillColor(MGY).fontSize(9).font("Helvetica").text("Customer Signature",W/2+56,y+46);

      doc.rect(40,790,W,1).fill("#cccccc");
      doc.fillColor(MGY).fontSize(6.5).font("Helvetica")
        .text(`${comp.name||""} | ${comp.website||""} | ${comp.phone||""} | GSTIN: ${comp.gstin||""}`,
          40,795,{width:W,align:"center"});

      doc.end();
    } catch (err: any) {
      console.error("Solar PDF error:", err);
      if (!res.headersSent) res.status(500).json({ error: err.message });
    }
  });

// ─── END OF PATCH ─────────────────────────────────────────────────────────────
}
