      doc.fillColor("white").fontSize(7).font("Helvetica-Bold").text("FROM", fx2+4, y+3, {width:hw2-8});
      doc.fillColor(DGY).fontSize(9).font("Helvetica-Bold").text(inv.company_name||"", fx2+4, y+16);
      doc.fillColor(MGY).fontSize(6.5).font("Helvetica");
      let fy3 = y+27;
      [inv.head_office||inv.company_address, inv.bihar_address||null,
