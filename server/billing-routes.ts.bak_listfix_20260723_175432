  // POST send reminder for grievance
  app.post("/api/grievance/:id/reminder", async (req: Request, res: Response) => {
    try {
      const { rows } = await pool.query("SELECT * FROM grievances WHERE id=$1", [req.params.id]);
      if (!rows.length) return res.status(404).json({ error: "Not found" });
      const g = rows[0];
      const daysSince = Math.floor((Date.now() - new Date(g.created_at).getTime()) / (1000*60*60*24));
      const org = g.bank_name || g.discom || g.vendor_name || "";
      const cat = g.grievance_type === "bank" ? "bank" : g.grievance_type === "discom" ? "discom" : g.grievance_type === "vendor" ? "vendor" : "nodal";
      const { rows: regRows } = await pool.query(
        `SELECT * FROM grievance_email_registry WHERE is_active=true AND category=$1 ORDER BY category`, [cat]
      );
      const matchedRows = org ? regRows.filter((r:any) =>
        r.org_name.toLowerCase().includes(org.toLowerCase()) ||
        org.toLowerCase().includes(r.org_name.toLowerCase())
      ) : regRows;

      const dateStr = new Date().toLocaleDateString("en-IN", {day:"2-digit",month:"long",year:"numeric"});
      const reminderNo = (g.reminder_count||0) + 1;

      // Escalation level based on reminder count
      const escalationLevel = reminderNo === 1 ? "Branch Level" : reminderNo === 2 ? "Zonal/Regional Level" : "Head Office / Grievance Redressal Officer";
      const escalationWarning = reminderNo >= 2 ?
        `\n\nPlease note that this is Reminder No. ${reminderNo}. If this grievance is not resolved within the next 7 days, we will be constrained to escalate this matter to:\n1. RBI Banking Ombudsman\n2. MNRE Grievance Portal\n3. CPGRAM (Centralized Public Grievance Redress and Monitoring System)\n4. PMO Grievance Portal\n5. Consumer Court / Legal Forum` :
        `\n\nThis is a reminder that the above grievance remains unresolved after ${daysSince} days. We request immediate action and a written response within 7 working days.`;

      // Fetch template from DB if available
      const { rows: tmplRows } = await pool.query(
        "SELECT * FROM grievance_reminder_templates WHERE category=$1 AND reminder_no=$2 AND is_active=true LIMIT 1",
        [cat, reminderNo]
      );
      const tmpl = tmplRows[0];

      const fillVars = (s: string) => s
        .replace(/{grievance_no}/g, g.grievance_no)
        .replace(/{applicant_name}/g, g.applicant_name||"")
        .replace(/{applicant_mobile}/g, g.applicant_mobile||"N/A")
        .replace(/{pmsg_application_id}/g, g.pmsg_application_id||"N/A")
        .replace(/{jansamarth_ref}/g, g.jansamarth_ref||"N/A")
        .replace(/{bank_name}/g, g.bank_name||"N/A")
        .replace(/{bank_branch}/g, g.bank_branch||"N/A")
          .replace(/{bank_ifsc}/g, g.bank_ifsc||"N/A")
          .replace(/{vendor_email}/g, g.vendor_email||"N/A")
          .replace(/{customer_bank_account}/g, g.customer_bank_account||"N/A")
          .replace(/{customer_bank_ifsc}/g, g.customer_bank_ifsc||"N/A")
          .replace(/{customer_bank_name}/g, g.customer_bank_name||"N/A")
        .replace(/{manager_name}/g, g.manager_name||"N/A")
        .replace(/{manager_mobile}/g, g.manager_mobile||"N/A")
        .replace(/{field_staff_name}/g, g.field_staff_name||"N/A")
        .replace(/{field_staff_mobile}/g, g.field_staff_mobile||"N/A")
        .replace(/{loan_amount}/g, g.loan_amount ? Number(g.loan_amount).toLocaleString("en-IN") : "N/A")
        .replace(/{plant_capacity}/g, g.plant_capacity||"N/A")
        .replace(/{delay_tenure}/g, g.delay_tenure||"N/A")
        .replace(/{discom}/g, g.discom||"N/A")
        .replace(/{vendor_name}/g, g.vendor_name||"N/A")
        .replace(/{address}/g, [g.address,g.block,g.district,g.state].filter(Boolean).join(", ")||"N/A")
        .replace(/{district}/g, g.district||"N/A")
        .replace(/{state}/g, g.state||"N/A")
        .replace(/{days_since}/g, String(daysSince))
        .replace(/{reminder_no}/g, String(reminderNo))
        .replace(/{date}/g, dateStr)
        .replace(/{filed_date}/g, new Date(g.created_at).toLocaleDateString("en-IN"))
        .replace(/{org_name}/g, org);

      const reminderSubject = tmpl ? fillVars(tmpl.subject) : `REMINDER ${reminderNo} — PM Surya Ghar Grievance — ${g.grievance_no} — ${g.applicant_name} — ${daysSince} Days Pending`;
      const reminderBody = tmpl ? fillVars(tmpl.body) : "REMINDER " + reminderNo;
      const trackPixel = `<img src="https://divyanshisolar.in/api/grievance/track/${g.grievance_no}/reminder" width="1" height="1" style="display:none" />`;
      const bodyHtml = `<pre style='font-family:Arial,sans-serif;font-size:14px;line-height:1.9;white-space:pre-wrap'>${reminderBody}</pre>${trackPixel}`;

      const permanentCC = ["chandrakant@divyanshisolar.in","chandrakant@divyanshisolar.com"];
      const emailsSent: string[] = [];

      for (const reg of matchedRows) {
        const toList = [reg.email, ...(reg.extra_to||"").split(",").map((e:string)=>e.trim())].filter(Boolean);
        const ccList = (reg.cc_emails||"").split(",").map((e:string)=>e.trim()).filter(Boolean);
        const allCC = [...new Set([...ccList, ...permanentCC])];
        try {
            await sendEmail({ to: toList.join(","), cc: allCC.join(","), subject: reminderSubject, htmlContent: bodyHtml, replyTo: g.applicant_email||undefined });
            emailsSent.push(...toList);
          } catch(err) { console.error("Reminder failed:", err); }
      }

      // Update reminder count
      await pool.query(
        "UPDATE grievances SET reminder_count=COALESCE(reminder_count,0)+1, last_reminder_at=NOW(), reminder_sent_to=$1 WHERE id=$2",
        [JSON.stringify(emailsSent), g.id]
      );

      res.json({ success: true, reminder_no: reminderNo, emails_sent: emailsSent.length, emails_sent_to: emailsSent, days_since: daysSince });
    } catch(e:any) { res.status(500).json({ error: e.message }); }
  });

