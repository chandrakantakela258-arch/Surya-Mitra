  // Edit a recorded payment — recalculates invoice amount_paid/balance_due/payment_status
  app.put("/api/billing/payments/:id", async (req: Request, res: Response) => {
    const client = await pool.connect();
    try {
      await client.query("BEGIN");
      const payId = parseInt(req.params.id);
      const p = req.body;

      const { rows: oldRows } = await client.query("SELECT * FROM billing_payments WHERE id = $1", [payId]);
      if (!oldRows.length) throw new Error("Payment not found");
      const oldPayment = oldRows[0];
      const invId = oldPayment.invoice_id;

      const newAmount = parseFloat(p.amount) || 0;

      await client.query(
        `UPDATE billing_payments SET amount = $1, payment_mode = $2, payment_date = $3, reference_no = $4, notes = $5
         WHERE id = $6`,
        [newAmount, p.payment_mode || oldPayment.payment_mode, p.payment_date || oldPayment.payment_date,
         p.reference_no ?? oldPayment.reference_no, p.notes ?? oldPayment.notes, payId]
      );

      if (invId) {
        const { rows: invRows } = await client.query("SELECT * FROM billing_invoices WHERE id = $1", [invId]);
        if (invRows.length) {
          const inv = invRows[0];
          const { rows: sumRows } = await client.query(
            "SELECT COALESCE(SUM(amount),0) as total_paid FROM billing_payments WHERE invoice_id = $1",
            [invId]
          );
          const newPaid = parseFloat(sumRows[0].total_paid) || 0;
          const newBalance = parseFloat(inv.total_amount) - newPaid;
          const newStatus = newBalance <= 0 ? "paid" : newPaid > 0 ? "partial" : "unpaid";
          await client.query(
            "UPDATE billing_invoices SET amount_paid = $1, balance_due = $2, payment_status = $3, updated_at = NOW() WHERE id = $4",
            [newPaid, Math.max(0, newBalance), newStatus, invId]
          );
        }
      }

      await client.query("COMMIT");
      res.json({ success: true });
    } catch (e: any) {
      await client.query("ROLLBACK");
      res.status(500).json({ error: e.message });
    } finally { client.release(); }
  });

