// ── GST Helpers ──────────────────────────────────────────────────────────────


const STATE_CODE_MAP: Record<string,string> = {
  "jammu and kashmir":"01","himachal pradesh":"02","punjab":"03","chandigarh":"04",
  "uttarakhand":"05","haryana":"06","delhi":"07","rajasthan":"08","uttar pradesh":"09",
  "bihar":"10","sikkim":"11","arunachal pradesh":"12","nagaland":"13","manipur":"14",
  "mizoram":"15","tripura":"16","meghalaya":"17","assam":"18","west bengal":"19",
  "jharkhand":"20","odisha":"21","chhattisgarh":"22","madhya pradesh":"23","gujarat":"24",
  "daman and diu":"25","dadra and nagar haveli":"26","maharashtra":"27","andhra pradesh":"37",
  "karnataka":"29","goa":"30","lakshadweep":"31","kerala":"32","tamil nadu":"33",
  "puducherry":"34","andaman and nicobar":"35","telangana":"36"
};
function resolveStateCode(code: string, stateName?: string): string {
  if (code && code !== "10" && code.length <= 2) return code;
  if (stateName) {
    const mapped = STATE_CODE_MAP[stateName.toLowerCase().trim()];
    if (mapped) return mapped;
  }
  return code || "10";
}

function isInterState(sellerStateCode: string, buyerStateCode: string): boolean {
  return sellerStateCode !== buyerStateCode;
}

function calcLineItem(item: any, sellerState: string, buyerState: string) {
  const gross = item.quantity * item.rate;
  const discAmt = Math.round((gross * (item.discount_percent || 0)) / 100 * 100) / 100;
  const taxable = Math.round((gross - discAmt) * 100) / 100;
  const inter = isInterState(sellerState, buyerState);

  const cgstRate = inter ? 0 : item.gst_rate / 2;
  const sgstRate = inter ? 0 : item.gst_rate / 2;
  const igstRate = inter ? item.gst_rate : 0;
  const cgstAmt = Math.round(taxable * cgstRate / 100 * 100) / 100;
  const sgstAmt = Math.round(taxable * sgstRate / 100 * 100) / 100;
  const igstAmt = Math.round(taxable * igstRate / 100 * 100) / 100;
  const cessAmt = Math.round(taxable * (item.cess_rate || 0) / 100 * 100) / 100;
  const total = Math.round((taxable + cgstAmt + sgstAmt + igstAmt + cessAmt) * 100) / 100;

  return {
    ...item,
    discount_amount: discAmt,
    taxable_value: taxable,
    cgst_rate: cgstRate, cgst_amount: cgstAmt,
    sgst_rate: sgstRate, sgst_amount: sgstAmt,
    igst_rate: igstRate, igst_amount: igstAmt,
    cess_amount: cessAmt,
    total_amount: total,
  };
}

// ── Amount in Words (INR) ────────────────────────────────────────────────────

const ONES = ["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine",
  "Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen",
  "Seventeen","Eighteen","Nineteen"];
const TENS = ["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];

function twoDigit(n: number): string {
  if (n < 20) return ONES[n];
  return TENS[Math.floor(n/10)] + (n%10 ? " " + ONES[n%10] : "");
}
function threeDigit(n: number): string {
  if (!n) return "";
  const h = Math.floor(n/100), r = n%100;
  let s = h ? ONES[h] + " Hundred" : "";
  if (r) s += (h ? " and " : "") + twoDigit(r);
  return s;
}
function amountInWords(amt: number): string {
  if (amt === 0) return "Zero Rupees Only";
  const r = Math.floor(Math.abs(amt));
  const cr = Math.floor(r/10000000);
  const lk = Math.floor((r%10000000)/100000);
  const th = Math.floor((r%100000)/1000);
  const hd = r%1000;
  let w = "";
  if (cr) w += threeDigit(cr) + " Crore ";
  if (lk) w += twoDigit(lk) + " Lakh ";
  if (th) w += twoDigit(th) + " Thousand ";
  if (hd) w += threeDigit(hd);
  return "Rupees " + w.trim() + " Only";
}

// ── Financial Year ───────────────────────────────────────────────────────────

function getFY(date = new Date()): string {
  const m = date.getMonth(), y = date.getFullYear() % 100;
  return m >= 3 ? `${String(y).padStart(2,"0")}${String(y+1).padStart(2,"0")}`
                : `${String(y-1).padStart(2,"0")}${String(y).padStart(2,"0")}`;
}

