  app.get("/api/billing/next-number/:companyId/:type", async (req: Request, res: Response) => {
    try {
      const { companyId, type } = req.params;
      const colMap: Record<string, string> = { invoice: "current_invoice_no", quotation: "current_quotation_no", po: "current_po_no" };
      const typeMap: Record<string, string> = { invoice: "INV", quotation: "QT", po: "PO" };
      const col = colMap[type];
      if (!col) return res.status(400).json({ error: "Invalid type" });

      const { rows } = await pool.query("SELECT invoice_prefix, current_fy, " + col + " FROM billing_companies WHERE id = $1", [companyId]);
      if (!rows.length) return res.status(404).json({ error: "Company not found" });

      const company = rows[0];
      const fy = getFY();
      let nextNo = (company[col] || 0) + 1;

      // Reset if FY changed
      if (company.current_fy !== fy) {
        nextNo = 1;
        await pool.query("UPDATE billing_companies SET current_fy = $1, " + col + " = 0 WHERE id = $2", [fy, companyId]);
      }

      const number = `${company.invoice_prefix}/${typeMap[type]}/${fy}/${String(nextNo).padStart(4, "0")}`;
      res.json({ number, nextNo, fy });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ════════════════════════════════════════════════════════════════════════
  // INVOICES
  // ════════════════════════════════════════════════════════════════════════

  // List invoices
  app.get("/api/billing/invoices", async (req: Request, res: Response) => {
    try {
      const { status, company_id, from_date, to_date, search, type } = req.query;
      let query = `
        SELECT i.*, bc.name as customer_name, c.plant_type as plant_type, bc.phone as customer_phone, bc.gstin as customer_gstin, co.name as company_name
        FROM billing_invoices i
        LEFT JOIN billing_customers bc ON bc.id = i.customer_id
        LEFT JOIN billing_companies co ON co.id = i.company_id
