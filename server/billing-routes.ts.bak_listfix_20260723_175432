       inv.customer_plant_capacity?`Plant Capacity: ${inv.customer_plant_capacity} kW`:null
      ].filter(Boolean).forEach(l=>{doc.text(l as string,M+4,cy3,{width:hw2-10,lineBreak:true});cy3+=9;});
      if(inv.customer_plant_type){doc.fillColor(DGY).fontSize(11).font("Helvetica-Bold").text(`Plant Type: ${inv.customer_plant_type}`,M+4,cy3+4,{width:hw2-10,lineBreak:true});doc.fillColor(MGY).fontSize(6.5).font("Helvetica");}

      // From
