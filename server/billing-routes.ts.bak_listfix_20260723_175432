  app.post("/api/billing/epc-calculate", async (req: Request, res: Response) => {
    try {
      const { total_contract_value } = req.body;
      const cv = parseFloat(total_contract_value) || 0;
      const gv = Math.round(cv * 0.70 * 100) / 100;
      const sv = Math.round(cv * 0.30 * 100) / 100;
      const gg = Math.round(gv * 0.05 * 100) / 100;
      const sg = Math.round(sv * 0.18 * 100) / 100;
      const tg = Math.round((gg + sg) * 100) / 100;
      const ti = Math.round(cv + tg);
      res.json({
        contract_value: cv,
        goods: { value: gv, pct: 70, hsn: "85414011", gst_rate: 5, gst: gg },
        services: { value: sv, pct: 30, hsn: "99549", gst_rate: 18, gst: sg },
        total_gst: tg, total_invoice: ti,
        effective_rate: cv > 0 ? Math.round((tg / cv) * 10000) / 100 : 0,
        amount_in_words: amountInWords(ti),
      });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });


