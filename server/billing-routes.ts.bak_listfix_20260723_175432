      doc.fillColor(MGY).fontSize(6.5).font("Helvetica");
      let cy3 = y+27;
      [inv.customer_address, [inv.customer_city,inv.customer_state].filter(Boolean).join(", "),
       `State: ${inv.customer_state||""} (${inv.customer_state_code||""})`,
       inv.customer_phone?`Phone: ${inv.customer_phone}`:null,
