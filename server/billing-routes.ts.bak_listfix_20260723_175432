  // ── GST Filing: Sales Summary (GSTR-1 / GSTR-3B) ────────────────────────
  app.get("/api/billing/gst-summary", async (req: Request, res: Response) => {
    try {
      const { month, year, company_id } = req.query;
      if (!month || !year) return res.status(400).json({ error: "month and year are required" });

      const params: any[] = [String(year), String(month).padStart(2, "0")];
      let companyFilter = "";
      if (company_id) { companyFilter = " AND i.company_id = $3"; params.push(company_id); }

      const { rows: salesRows } = await pool.query(`
        SELECT
          COUNT(*)::int AS count,
          COALESCE(SUM(i.taxable_amount),0) AS taxable,
          COALESCE(SUM(i.cgst_total),0) AS cgst,
          COALESCE(SUM(i.sgst_total),0) AS sgst,
          COALESCE(SUM(i.igst_total),0) AS igst,
          COALESCE(SUM(i.total_amount),0) AS total
        FROM billing_invoices i
        WHERE i.invoice_type != 'quotation' AND i.cancelled = false
          AND TO_CHAR(i.invoice_date, 'YYYY') = $1
          AND TO_CHAR(i.invoice_date, 'MM') = $2
          ${companyFilter}
      `, params);

      const { rows: rateRows } = await pool.query(`
        SELECT
          li.gst_rate,
          COUNT(DISTINCT i.id)::int AS count,
          COALESCE(SUM(li.taxable_value),0) AS taxable,
          COALESCE(SUM(li.cgst_amount),0) AS cgst,
          COALESCE(SUM(li.sgst_amount),0) AS sgst,
          COALESCE(SUM(li.igst_amount),0) AS igst
        FROM billing_line_items li
        JOIN billing_invoices i ON i.id = li.parent_id AND li.parent_type = 'invoice'
        WHERE i.invoice_type != 'quotation' AND i.cancelled = false
          AND TO_CHAR(i.invoice_date, 'YYYY') = $1
          AND TO_CHAR(i.invoice_date, 'MM') = $2
          ${companyFilter}
        GROUP BY li.gst_rate
        ORDER BY li.gst_rate
      `, params);

      // Purchases: best-effort, zeroed until billing_purchase_orders schema is wired in
      const purchases = { count: 0, taxable: 0, cgst: 0, sgst: 0, igst: 0, total: 0 };

      res.json({ sales: salesRows[0], purchases, gst_by_rate: rateRows });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ── GST Filing: HSN-wise Summary (GSTR-1 Table 12) ──────────────────────
  app.get("/api/billing/hsn-summary", async (req: Request, res: Response) => {
    try {
      const { month, year, company_id } = req.query;
      if (!month || !year) return res.status(400).json({ error: "month and year are required" });

      const params: any[] = [String(year), String(month).padStart(2, "0")];
      let companyFilter = "";
      if (company_id) { companyFilter = " AND i.company_id = $3"; params.push(company_id); }

      const { rows } = await pool.query(`
        SELECT
          li.hsn_code,
          MAX(li.description) AS description,
          MAX(li.unit) AS uqc,
          li.gst_rate,
          COALESCE(SUM(li.quantity),0) AS total_quantity,
          COALESCE(SUM(li.taxable_value),0) AS total_taxable_value,
          COALESCE(SUM(li.igst_amount),0) AS total_igst,
          COALESCE(SUM(li.cgst_amount),0) AS total_cgst,
          COALESCE(SUM(li.sgst_amount),0) AS total_sgst,
          COALESCE(SUM(li.cess_amount),0) AS total_cess
        FROM billing_line_items li
        JOIN billing_invoices i ON i.id = li.parent_id AND li.parent_type = 'invoice'
        WHERE i.invoice_type != 'quotation' AND i.cancelled = false
          AND li.hsn_code IS NOT NULL AND li.hsn_code != ''
          AND TO_CHAR(i.invoice_date, 'YYYY') = $1
          AND TO_CHAR(i.invoice_date, 'MM') = $2
          ${companyFilter}
        GROUP BY li.hsn_code, li.gst_rate
        ORDER BY li.hsn_code
      `, params);

      res.json({ month, year, rows });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
