      const params: any[] = [];
      let idx = 1;

      if (status && status !== "all") { query += ` AND i.payment_status = $${idx++}`; params.push(status); }
      if (company_id) { query += ` AND i.company_id = $${idx++}`; params.push(company_id); }
      if (from_date) { query += ` AND i.invoice_date >= $${idx++}`; params.push(from_date); }
      if (to_date) { query += ` AND i.invoice_date <= $${idx++}`; params.push(to_date); }
      if (search) { query += ` AND (i.invoice_no ILIKE $${idx} OR bc.name ILIKE $${idx})`; params.push(`%${search}%`); idx++; }

      query += " ORDER BY i.created_at DESC LIMIT 200";
      const { rows } = await pool.query(query, params);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

