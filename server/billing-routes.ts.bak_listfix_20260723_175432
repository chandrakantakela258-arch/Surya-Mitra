      // ── INVOICE META (single row) ──
      doc.rect(M, y, W, 26).fill(LGRY).stroke(BDR);
      const meta = [
        [isQuotation ? "Quotation No" : "Invoice No", inv.invoice_no||""],
        ["Rev. Charge", "No"],
        [isQuotation ? "Quotation Date" : "Invoice Date", dateStr],
