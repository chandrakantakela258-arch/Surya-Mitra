  // ════════════════════════════════════════════════════════════════════════
  // PAYMENTS
  // ════════════════════════════════════════════════════════════════════════

  app.get("/api/billing/payments", async (req: Request, res: Response) => {
    try {
      const { rows } = await pool.query(`
        SELECT p.*,
          CASE WHEN p.party_type = 'customer' THEN c.name ELSE v.name END as party_name,
          i.invoice_no
        FROM billing_payments p
        LEFT JOIN customers c ON p.party_type = 'customer' AND c.id = p.party_id
        LEFT JOIN billing_vendors v ON p.party_type = 'vendor' AND v.id = p.party_id
        LEFT JOIN billing_invoices i ON i.id = p.invoice_id
        ORDER BY p.created_at DESC LIMIT 200
      `);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ════════════════════════════════════════════════════════════════════════
  // GST / GSTR-1
  // ════════════════════════════════════════════════════════════════════════

  app.get("/api/billing/gst/summary/:period", async (req: Request, res: Response) => {
    try {
      const { rows } = await pool.query(`
        SELECT record_type, COUNT(*) as count,
          SUM(taxable_value) as taxable, SUM(cgst) as cgst, SUM(sgst) as sgst, SUM(igst) as igst,
          SUM(invoice_value) as total_value
        FROM billing_gst_records
        WHERE filing_period = $1 AND gstr1_filed = FALSE
        GROUP BY record_type
        ORDER BY record_type
      `, [req.params.period]);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  app.get("/api/billing/gst/records/:period", async (req: Request, res: Response) => {
    try {
      const { type } = req.query;
      let query = "SELECT * FROM billing_gst_records WHERE filing_period = $1";
      const params: any[] = [req.params.period];
      if (type) { query += " AND record_type = $2"; params.push(type); }
      query += " ORDER BY invoice_date";
      const { rows } = await pool.query(query, params);
      res.json(rows);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // GSTR-1 JSON export
  app.get("/api/billing/gst/export/:period", async (req: Request, res: Response) => {
    try {
      const period = req.params.period;
      const companyId = req.query.company_id || 1;

      const { rows: coRows } = await pool.query("SELECT gstin FROM billing_companies WHERE id = $1", [companyId]);
      const gstin = coRows[0]?.gstin || "";

      const { rows: records } = await pool.query(
        "SELECT * FROM billing_gst_records WHERE filing_period = $1 ORDER BY record_type, invoice_date", [period]
      );

      // HSN summary from line items of invoices in this period
      const { rows: hsnRows } = await pool.query(`
        SELECT li.hsn_code, li.description, li.unit,
          SUM(li.quantity) as total_qty, SUM(li.total_amount) as total_val,
          SUM(li.taxable_value) as taxable, SUM(li.cgst_amount) as cgst,
          SUM(li.sgst_amount) as sgst, SUM(li.igst_amount) as igst
        FROM billing_line_items li
        JOIN billing_invoices i ON i.id = li.parent_id AND li.parent_type = 'invoice'
        JOIN billing_gst_records g ON g.invoice_id = i.id AND g.filing_period = $1
        WHERE i.cancelled = FALSE
        GROUP BY li.hsn_code, li.description, li.unit
        ORDER BY li.hsn_code
      `, [period]);

      // Build GSTR-1 JSON structure
      const gstr1: any = { gstin, fp: period, b2b: [], b2cs: [], hsn: { data: [] } };

      // B2B
      const b2b = records.filter((r: any) => r.record_type === "B2B");
      const byGstin = new Map<string, any[]>();
      b2b.forEach((r: any) => {
        if (!byGstin.has(r.customer_gstin)) byGstin.set(r.customer_gstin, []);
        byGstin.get(r.customer_gstin)!.push(r);
      });
      gstr1.b2b = Array.from(byGstin.entries()).map(([ctin, invs]) => ({
        ctin,
        inv: invs.map((r: any) => ({
          inum: r.invoice_no,
          idt: new Date(r.invoice_date).toLocaleDateString("en-IN", { day: "2-digit", month: "2-digit", year: "numeric" }).replace(/\//g, "-"),
          val: parseFloat(r.invoice_value),
          pos: r.place_of_supply,
          rchrg: r.reverse_charge,
          inv_typ: "R",
          itms: [{ num: 1, itm_det: { txval: parseFloat(r.taxable_value), camt: parseFloat(r.cgst), samt: parseFloat(r.sgst), iamt: parseFloat(r.igst) } }]
        }))
      }));

      // B2CS
      const b2cs = records.filter((r: any) => r.record_type === "B2CS");
      gstr1.b2cs = b2cs.map((r: any) => ({
        sply_ty: parseFloat(r.igst) > 0 ? "INTER" : "INTRA",
        pos: r.place_of_supply, typ: "OE",
        txval: parseFloat(r.taxable_value),
        camt: parseFloat(r.cgst), samt: parseFloat(r.sgst), iamt: parseFloat(r.igst)
      }));

      // HSN
      gstr1.hsn.data = hsnRows.map((h: any, i: number) => ({
        num: i+1, hsn_sc: h.hsn_code, desc: h.description || "", uqc: h.unit === "Nos" ? "NOS" : h.unit,
        qty: parseFloat(h.total_qty), val: parseFloat(h.total_val), txval: parseFloat(h.taxable),
        camt: parseFloat(h.cgst), samt: parseFloat(h.sgst), iamt: parseFloat(h.igst), csamt: 0
      }));

      res.setHeader("Content-Type", "application/json");
      res.setHeader("Content-Disposition", `attachment; filename=GSTR1_${gstin}_${period}.json`);
      res.json(gstr1);
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ════════════════════════════════════════════════════════════════════════
  // DASHBOARD STATS
  // ════════════════════════════════════════════════════════════════════════

  app.get("/api/billing/dashboard", async (_req: Request, res: Response) => {
    try {
      const thisMonth = new Date().toISOString().slice(0, 7); // YYYY-MM

      const [revenue, outstanding, invoiceCount, quotationCount, stockAlerts] = await Promise.all([
        pool.query("SELECT COALESCE(SUM(total_amount), 0) as total FROM billing_invoices WHERE cancelled = FALSE AND invoice_type != 'quotation' AND TO_CHAR(invoice_date, 'YYYY-MM') = $1", [thisMonth]),
        pool.query("SELECT COALESCE(SUM(balance_due), 0) as total FROM billing_invoices WHERE cancelled = FALSE AND invoice_type != 'quotation' AND balance_due > 0"),
        pool.query("SELECT COUNT(*) as count FROM billing_invoices WHERE cancelled = FALSE AND invoice_type != 'quotation' AND TO_CHAR(invoice_date, 'YYYY-MM') = $1", [thisMonth]),
        pool.query("SELECT COUNT(*) as count FROM billing_quotations WHERE status = 'draft' OR status = 'sent'"),
        pool.query("SELECT COUNT(*) as count FROM v_stock_status WHERE low_stock = TRUE"),
      ]);

      res.json({
        monthlyRevenue: parseFloat(revenue.rows[0].total),
        totalOutstanding: parseFloat(outstanding.rows[0].total),
        invoicesThisMonth: parseInt(invoiceCount.rows[0].count),
        pendingQuotations: parseInt(quotationCount.rows[0].count),
        lowStockAlerts: parseInt(stockAlerts.rows[0].count),
      });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });


  // ════════════════════════════════════════════════════════════════════════
  // COMPOSITE SOLAR EPC — 70% Goods (5%) + 30% Services (18%)
  // ════════════════════════════════════════════════════════════════════════

  app.post("/api/billing/epc-calculate", async (req: Request, res: Response) => {
    try {
      const { total_contract_value } = req.body;
      const cv = parseFloat(total_contract_value) || 0;
      const gv = Math.round(cv * 0.70 * 100) / 100;
      const sv = Math.round(cv * 0.30 * 100) / 100;
      const gg = Math.round(gv * 0.05 * 100) / 100;
      const sg = Math.round(sv * 0.18 * 100) / 100;
      const tg = Math.round((gg + sg) * 100) / 100;
      const ti = Math.round(cv + tg);
      res.json({
        contract_value: cv,
        goods: { value: gv, pct: 70, hsn: "85414011", gst_rate: 5, gst: gg },
        services: { value: sv, pct: 30, hsn: "99549", gst_rate: 18, gst: sg },
        total_gst: tg, total_invoice: ti,
        effective_rate: cv > 0 ? Math.round((tg / cv) * 10000) / 100 : 0,
        amount_in_words: amountInWords(ti),
      });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });


  // ═══════════════════════════════════════════════════════════
  // UPGRADE: Product Segments, Combos, PDF, Email, WhatsApp
  // ═══════════════════════════════════════════════════════════

  // GET /api/billing/products/segments — Products grouped by segment
  app.get("/api/billing/products/segments", async (req, res) => {
    try {
      const result = await pool.query(`
        SELECT id, name, description, category, default_sale_price as price, hsn_code, gst_rate, unit, subcategory, model_code, warranty,
               segment, sub_segment, is_combo, combo_items, specifications, sort_order
        FROM billing_products
        WHERE is_active != false
        ORDER BY segment, sort_order, name
      `);
      const segments: Record<string, any[]> = {};
      for (const row of result.rows) {
        const seg = row.segment || "General";
        if (!segments[seg]) segments[seg] = [];
        segments[seg].push(row);
      }
      res.json({ segments, total: result.rows.length });
    } catch (error: any) {
      console.error("Error fetching segments:", error);
      res.status(500).json({ error: error.message });
    }
  });

  // GET /api/billing/products/combos — Only combo/EPC packs
  app.get("/api/billing/products/combos", async (req, res) => {
    try {
      const result = await pool.query(`
        SELECT id, name, description, default_sale_price as price, hsn_code, gst_rate, unit, subcategory, model_code, warranty,
               segment, sub_segment, specifications
        FROM billing_products
        WHERE is_combo = true AND is_active != false
        ORDER BY sub_segment, sort_order, name
      `);
      const combos: Record<string, any[]> = {};
      for (const row of result.rows) {
        const sub = row.sub_segment || "General Combo";
        if (!combos[sub]) combos[sub] = [];
        combos[sub].push(row);
      }
      res.json({ combos, total: result.rows.length });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // GET /api/billing/customers/search?q=term — Customer auto-populate
  app.get("/api/billing/customers/search", async (req, res) => {
    try {
      const q = (req.query.q as string || "").trim();
      if (q.length < 2) return res.json({ customers: [] });
      const searchTerm = `%${q}%`;
      const result = await pool.query(`
        SELECT id, name, phone, email, address, city as district, state, pin as pincode, state_code, gstin, consumer_number, plant_capacity, panel_spec, inverter_spec, battery_spec, customer_type, 'billing' as source
        FROM billing_customers
        WHERE name ILIKE $1 OR phone ILIKE $1 OR email ILIKE $1
        ORDER BY name LIMIT 15
      `, [searchTerm]);
      res.json({ customers: result.rows });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });


  app.get("/api/billing/quotations/:id/pdf", async (req, res) => {
    try {
      const PDFDoc = PDFDocument;

      const { id } = req.params;
      const invResult = await pool.query(`
        SELECT i.*,
               c.name as company_name, c.gstin as company_gstin,
               c.address_line1 as company_address, c.city as company_city,
               c.state as company_state, c.phone as company_phone,
               c.email as company_email, c.website as company_website,
               c.cin as company_cin,
               c.bank_account_name, c.bank_name, c.bank_account as bank_account_number,
               c.bank_ifsc, c.bank_branch, c.bank_account_type,
               c.head_office, c.bihar_address
        FROM billing_invoices i
        LEFT JOIN billing_companies c ON i.company_id = c.id
        WHERE i.id = $1
      `, [id]);
      if (!invResult.rows.length) return res.status(404).json({ error: "Not found" });
      const inv = invResult.rows[0];

      const itemsResult = await pool.query(`
        SELECT li.*, p.segment, p.sub_segment, p.specifications
        FROM billing_invoice_items li
        LEFT JOIN billing_products p ON li.product_id = p.id
        WHERE li.invoice_id = $1 ORDER BY li.id
      `, [id]);
      const lineItems = itemsResult.rows;

      // ── Totals ──
      const isIntra = (inv.company_state_code || "10") === (inv.buyer_state_code || "10");
      let subtotal = 0, totalTax = 0;
      lineItems.forEach((it: any) => {
        const taxable = Number(it.quantity) * Number(it.unit_price) - Number(it.discount_amount || 0);
        const tax = taxable * Number(it.gst_rate || 12) / 100;
        subtotal += taxable; totalTax += tax;
      });
      const grandTotal = subtotal + totalTax;
      const downPmt    = Math.round(grandTotal * 0.25);
      const loanAmt    = grandTotal - downPmt;

      const dateStr = new Date(inv.invoice_date || Date.now())
        .toLocaleDateString("en-IN", { day:"2-digit", month:"long", year:"numeric" });
      const custName = inv.customer_name || "Customer";
      const compName = inv.company_name  || "Divyanshi Solar";

      // ── Detect if solar quotation (has solar_system_specs or solar product items) ──
      const solarSpecs = inv.solar_system_specs;
      const isSolar = !!solarSpecs || lineItems.some((it: any) =>
        (it.segment || "").toLowerCase().includes("solar") ||
        (it.segment || "").toLowerCase().includes("kit") ||
        (it.segment || "").toLowerCase().includes("hybrid") ||
        (it.segment || "").toLowerCase().includes("off-grid") ||
        (it.segment || "").toLowerCase().includes("on-grid")
      );

      res.setHeader("Content-Type", "application/pdf");
      res.setHeader("Content-Disposition",
        `inline; filename="Quotation_${custName.replace(/\s+/g,"_")}_${inv.invoice_no}.pdf"`);

      const doc = new PDFDoc({ size:"A4", margins:{ top:40, bottom:40, left:40, right:40 } });
      doc.pipe(res);

      const W=515, BLUE="#1a3a6b", ORG="#e07b2a", GRN="#2e7d32";
      const LGRY="#f5f5f5", DGY="#333333", MGY="#666666";

      // ════════════════════════════════════════════════════
      // PAGE 1 — Header, Customer, Items, Totals
      // ════════════════════════════════════════════════════

      // Blue header
      doc.rect(40,40,W,62).fill(BLUE);
      // Gold accent line for Divyanshi
      if (isDivyanshiCo) doc.rect(40,40,W,4).fill(ORG);
      doc.fillColor("white").fontSize(13).font("Helvetica-Bold").text(compName,50,50);
      doc.fillColor("#aac4ff").fontSize(7).font("Helvetica");
      const hLines = [
        inv.company_cin ? `CIN: ${inv.company_cin} | GSTIN: ${inv.company_gstin||""}` : `GSTIN: ${inv.company_gstin||""}`,
        inv.head_office || inv.company_address || "",
        inv.bihar_address || "",
        `Web: ${inv.company_website||"divyanshisolar.in"} | Ph: ${inv.company_phone||"9801005212"}`,
      ].filter(Boolean);
      hLines.forEach((ln,i) => doc.text(ln,50,65+i*10));

      // QUOTATION title
      doc.fillColor(ORG).fontSize(22).font("Helvetica-Bold")
        .text("QUOTATION",330,48,{width:220,align:"right"});
      doc.rect(375,72,180,30).fillAndStroke("#f0f4ff","#99aacc");
      doc.fillColor(DGY).fontSize(7).font("Helvetica-Bold")
        .text(`Ref: ${inv.invoice_no}`,380,76)
        .text(`Date: ${dateStr}`,380,85)
        .text(`Valid: ${inv.valid_days||30} days`,380,94);

      let y=112;
      if (isSolar) {
        doc.rect(40,y,W,18).fill("#e8f4e8");
        doc.fillColor(GRN).fontSize(8).font("Helvetica-Bold")
          .text("✓ National Vendor — PM Surya Ghar: Muft Bijli Yojana",44,y+4,{width:W,align:"center"});
        y+=26;
      } else { y+=10; }

      // Customer + System boxes
      const colW=(W-8)/2;

      // Customer box
      doc.rect(40,y,colW,isSolar?98:80).fillAndStroke("#f8f9ff","#ccccdd");
      doc.fillColor(MGY).fontSize(7).font("Helvetica-Bold").text("PREPARED FOR",46,y+5);
      doc.fillColor(BLUE).fontSize(12).font("Helvetica-Bold").text(custName,46,y+15);
      doc.fillColor(DGY).fontSize(7.5).font("Helvetica");
      let cy=y+32;
      [inv.customer_address, [inv.customer_city,inv.customer_state,inv.customer_pin].filter(Boolean).join(", "),
       inv.customer_phone?`Phone: ${inv.customer_phone}`:"",
       inv.customer_email?`Email: ${inv.customer_email}`:"",
       inv.consumer_no?`Consumer No: ${inv.consumer_no}`:"",
      ].filter(Boolean).forEach(ln=>{ doc.text(ln as string,46,cy,{width:colW-12}); cy+=11; });

      // System specs box (solar) or quotation meta box
      const sx=40+colW+8;
      if (isSolar && solarSpecs) {
        doc.rect(sx,y,colW,98).fillAndStroke("#f0f8f0","#aaccaa");
        doc.fillColor(GRN).fontSize(9).font("Helvetica-Bold")
          .text(`SYSTEM: ${solarSpecs.capacityKw||3} KW ${solarSpecs.plantType==="offgrid"?"Off-Grid":solarSpecs.plantType==="ongrid"?"On-Grid":"Hybrid"} Solar Plant`,sx+6,y+6,{width:colW-12});
        const sp=(lbl:string,val:string,row:number)=>{
          const px=sx+6+(row%2)*(colW/2),py=y+22+Math.floor(row/2)*22;
          doc.fillColor(MGY).fontSize(7).font("Helvetica").text(lbl,px,py);
          doc.fillColor(DGY).fontSize(8).font("Helvetica-Bold").text(val,px,py+9,{width:colW/2-4});
        };
        sp("Modules",`${solarSpecs.moduleCount||6} × ${solarSpecs.modulePower||580}Wp`,0);
        sp("Panel",solarSpecs.panelType||"DCR TopCon Bifacial",1);
        sp("Inverter",solarSpecs.inverterCapacity||"Hybrid Inverter",2);
        sp("Type","Residential",3);
        if (solarSpecs.batteryQty>0){
          sp("Battery","Lead Acid",4);
          sp("Down Pmt",`${downPmt.toLocaleString("en-IN")}`,5);
        }
      } else {
        doc.rect(sx,y,colW,isSolar?98:80).fillAndStroke("#fffbf0","#e5c97a");
        doc.fillColor(ORG).fontSize(9).font("Helvetica-Bold").text("QUOTATION DETAILS",sx+6,y+6);
        doc.fillColor(DGY).fontSize(8).font("Helvetica");
        doc.text(`Invoice No: ${inv.invoice_no}`,sx+6,y+22);
        doc.text(`Date: ${dateStr}`,sx+6,y+34);
        doc.text(`Valid: ${inv.valid_days||30} days`,sx+6,y+46);
        doc.fillColor(BLUE).fontSize(11).font("Helvetica-Bold")
          .text(`Total: ₹${grandTotal.toLocaleString("en-IN")}`,sx+6,y+60);
      }
      y += (isSolar?108:90);

      // ── Solar itemized table OR standard line items table ──
      const itemizedCosts = inv.solar_itemized_costs;

      if (isSolar && itemizedCosts) {
        // Solar itemized GST breakdown
        doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold")
          .text("ITEMIZED COST BREAKDOWN (RATES INCLUSIVE OF GST)",40,y);
        y+=10;
        doc.rect(40,y,W,17).fill(BLUE);
        doc.fillColor("white").fontSize(7).font("Helvetica-Bold");
        doc.text("#",42,y+4,{width:18}); doc.text("ITEM",60,y+4,{width:170});
        doc.text("BASE AMT",228,y+4,{width:70,align:"right"});
        doc.text("GST%",300,y+4,{width:38,align:"center"});
        doc.text("GST AMT",340,y+4,{width:68,align:"right"});
        doc.text("INCL. TOTAL",408,y+4,{width:100,align:"right"});
        y+=17;

        const costMap: Array<{label:string;key:string;gst:number}> = [
          {label:"Solar Panels",             key:"solarPanels",      gst:5},
          {label:"Inverter",                 key:"inverter",         gst:5},
          {label:"Battery",                  key:"battery",          gst:5},
          {label:"Module Mounting Structure",key:"structure",        gst:18},
          {label:"Cables & Wiring",          key:"cablesWiring",     gst:18},
          {label:"Net Meter",                key:"netMeter",         gst:18},
          {label:"Transport",                key:"transport",        gst:18},
          {label:"Installation",             key:"installation",     gst:18},
          {label:"Misc & Accessories",       key:"miscAccessories",  gst:18},
          {label:"Service Charge (5yr)",     key:"serviceCharge5yr", gst:18},
          {label:"Contractor Profit",        key:"contractorProfit", gst:18},
        ];
        let rowNum=0, tBase=0, tGst=0, tIncl=0;
        costMap.forEach((c,i)=>{
          const incl=Number(itemizedCosts[c.key]||0);
          if(!incl) return;
          const base=Math.round(incl/(1+c.gst/100));
          const gst=incl-base;
          tBase+=base; tGst+=gst; tIncl+=incl; rowNum++;
          doc.rect(40,y,W,15).fill(rowNum%2===0?LGRY:"white");
          doc.fillColor(DGY).fontSize(7.5).font("Helvetica");
          doc.text(String(rowNum),42,y+3,{width:18}); doc.text(c.label,60,y+3,{width:170});
          doc.text(base.toLocaleString("en-IN"),228,y+3,{width:70,align:"right"});
          doc.fillColor(c.gst===5?GRN:ORG).font("Helvetica-Bold")
            .text(`${c.gst}%`,300,y+3,{width:38,align:"center"});
          doc.fillColor(DGY).font("Helvetica")
            .text(gst.toLocaleString("en-IN"),340,y+3,{width:68,align:"right"});
          doc.font("Helvetica-Bold")
            .text(incl.toLocaleString("en-IN"),408,y+3,{width:100,align:"right"});
          y+=15;
        });
        // Total row
        doc.rect(40,y,W,18).fill(BLUE);
        doc.fillColor("white").fontSize(8).font("Helvetica-Bold");
        doc.text("TOTAL",60,y+4,{width:200});
        doc.text(tBase.toLocaleString("en-IN"),228,y+4,{width:70,align:"right"});
        doc.text(tGst.toLocaleString("en-IN"),340,y+4,{width:68,align:"right"});
        doc.text(tIncl.toLocaleString("en-IN"),408,y+4,{width:100,align:"right"});
        y+=22;
        doc.fillColor(MGY).fontSize(6.5).font("Helvetica-Oblique")
          .text("GST: Panels/Inverters/Batteries @ 5% | Structure/Cables/Accessories/Service/Contractor @ 18% • All rates inclusive of GST",40,y,{width:W});
        y+=14;

        // Pricing summary
        doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold").text("PRICING SUMMARY",40,y); y+=8;
        const bw=(W-20)/3;
        [{l:"PLANT COST",s:"incl. battery",v:`₹ ${tIncl.toLocaleString("en-IN")}`,c:BLUE},
         {l:"DOWN PAYMENT (25%)",s:"advance payment",v:`₹ ${Math.round(tIncl*0.25).toLocaleString("en-IN")}`,c:ORG},
         {l:"LOAN AMOUNT",s:"EMI financing",v:`₹ ${Math.round(tIncl*0.75).toLocaleString("en-IN")}`,c:GRN}
        ].forEach((s,i)=>{
          const bx=40+i*(bw+10);
          doc.rect(bx,y,bw,52).fillAndStroke("#f0f4ff",s.c);
          doc.fillColor(s.c).fontSize(7).font("Helvetica-Bold").text(s.l,bx+4,y+5,{width:bw-8,align:"center"});
          doc.fontSize(12).font("Helvetica-Bold").text(s.v,bx+4,y+17,{width:bw-8,align:"center"});
          doc.fillColor(MGY).fontSize(7).font("Helvetica").text(s.s,bx+4,y+34,{width:bw-8,align:"center"});
        });

      } else {
        // Standard line items table
        doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold").text("ITEMS",40,y); y+=10;
        doc.rect(40,y,W,16).fill(BLUE);
        doc.fillColor("white").fontSize(7).font("Helvetica-Bold");
        doc.text("#",42,y+4,{width:18}); doc.text("PRODUCT / DESCRIPTION",60,y+4,{width:200});
        doc.text("QTY",262,y+4,{width:40,align:"center"}); doc.text("RATE",304,y+4,{width:60,align:"right"});
        doc.text("TAXABLE",366,y+4,{width:60,align:"right"}); doc.text("GST%",428,y+4,{width:30,align:"center"});
        doc.text("TOTAL",460,y+4,{width:95,align:"right"});
        y+=16;
        lineItems.forEach((it:any,i:number)=>{
          if(y>720){doc.addPage();y=40;}
          const taxable=Number(it.quantity)*Number(it.unit_price)-Number(it.discount_amount||0);
          const tax=taxable*Number(it.gst_rate||12)/100;
          const total=taxable+tax;
          const rH=it.segment?22:16;
          doc.rect(40,y,W,rH).fill(i%2===0?"white":LGRY);
          doc.fillColor(DGY).fontSize(7.5).font("Helvetica");
          doc.text(String(i+1),42,y+3,{width:18});
          doc.font("Helvetica-Bold").text(it.product_name||it.description||"",60,y+3,{width:200});
          if(it.segment) doc.fillColor(MGY).fontSize(6.5).font("Helvetica").text(it.segment,60,y+13,{width:200});
          doc.fillColor(DGY).fontSize(7.5).font("Helvetica")
            .text(`${it.quantity} ${it.unit||"Pcs"}`,262,y+3,{width:40,align:"center"})
            .text(Number(it.unit_price).toLocaleString("en-IN"),304,y+3,{width:60,align:"right"})
            .text(taxable.toLocaleString("en-IN",{maximumFractionDigits:0}),366,y+3,{width:60,align:"right"})
            .text(`${it.gst_rate||12}%`,428,y+3,{width:30,align:"center"});
          doc.font("Helvetica-Bold")
            .text(total.toLocaleString("en-IN",{maximumFractionDigits:0}),460,y+3,{width:95,align:"right"});
          y+=rH;
        });
        // Totals
        doc.rect(40,y,W,16).fill(LGRY);
        doc.fillColor(DGY).fontSize(8).font("Helvetica").text("Subtotal",60,y+3,{width:350});
        doc.text(subtotal.toLocaleString("en-IN",{maximumFractionDigits:0}),460,y+3,{width:95,align:"right"});
        y+=16;
        if(isIntra){
          const half=totalTax/2;
          [{l:"CGST",v:half},{l:"SGST",v:half}].forEach(r=>{
            doc.rect(40,y,W,14).fill("white");
            doc.fillColor(MGY).fontSize(7.5).font("Helvetica").text(r.l,60,y+3);
            doc.text(r.v.toLocaleString("en-IN",{maximumFractionDigits:0}),460,y+3,{width:95,align:"right"});
            y+=14;
          });
        } else {
          doc.rect(40,y,W,14).fill("white");
          doc.fillColor(MGY).fontSize(7.5).font("Helvetica").text("IGST",60,y+3);
          doc.text(totalTax.toLocaleString("en-IN",{maximumFractionDigits:0}),460,y+3,{width:95,align:"right"});
          y+=14;
        }
        doc.rect(40,y,W,20).fill(BLUE);
        doc.fillColor("white").fontSize(9).font("Helvetica-Bold").text("GRAND TOTAL",60,y+5);
        doc.text(`₹ ${grandTotal.toLocaleString("en-IN",{maximumFractionDigits:0})}`,460,y+5,{width:95,align:"right"});
        y+=20;
        if(inv.notes){
          y+=8;
          doc.fillColor(DGY).fontSize(8).font("Helvetica").text(`Notes: ${inv.notes}`,40,y,{width:W});
          y+=14;
        }
      }

      // ════════════════════════════════════════════════════
      // PAGE 2 — BOM + Warranty + Bank Details
      // ════════════════════════════════════════════════════
      doc.addPage(); y=40;

      doc.rect(40,y,W,20).fill(BLUE);
      doc.fillColor("white").fontSize(10).font("Helvetica-Bold").text("BILL OF MATERIALS (BOM)",44,y+5);
      y+=20;

      // BOM table header
      doc.rect(40,y,W,16).fill("#ddeeff");
      doc.fillColor(BLUE).fontSize(7).font("Helvetica-Bold");
      doc.text("#",42,y+4,{width:18}); doc.text("MODEL / CODE",60,y+4,{width:110});
      doc.text("DESCRIPTION",172,y+4,{width:175}); doc.text("CATEGORY",349,y+4,{width:70});
      doc.text("QTY",420,y+4,{width:40,align:"center"}); doc.text("MAKE / BRAND",462,y+4,{width:90});
      y+=16;

      // Build BOM from solar specs or from line items
      let bomItems: Array<{model:string;desc:string;cat:string;qty:string;brand:string}> = [];

      if (isSolar && solarSpecs) {
        bomItems = [
          {model:solarSpecs.panelModel||"",          desc:`${solarSpecs.modulePower||580}Wp ${solarSpecs.panelType||""} Solar Panel — 12yr Mfg. Warranty, 30yr Performance`, cat:"Module",      qty:`${solarSpecs.moduleCount||6} Nos`, brand:"Livguard Solar"},
          {model:solarSpecs.inverterModel||"",        desc:`${solarSpecs.inverterCapacity||""} — 8yr Warranty`,                                                               cat:"Inverter",    qty:"1 Nos",                           brand:"Livguard"},
          ...(Number(solarSpecs.batteryQty)>0?[{model:solarSpecs.batteryModel||"",desc:`${solarSpecs.batterySpec||""} Lead Acid Battery`,cat:"Battery",qty:`${solarSpecs.batteryQty} Nos`,brand:"Livguard"}]:[]),
          {model:"GI-MMS-60402",  desc:"G.I. Pipe Mounting Structure (60×40×2mm) + Accessories",                     cat:"Structure",   qty:"As req.", brand:"HINDUSTAR"},
          {model:"DC-POLYCAB-2.5",desc:"DC Cable — 1C × 2.5 SQMM",                                                  cat:"Cables",      qty:"As req.", brand:"POLYCAB"},
          {model:"AC-POLYCAB-2.5",desc:"AC Cable — 1C × 2.5 SQMM",                                                  cat:"Cables",      qty:"As req.", brand:"POLYCAB"},
          {model:"PVC-CONDUIT-20",desc:"PVC Conduit Pipes — 20mm",                                                   cat:"Cables",      qty:"As req.", brand:"POLYCAB"},
          {model:"EARTH-LA-KIT",  desc:"Earthing & Lightning Arrestor — Earth Rod + Chamber + Chemical + Cable",     cat:"Earthing",    qty:"As req.", brand:"COPPER / REPUTED"},
          {model:"ACDB-DCDB-SPD", desc:"ACDB / DCDB — MCB & SPD",                                                   cat:"Jn. Box",     qty:"As req.", brand:"L&T / HAVELLS"},
          ...(solarSpecs.plantType!=="offgrid"?[{model:"NETMETER-SECURE",desc:"Net Energy Meter (Solar)",cat:"Net Meter",qty:"1 Nos",brand:"SECURE"}]:[]),
        ];
      } else {
        // Build BOM from line items
        lineItems.forEach((it:any)=>{
          bomItems.push({
            model: it.hsn_code||"—",
            desc:  it.product_name||it.description||"",
            cat:   it.segment||"Product",
            qty:   `${it.quantity} ${it.unit||"Pcs"}`,
            brand: "Livguard",
          });
        });
        // Always add standard BOM items for solar
        if (isSolar) {
          bomItems.push(
            {model:"GI-MMS-60402",  desc:"G.I. Pipe Mounting Structure (60×40×2mm) + Accessories",                 cat:"Structure",qty:"As req.",brand:"HINDUSTAR"},
            {model:"DC-POLYCAB-2.5",desc:"DC Cable — 1C × 2.5 SQMM",                                              cat:"Cables",   qty:"As req.",brand:"POLYCAB"},
            {model:"AC-POLYCAB-2.5",desc:"AC Cable — 1C × 2.5 SQMM",                                              cat:"Cables",   qty:"As req.",brand:"POLYCAB"},
            {model:"PVC-CONDUIT-20",desc:"PVC Conduit Pipes — 20mm",                                               cat:"Cables",   qty:"As req.",brand:"POLYCAB"},
            {model:"EARTH-LA-KIT",  desc:"Earthing & Lightning Arrestor",                                          cat:"Earthing", qty:"As req.",brand:"COPPER / REPUTED"},
            {model:"ACDB-DCDB-SPD", desc:"ACDB / DCDB — MCB & SPD",                                               cat:"Jn. Box",  qty:"As req.",brand:"L&T / HAVELLS"},
            {model:"NETMETER-SECURE",desc:"Net Energy Meter (Solar)",                                              cat:"Net Meter",qty:"1 Nos",  brand:"SECURE"}
          );
        }
      }

      bomItems.forEach((row,i)=>{
        if(y>740){doc.addPage();y=40;}
        doc.rect(40,y,W,18).fill(i%2===0?"white":LGRY);
        doc.fillColor(MGY).fontSize(7).font("Helvetica").text(String(i+1),42,y+4,{width:18});
        doc.fillColor("#2563eb").font("Helvetica-Bold").text(row.model,60,y+4,{width:110});
        doc.fillColor(DGY).font("Helvetica").text(row.desc,172,y+4,{width:175});
        doc.fillColor(MGY).text(row.cat,349,y+4,{width:70});
        doc.fillColor(DGY).font("Helvetica-Bold").text(row.qty,420,y+4,{width:40,align:"center"});
        doc.fillColor(MGY).font("Helvetica").text(row.brand,462,y+4,{width:90});
        y+=18;
      });
      y+=12;

      // Warranty boxes
      if(y>700){doc.addPage();y=40;}
      doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold").text("WARRANTY & PERFORMANCE",40,y); y+=8;
      const ww=(W-30)/4;
      [{l:"25 Years",s:"Module Mfg."},{l:"30 Years",s:"Performance"},{l:"8 Years",s:"Inverter"},{l:"5 Years",s:"Complete System"}]
        .forEach((w,i)=>{
          const wx=40+i*(ww+10);
          doc.rect(wx,y,ww,38).fillAndStroke("#e8f4e8",GRN);
          doc.fillColor(GRN).fontSize(13).font("Helvetica-Bold").text(w.l,wx+4,y+5,{width:ww-8,align:"center"});
          doc.fillColor(MGY).fontSize(7.5).font("Helvetica").text(w.s,wx+4,y+24,{width:ww-8,align:"center"});
        });
      y+=52;

      // Bank details
      doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold").text("BANK ACCOUNT DETAILS",40,y); y+=8;
      doc.rect(40,y,W,72).fillAndStroke("#f8f9ff",BLUE);
      const bf_col=W/3;
      [["Account Name", inv.bank_account_name||inv.company_name||compName],
       ["Bank",         inv.bank_name||"—"],
       ["A/c No.",      inv.bank_account_number||inv.bank_account||"—"],
       ["IFSC",         inv.bank_ifsc||"—"],
       ["Branch",       inv.bank_branch||"—"],
       ["Account Type", inv.bank_account_type||"Current Account"]
      ].forEach(([lbl,val],i)=>{
        const bfx=46+Math.floor(i/2)*bf_col, bfy=y+8+(i%2)*30;
        doc.fillColor(MGY).fontSize(7).font("Helvetica").text(lbl,bfx,bfy);
        doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold").text(val,bfx,bfy+9);
      });

      // ════════════════════════════════════════════════════
      // PAGE 3 — Terms & Conditions
      // ════════════════════════════════════════════════════
      doc.addPage(); y=40;

      doc.rect(40,y,W,24).fill(BLUE);
      doc.fillColor("white").fontSize(11).font("Helvetica-Bold")
        .text("TERMS & CONDITIONS",44,y+6,{width:W,align:"center"});
      y+=32;

      const plantLabel = solarSpecs?.plantType==="offgrid"?"Off-Grid":solarSpecs?.plantType==="ongrid"?"On-Grid":"Hybrid";
      const terms=[
        {title:"MAKE", body:[
          solarSpecs?`Solar Module: ${solarSpecs.panelType||"DCR TopCon Bifacial"} (${solarSpecs.panelModel||""})`:null,
          solarSpecs?`${plantLabel} Inverter: ${solarSpecs.inverterCapacity||""} (${solarSpecs.inverterModel||""})`:null,
          solarSpecs&&Number(solarSpecs.batteryQty)>0?`Battery: Lead Acid ${solarSpecs.batterySpec||""} (${solarSpecs.batteryModel||""})`:null,
          "DC Cable: Polycab", "AC Cable: Polycab",
          "Structure: Hot Dip Galvanized G.I. Pipe Structure — HINDUSTAR",
          "L.A & Earthing: Copper", "ACDB & DCDB: L&T / Havells",
          solarSpecs?.plantType!=="offgrid"?"Meter (solar): Secure":null,
        ].filter(Boolean).join("\n• ")},
        {title:"Payment Terms",    body:"100% - Mobilization advance against Work Order (Structure, Module, Inverter, Other Item)."},
        {title:"Project Completion",body:"15-20 Days from the date of Receipt Solar NOC of DISCOM & Commercially Clear order and Advance Payment."},
        {title:"Validity of Offer", body:`${inv.valid_days||30} Days from the date of offer. After this period confirmation must be taken.`},
        {title:"Client Scope", body:[
          "Cleaning of solar modules in your scope.",
          "Roof to be arranged and provided by the client.",
          "Electricity & Water shall be provided by client during construction.",
          "Provide safe storage space for material being used for solar power plant.",
          "Provide Electricity supply to synchronize the inverter on commissioning and onward.",
          "Provide connection space in the LT panel to connect the Inverter Output.",
          "Internet Connection to be provided by the client for remote monitoring.",
        ].join("\n• ")},
        {title:"Transportation", body:"All Transportation Included of above mentioned BOM up to site of installation."},
        {title:"Net-Metering",   body:solarSpecs?.plantType==="offgrid"
          ?"Off-Grid system — net metering not required."
          :"All government Discom fee (File Charge, Demand, Testing for Net Metering, Electrical Inspector Report) arrangement will be pay DISCOM in Client Scope."},
        {title:"Solar System Warranty", body:[
          "5 Year Complete System Warranty.",
          "Solar Module Performance Warranty 30 Year.",
          `Solar ${plantLabel} Inverter 8 Year (Warranty as per Manufacturer Terms & Conditions).`,
          "All rates are inclusive of applicable GST (Panels/Inverters/Batteries @ 5%, Others @ 18%).",
        ].join("\n• ")},
      ];

      terms.forEach((term,i)=>{
        const bodyLines=term.body.split("\n");
        const bH=doc.heightOfString(term.body,{width:W-130,fontSize:7.5});
        const rowH=Math.max(28,bH+14);
        if(y+rowH>760){doc.addPage();y=40;}
        doc.rect(40,y,W,rowH).fill(i%2===0?"white":LGRY).strokeColor("#cccccc").stroke();
        doc.rect(40,y,30,rowH).fill(BLUE);
        doc.fillColor("white").fontSize(9).font("Helvetica-Bold")
          .text(String(i+1),40,y+rowH/2-6,{width:30,align:"center"});
        doc.fillColor(BLUE).fontSize(8).font("Helvetica-Bold").text(term.title,75,y+6,{width:85});
        doc.fillColor(DGY).fontSize(7.5).font("Helvetica").text(bodyLines[0],162,y+6,{width:W-125});
        bodyLines.slice(1).forEach((ln,li)=>doc.text(ln,162,y+18+li*11,{width:W-125}));
        y+=rowH+2;
      });

      y+=18; if(y>700){doc.addPage();y=40;}
      doc.fillColor(DGY).fontSize(8).font("Helvetica")
        .text("Thanking you and assuring you of our very best & prompt attention at all times, we remain. Yours Faithfully",40,y,{width:W});
      y+=22;

      doc.rect(40,y,W/2-10,55).stroke();
      doc.rect(W/2+50,y,W/2-10,55).stroke();
      doc.fillColor(BLUE).fontSize(9).font("Helvetica-Bold")
        .text(`For, ${compName}`,46,y+6).text("Authorised Signatory",46,y+46);
      doc.fillColor(MGY).fontSize(9).font("Helvetica").text("Customer Signature",W/2+56,y+46);

      doc.rect(40,790,W,1).fill("#cccccc");
      doc.fillColor(MGY).fontSize(6.5).font("Helvetica")
        .text(`${compName} | ${inv.company_website||"divyanshisolar.in"} | ${inv.company_phone||"9801005212"} | GSTIN: ${inv.company_gstin||""}`,
          40,795,{width:W,align:"center"});

      doc.end();
    } catch (error: any) {
      console.error("Quotation PDF error:", error);
      if (!res.headersSent) res.status(500).json({ error: error.message });
    }
  });

  // POST /api/billing/quotations/:id/send-email
  app.post("/api/billing/quotations/:id/send-email", async (req, res) => {
    try {
      const { id } = req.params;
      const { email } = req.body;
      if (!email) return res.status(400).json({ error: "Email required" });
      await pool.query(`
        UPDATE billing_invoices
        SET shared_via_email = true, email_sent_at = NOW(), recipient_email = $2
        WHERE id = $1
      `, [id, email]);
      res.json({ success: true, message: `Email tracked for ${email}` });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // POST /api/billing/quotations/:id/send-whatsapp
  app.post("/api/billing/quotations/:id/send-whatsapp", async (req, res) => {
    try {
      const { id } = req.params;
      const { phone } = req.body;
      if (!phone) return res.status(400).json({ error: "Phone required" });
      const invResult = await pool.query(
        `SELECT invoice_no, total_amount, customer_name FROM billing_invoices WHERE id = $1`, [id]
      );
      if (invResult.rows.length === 0) return res.status(404).json({ error: "Not found" });
      const inv = invResult.rows[0];
      await pool.query(`
        UPDATE billing_invoices
        SET shared_via_whatsapp = true, whatsapp_sent_at = NOW(), recipient_phone = $2
        WHERE id = $1
      `, [id, phone]);
      const cleanPhone = phone.replace(/[^0-9]/g, "");
      const waPhone = cleanPhone.startsWith("91") ? cleanPhone : `91${cleanPhone}`;
      const pdfUrl = `https://divyanshisolar.com/api/billing/quotations/${id}/pdf`;
      const waMessage = encodeURIComponent(
        `🌞 *Divyanshi Solar — Quotation*\n\nDear ${inv.customer_name},\n\nYour quotation *${inv.invoice_no}* is ready.\n💰 Total: ₹${Number(inv.total_amount).toLocaleString("en-IN")}\n\n📄 View: ${pdfUrl}\n\n📞 9801005212 | divyanshisolar.com`
      );
      res.json({
        success: true,
        whatsapp_url: `https://wa.me/${waPhone}?text=${waMessage}`,
        invoice_no: inv.invoice_no,
      });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });


  // ── GET /api/billing/documents/:id/pdf — Generic PDF for any billing doc ──
  app.get("/api/billing/documents/:id/pdf", async (req, res) => {
    // Redirect to existing quotation PDF route (works for all types)
    res.redirect(`/api/billing/quotations/${req.params.id}/pdf`);
  });

  // ── GET /api/billing/purchase-orders/:id/pdf — PO PDF ──
  app.get("/api/billing/purchase-orders/:id/pdf", async (req, res) => {
    try {
      const { id } = req.params;
      const poResult = await pool.query(`
        SELECT po.*, v.name as vendor_name, v.gstin as vendor_gstin, v.address as vendor_address,
               v.city as vendor_city, v.state as vendor_state, v.phone as vendor_phone, v.email as vendor_email,
               co.name as company_name, co.gstin as company_gstin, co.address_line1 as company_address,
               co.city as company_city, co.state as company_state, co.phone as company_phone, co.email as company_email
        FROM billing_purchase_orders po
        LEFT JOIN billing_vendors v ON v.id = po.vendor_id
        LEFT JOIN billing_companies co ON co.id = po.company_id
        WHERE po.id = $1
      `, [id]);
      if (poResult.rows.length === 0) return res.status(404).json({ error: "PO not found" });
      const po = poResult.rows[0];
      const itemsResult = await pool.query(`
        SELECT * FROM billing_line_items WHERE parent_type = 'purchase_order' AND parent_id = $1 ORDER BY sort_order
      `, [id]);
      const items = itemsResult.rows;
      const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${po.po_no}</title>
        <style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:sans-serif;background:#f3f4f6;color:#1f2937}
        .page{max-width:800px;margin:20px auto;background:#fff;padding:40px;box-shadow:0 2px 10px rgba(0,0,0,.1)}
        .header{display:flex;justify-content:space-between;border-bottom:3px solid #7c3aed;padding-bottom:16px;margin-bottom:24px}
        .title{font-size:22px;font-weight:700;color:#7c3aed}.info{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}
        .box{padding:12px;background:#f8fafc;border-radius:8px;border-left:4px solid #7c3aed;font-size:13px}
        .box h4{font-size:11px;text-transform:uppercase;color:#7c3aed;margin-bottom:6px}
        table{width:100%;border-collapse:collapse}th{background:#7c3aed;color:#fff;padding:8px;font-size:11px;text-transform:uppercase}
        td{padding:8px;border:1px solid #e5e7eb;font-size:12px}.total-row td{font-weight:700;background:#f3f0ff}
        .no-print{position:fixed;top:0;left:0;right:0;background:#7c3aed;padding:10px;text-align:center;z-index:100}
        .no-print button{padding:8px 20px;margin:0 8px;border:none;border-radius:6px;font-weight:600;cursor:pointer}
        @media print{.no-print{display:none}.page{margin:0;box-shadow:none}}</style></head><body>
        <div class="no-print"><button onclick="window.print()" style="background:#fbbf24;color:#1e293b">Print / Save PDF</button></div>
        <div class="page"><div class="header"><div><div class="title">PURCHASE ORDER</div>
        <p style="font-size:13px;margin-top:4px">${po.po_no}</p><p style="font-size:12px;color:#6b7280">Date: ${new Date(po.po_date).toLocaleDateString('en-IN')}</p>
        ${po.expected_delivery ? '<p style="font-size:12px;color:#6b7280">Delivery: ' + new Date(po.expected_delivery).toLocaleDateString('en-IN') + '</p>' : ''}</div>
        <div style="text-align:right"><div style="font-size:18px;font-weight:700;color:#1e293b">${po.company_name || 'Divyanshi Solar'}</div>
        <p style="font-size:11px;color:#6b7280">${po.company_address || ''}, ${po.company_city || 'Patna'}</p>
        <p style="font-size:11px;color:#6b7280">GSTIN: ${po.company_gstin || ''}</p>
        <p style="font-size:11px;color:#6b7280">${po.company_phone || '9801005212'} | ${po.company_email || ''}</p></div></div>
        <div class="info"><div class="box"><h4>Vendor / Supplier</h4><p><strong>${po.vendor_name || 'N/A'}</strong></p>
        <p>${po.vendor_address || ''} ${po.vendor_city || ''} ${po.vendor_state || ''}</p>
        <p>GSTIN: ${po.vendor_gstin || 'N/A'}</p><p>${po.vendor_phone || ''} ${po.vendor_email || ''}</p></div>
        <div class="box" style="border-left-color:#f59e0b"><h4>PO Summary</h4>
        <p>Subtotal: ₹${Number(po.taxable_amount || 0).toLocaleString('en-IN')}</p>
        <p>CGST: ₹${Number(po.cgst_total || 0).toLocaleString('en-IN')} | SGST: ₹${Number(po.sgst_total || 0).toLocaleString('en-IN')}</p>
        <p style="font-size:16px;font-weight:700;color:#7c3aed;margin-top:8px">Total: ₹${Number(po.total_amount || 0).toLocaleString('en-IN')}</p></div></div>
        <table><thead><tr><th>#</th><th>Product</th><th>HSN</th><th>Qty</th><th>Rate</th><th>Taxable</th><th>GST%</th><th>Total</th></tr></thead>
        <tbody>${items.map((it: any, i: number) => '<tr><td>' + (i+1) + '</td><td>' + (it.description||'') + '</td><td>' + (it.hsn_code||'') + '</td><td>' + it.quantity + ' ' + (it.unit||'') + '</td><td>₹' + Number(it.rate||0).toLocaleString('en-IN') + '</td><td>₹' + Number(it.taxable_value||0).toLocaleString('en-IN') + '</td><td>' + (it.gst_rate||0) + '%</td><td>₹' + Number(it.total_amount||0).toLocaleString('en-IN') + '</td></tr>').join('')}
        <tr class="total-row"><td colspan="5"></td><td>₹${Number(po.taxable_amount||0).toLocaleString('en-IN')}</td><td></td><td>₹${Number(po.total_amount||0).toLocaleString('en-IN')}</td></tr></tbody></table>
        ${po.notes ? '<p style="margin-top:16px;font-size:12px"><strong>Notes:</strong> ' + po.notes + '</p>' : ''}
        ${po.terms ? '<p style="margin-top:8px;font-size:12px"><strong>Terms:</strong> ' + po.terms + '</p>' : ''}
        <div style="margin-top:40px;text-align:right"><div style="border-top:1px solid #374151;width:200px;margin-left:auto;padding-top:8px;font-size:12px;color:#6b7280">Authorized Signatory</div></div>
        </div></body></html>`;
      res.setHeader("Content-Type", "text/html");
      res.send(html);
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

