      if(partnerName||partnerMobile){doc.fillColor(PRIM).fontSize(8).font("Helvetica-Bold").text("DISTRICT PARTNER",36,y);y+=6;if(partnerName){doc.fillColor(DGY).fontSize(8).font("Helvetica").text(`Name: ${partnerName}`,36,y);y+=11;}if(partnerMobile){doc.fillColor(DGY).fontSize(8).font("Helvetica").text(`Mobile: ${partnerMobile}`,36,y);y+=11;}}
      // PAGE 3
