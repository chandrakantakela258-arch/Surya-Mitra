  // ── POST /api/billing/purchase-orders/:id/send-whatsapp ──
  app.post("/api/billing/purchase-orders/:id/send-whatsapp", async (req, res) => {
    try {
      const { phone } = req.body;
      if (!phone) return res.status(400).json({ error: "Phone required" });
      const { rows } = await pool.query("SELECT po_no, total_amount FROM billing_purchase_orders WHERE id = $1", [req.params.id]);
      if (!rows.length) return res.status(404).json({ error: "PO not found" });
      const po = rows[0];
      const clean = phone.replace(/[^0-9]/g, "");
      const wa = clean.startsWith("91") ? clean : "91" + clean;
      const url = "https://divyanshisolar.com/api/billing/purchase-orders/" + req.params.id + "/pdf";
      const msg = encodeURIComponent("*Purchase Order - Divyanshi Solar*\n\nPO: " + po.po_no + "\nTotal: ₹" + Number(po.total_amount).toLocaleString("en-IN") + "\n\nView: " + url + "\n\n9801005212");
      res.json({ success: true, whatsapp_url: "https://wa.me/" + wa + "?text=" + msg });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });

  // ── Solar Quotation PDF ─────────────────────────────────────────────────
  app.post("/api/billing/quotations/solar-pdf", async (req: Request, res: Response) => {
    try {
      const { companyId, customer, consumerNo, siteAddress, partnerName, partnerMobile, system, costs } = req.body;
      const compRes = await pool.query("SELECT * FROM billing_companies WHERE id=$1", [companyId||1]);
      const comp = compRes.rows[0] || {};
      interface CL { label:string; incl:number; gstPct:number; }
      const lines:CL[] = [];
      const p = (label:string,incl:number,gst:number) => { if(Number(incl)>0) lines.push({label,incl:Number(incl),gstPct:gst}); };
      p("Solar Panels",costs.solarPanels,5);
      p("Inverter",costs.inverter,5);
      if(system.plantType!=="ongrid") p("Battery",costs.battery,5);
      p("Module Mounting Structure",costs.structure,18);
      p("Cables & Wiring",costs.cablesWiring,18);
      if(system.plantType!=="offgrid"&&Number(costs.netMeter)>0) p("Net Meter",costs.netMeter,18);
      p("Transport",costs.transport,18);
      p("Installation",costs.installation,18);
      p("Misc & Accessories",costs.miscAccessories,18);
      p("Service Charge (5yr)",costs.serviceCharge5yr,18);
      p("Contractor Profit",costs.contractorProfit,18);
      const tIncl=lines.reduce((s,l)=>s+l.incl,0);
      const tBase=lines.reduce((s,l)=>s+Math.round(l.incl/(1+l.gstPct/100)),0);
      const tGst=tIncl-tBase;
      const down=Math.round(tIncl*0.25);
      const loan=tIncl-down;
      const plantLabel=system.plantType==="offgrid"?"Off-Grid":system.plantType==="ongrid"?"On-Grid":system.plantType==="vfd_offgrid"?"VFD Off-Grid":system.plantType==="vfd_autogrid"?"VFD Auto-Grid":"Hybrid";
      const custName=(customer&&customer.name)?customer.name:"Customer";
      const refNo=`${(comp.name||"DIV").substring(0,3).toUpperCase()}/${new Date().getFullYear()}-${String(new Date().getMonth()+1).padStart(2,"0")}/${Math.floor(Math.random()*9000)+1000}`;
      const dateStr=new Date().toLocaleDateString("en-IN",{day:"2-digit",month:"long",year:"numeric"});
      const isDivyanshi=(comp.name||"").toLowerCase().includes("divyanshi");
      const PRIM=isDivyanshi?"#e8650a":"#1a3a6b";
      const ACC=isDivyanshi?"#f5820d":"#e07b2a";
      const GRN="#2e7d32";
      const LGRY="#f9f9f9";
      const DGY="#1a1a1a";
      const MGY="#555555";
      const W=515;
      res.setHeader("Content-Type","application/pdf");
      res.setHeader("Content-Disposition",`attachment; filename="Quotation_${custName.replace(/\s+/g,"_")}_${system.capacityKw||3}KW.pdf"`);
      const doc = new PDFDocument({size:"A4",margins:{top:36,bottom:36,left:36,right:36}});
      doc.pipe(res);
      
      const LOGO=isDivyanshi?"/root/surya-mitra-host/uploads/pdf-inserts/divyanshi_logo.png":"/root/surya-mitra-host/uploads/pdf-inserts/solarixa_logo.jpg";
      const SIG=isDivyanshi?"/root/surya-mitra-host/uploads/pdf-inserts/divyanshi_signature.jpg":"/root/surya-mitra-host/uploads/pdf-inserts/lokendra_signature.png";
      // PAGE 1
      doc.rect(36,36,W,70).fill(PRIM);
      if(isDivyanshi) doc.rect(36,36,W,5).fill(ACC);
      let tx=50;
      try{ if(fs.existsSync(LOGO)){doc.image(LOGO,40,40,{height:60,fit:[105,60]});tx=152;} }catch(e){}
      doc.fillColor("white").fontSize(12).font("Helvetica-Bold").text(comp.name||"Divyanshi Solar",tx,44,{width:220});
      doc.fillColor(isDivyanshi?"#fde8d0":"#b0c8ff").fontSize(6.5).font("Helvetica");
      [comp.cin?`CIN: ${comp.cin} | GSTIN: ${comp.gstin||""}`:comp.gstin||"",comp.head_office||comp.address_line1||"",comp.bihar_address||"",`Web: ${comp.website||"divyanshisolar.in"} | Ph: ${comp.phone||"9801005212"}`].filter(Boolean).forEach((ln,i)=>doc.text(ln as string,tx,59+i*9));
