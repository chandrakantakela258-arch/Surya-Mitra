      doc.rect(36,y,W,24).fill(PRIM);doc.fillColor("white").fontSize(11).font("Helvetica-Bold").text("TERMS & CONDITIONS",40,y+6,{width:W,align:"center"});y+=32;
      const terms=[{title:"MAKE",body:[`Solar Module: ${system.panelType||"DCR TopCon Bifacial"} (${system.panelModel||""})`,`${plantLabel} Inverter: ${system.inverterCapacity||""} (${system.inverterModel||""})`,Number(system.batteryQty)>0?`Battery: Lead Acid ${system.batterySpec||""} (${system.batteryModel||""})`:null,"DC Cable: Polycab | AC Cable: Polycab","Structure: Hot Dip Galvanized G.I. Pipe \u2014 HINDUSTAR","L.A & Earthing: Copper | ACDB & DCDB: L&T / Havells",system.plantType!=="offgrid"&&system.plantType!=="vfd_offgrid"?"Meter (solar): Secure":null].filter(Boolean).join("\n* ")},{title:"Payment Terms",body:"100% - Mobilization advance against Work Order (Structure, Module, Inverter, Other Item)."},{title:"Project Completion",body:"15-20 Days from the date of Receipt Solar NOC of DISCOM & Commercially Clear order and Advance Payment."},{title:"Validity of Offer",body:"30 Days from the date of offer. After this period confirmation must be taken."},{title:"Client Scope",body:["Cleaning of solar modules in your scope.","Roof to be arranged and provided by the client.","Electricity & Water shall be provided by client during construction.","Provide safe storage space for material being used for solar power plant.","Provide Electricity supply to synchronize the inverter on commissioning and onward.","Provide connection space in the LT panel to connect the Inverter Output.","Internet Connection to be provided by the client for remote monitoring."].join("\n* ")},{title:"Transportation",body:"All Transportation Included of above mentioned BOM up to site of installation."},{title:"Net-Metering",body:system.plantType==="offgrid"||system.plantType==="vfd_offgrid"?"Off-Grid / VFD system \u2014 net metering not required.":"All government Discom fee (File Charge, Demand, Testing for Net Metering, Electrical Inspector Report) arrangement will be paid by client in their scope."},{title:"Solar System Warranty",body:["5 Year Complete System Warranty.","Solar Module Performance Warranty: 30 Years.",`Solar ${plantLabel} Inverter: 8 Years (Warranty as per Manufacturer Terms & Conditions).`,"All rates are inclusive of applicable GST (Panels/Inverters/Batteries @ 5%, Others @ 18%)."].join("\n* ")}];
      terms.forEach((term,i)=>{const bodyLines=term.body.split("\n");const bH=Math.max(26,bodyLines.length*11+14);if(y+bH>755){doc.addPage();y=36;}doc.rect(36,y,W,bH).fill(i%2===0?"white":LGRY);doc.rect(36,y,W,1).fill("#e0e0e0");doc.rect(36,y,28,bH).fill(PRIM);doc.fillColor("white").fontSize(10).font("Helvetica-Bold").text(String(i+1),36,y+bH/2-7,{width:28,align:"center"});doc.fillColor(PRIM).fontSize(8).font("Helvetica-Bold").text(term.title,70,y+5,{width:90});doc.fillColor(DGY).fontSize(7.5).font("Helvetica").text(bodyLines[0],162,y+5,{width:W-130});bodyLines.slice(1).forEach((ln,li)=>doc.text(ln,162,y+17+li*11,{width:W-130}));y+=bH+2;});
      y+=18;if(y>700){doc.addPage();y=36;}
      doc.fillColor(DGY).fontSize(8.5).font("Helvetica").text("Thanking you and assuring you of our very best & prompt attention at all times, we remain. Yours Faithfully",36,y,{width:W});y+=24;
      const SBH=85;const sigW=W/2-6;
      doc.rect(36,y,sigW,SBH).fill("white").stroke();doc.rect(36,y,sigW,14).fill(isDivyanshi?"#fef0e6":"#e8eeff");doc.fillColor(PRIM).fontSize(7.5).font("Helvetica-Bold").text(`For, ${comp.name||"Divyanshi Digital Services Pvt Ltd"}`,40,y+3,{width:sigW-8});
      try{if(fs.existsSync(SIG))doc.image(SIG,40,y+16,{height:55,fit:[sigW-16,55]});else{doc.circle(sigW/2+36,y+48,22).stroke(PRIM);doc.fillColor(PRIM).fontSize(6).font("Helvetica").text("SEAL",sigW/2+28,y+45);}}catch(e){}
      doc.moveTo(40,y+SBH-14).lineTo(36+sigW-8,y+SBH-14).strokeColor("#aaaaaa").stroke();doc.fillColor(MGY).fontSize(7).font("Helvetica").text("Authorised Signatory",40,y+SBH-12,{width:sigW-8});
      const csx=36+sigW+12;doc.rect(csx,y,sigW,SBH).fill("white").stroke();doc.rect(csx,y,sigW,14).fill(isDivyanshi?"#fef0e6":"#e8eeff");doc.fillColor(PRIM).fontSize(7.5).font("Helvetica-Bold").text("Customer Acceptance",csx+4,y+3,{width:sigW-8});doc.fillColor(MGY).fontSize(7.5).font("Helvetica");[[y+20,"Name:"],[y+36,"Signature:"],[y+52,"Date:"],[y+68,"Seal:"]].forEach(([py,lbl])=>{doc.text(lbl as string,csx+6,py as number);doc.moveTo(csx+50,py as number+8).lineTo(csx+sigW-6,py as number+8).strokeColor("#bbbbbb").stroke();});
      doc.rect(36,795,W,1).fill("#cccccc");doc.fillColor(MGY).fontSize(6.5).font("Helvetica").text(`${comp.name||""} | ${comp.website||""} | ${comp.phone||""} | GSTIN: ${comp.gstin||""}`,36,800,{width:W,align:"center"});
      doc.end();
    } catch(err:any){
      console.error("Solar PDF error:",err);
      if(!res.headersSent) res.status(500).json({error:err.message});
    }
  });

  // ── GET /api/billing/vendors/search — Vendor auto-populate ──
  app.get("/api/billing/vendors/search", async (req, res) => {
    try {
      const q = (req.query.q as string || "").trim();
      if (q.length < 2) return res.json({ vendors: [] });
      const { rows } = await pool.query(
        "SELECT * FROM billing_vendors WHERE name ILIKE $1 OR gstin ILIKE $1 OR phone ILIKE $1 ORDER BY name LIMIT 10",
        ["%" + q + "%"]
      );
      res.json({ vendors: rows });
    } catch (e: any) { res.status(500).json({ error: e.message }); }
  });
  console.log("✓ Billing routes registered");
}
function generateQuotationPDF(invoice: any, items: any[]): string {
  const isIntraState = invoice.company_state_code === invoice.buyer_state_code;
  
  // Calculate totals
  let subtotal = 0;
  let totalCgst = 0;
  let totalSgst = 0;
  let totalIgst = 0;
  
  const itemRows = items.map((item, idx) => {
    const amount = Number(item.quantity) * Number(item.unit_price);
    const discount = Number(item.discount_amount || 0);
    const taxable = amount - discount;
    const gstRate = Number(item.gst_rate || 12);
    
    let cgst = 0, sgst = 0, igst = 0;
    if (isIntraState) {
      cgst = taxable * (gstRate / 2) / 100;
      sgst = taxable * (gstRate / 2) / 100;
    } else {
      igst = taxable * gstRate / 100;
    }
    
    subtotal += taxable;
    totalCgst += cgst;
    totalSgst += sgst;
    totalIgst += igst;
    
    return `
      <tr>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${idx + 1}</td>
        <td style="padding:8px;border:1px solid #d1d5db">
          <strong>${item.product_name || item.description}</strong>
          ${item.hsn_code ? `<br><small style="color:#6b7280">HSN: ${item.hsn_code}</small>` : ''}
          ${item.segment ? `<br><small style="color:#9ca3af">${item.segment}</small>` : ''}
        </td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${item.hsn_code || '-'}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${item.quantity} ${item.unit || 'Pcs'}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">₹${Number(item.unit_price).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">${discount > 0 ? '₹' + discount.toLocaleString('en-IN', {minimumFractionDigits: 2}) : '-'}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">₹${taxable.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:center">${gstRate}%</td>
        <td style="padding:8px;border:1px solid #d1d5db;text-align:right">₹${(cgst + sgst + igst).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
      </tr>
    `;
  }).join('');
  
  const totalTax = totalCgst + totalSgst + totalIgst;
  const grandTotal = subtotal + totalTax;
  
  // Amount in words
  const amountWords = numberToWordsINR(Math.round(grandTotal));
  
  const taxSummary = isIntraState ? `
    <tr><td style="padding:6px 12px;text-align:right" colspan="2">CGST</td><td style="padding:6px 12px;text-align:right">₹${totalCgst.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
    <tr><td style="padding:6px 12px;text-align:right" colspan="2">SGST</td><td style="padding:6px 12px;text-align:right">₹${totalSgst.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
  ` : `
    <tr><td style="padding:6px 12px;text-align:right" colspan="2">IGST</td><td style="padding:6px 12px;text-align:right">₹${totalIgst.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
  `;
  
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${invoice.invoice_no} — Divyanshi Solar</title>
  <style>
    @media print {
      body { margin: 0; padding: 0; }
      .no-print { display: none !important; }
      .page { box-shadow: none !important; margin: 0 !important; }
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f3f4f6; color: #1f2937; }
    .no-print { 
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: linear-gradient(135deg, #1e3a5f, #0f2544); padding: 12px 24px;
      display: flex; gap: 12px; align-items: center; justify-content: center;
    }
    .no-print button {
      padding: 10px 24px; border: none; border-radius: 8px; font-size: 14px;
      font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    .btn-print { background: #f59e0b; color: #1e3a5f; }
    .btn-download { background: #16a34a; color: white; }
    .btn-email { background: #3b82f6; color: white; }
    .btn-whatsapp { background: #25d366; color: white; }
    .page {
      max-width: 800px; margin: 70px auto 40px; background: white;
      box-shadow: 0 4px 24px rgba(0,0,0,0.1); padding: 40px;
    }
    table { width: 100%; border-collapse: collapse; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #1e3a5f; padding-bottom: 20px; }
    .company-name { font-size: 24px; font-weight: 700; color: #1e3a5f; }
    .doc-title { font-size: 20px; font-weight: 700; color: #f59e0b; text-align: right; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    .info-box { padding: 16px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #1e3a5f; }
    .info-box h4 { color: #1e3a5f; margin-bottom: 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }
    .info-box p { font-size: 13px; line-height: 1.6; color: #374151; }
    th { background: #1e3a5f; color: white; padding: 10px 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
    .totals-table { margin-left: auto; width: 300px; }
    .totals-table td { font-size: 14px; }
    .grand-total td { background: #1e3a5f; color: white; font-weight: 700; font-size: 16px; padding: 10px 12px !important; }
    .amount-words { background: #fef3c7; padding: 12px 16px; border-radius: 8px; margin: 16px 0; font-size: 13px; }
    .footer { margin-top: 30px; padding-top: 20px; border-top: 2px solid #e5e7eb; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .footer h4 { color: #1e3a5f; font-size: 12px; text-transform: uppercase; margin-bottom: 8px; }
    .footer p, .footer li { font-size: 12px; color: #6b7280; line-height: 1.6; }
    .signature-box { text-align: right; margin-top: 40px; }
    .signature-line { border-top: 1px solid #374151; width: 200px; margin-left: auto; padding-top: 8px; font-size: 12px; color: #6b7280; }
  </style>
</head>
<body>

  <div class="no-print">
    <button class="btn-print" onclick="window.print()">🖨️ Print / Save PDF</button>
    <button class="btn-email" onclick="sendEmail()">📧 Send Email</button>
    <button class="btn-whatsapp" onclick="sendWhatsApp()">💬 WhatsApp</button>
  </div>

  <div class="page">
    <div class="header">
      <div>
        <div class="company-name">🌞 ${invoice.company_name || 'Divyanshi Digital Services Pvt Ltd'}</div>
        <p style="font-size:12px;color:#6b7280;margin-top:4px">
          ${invoice.company_address || ''}, ${invoice.company_city || 'Patna'}, 
          ${invoice.company_state || 'Bihar'} - ${invoice.company_pin || '801109'}
        </p>
        <p style="font-size:12px;color:#6b7280">
          📞 ${invoice.company_phone || '9801005212'} | ✉️ ${invoice.company_email || 'info@divyanshisolar.in'}
        </p>
        <p style="font-size:12px;color:#6b7280">
          GSTIN: <strong>${invoice.company_gstin || '10AAGCD4586K1ZK'}</strong>
        </p>
      </div>
      <div style="text-align:right">
        <div class="doc-title">${invoice.invoice_type === 'quotation' ? 'QUOTATION' : 'TAX INVOICE'}</div>
        <p style="font-size:14px;font-weight:600;margin-top:8px">${invoice.invoice_no}</p>
        <p style="font-size:13px;color:#6b7280">Date: ${new Date(invoice.invoice_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</p>
        ${invoice.due_date ? `<p style="font-size:13px;color:#6b7280">Valid Until: ${new Date(invoice.due_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</p>` : ''}
      </div>
    </div>

    <div class="info-grid">
      <div class="info-box">
        <h4>Bill To</h4>
        <p>
          <strong>${invoice.customer_name || '-'}</strong><br>
          ${invoice.buyer_address || ''}<br>
          ${invoice.buyer_city || ''}, ${invoice.buyer_state || ''} - ${invoice.buyer_pin || ''}<br>
          ${invoice.buyer_gstin ? `GSTIN: ${invoice.buyer_gstin}` : ''}
          ${invoice.buyer_phone ? `<br>📞 ${invoice.buyer_phone}` : ''}
          ${invoice.buyer_email ? `<br>✉️ ${invoice.buyer_email}` : ''}
        </p>
      </div>
      <div class="info-box" style="border-left-color:#f59e0b">
        <h4>Ship To</h4>
        <p>
          <strong>${invoice.ship_to_name || invoice.customer_name || '-'}</strong><br>
          ${invoice.ship_to_address || invoice.buyer_address || ''}<br>
          ${invoice.ship_to_city || invoice.buyer_city || ''}, ${invoice.ship_to_state || invoice.buyer_state || ''}
        </p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width:40px">#</th>
          <th>Product / Description</th>
          <th style="width:70px">HSN</th>
          <th style="width:70px">Qty</th>
          <th style="width:90px">Rate</th>
          <th style="width:70px">Disc.</th>
          <th style="width:100px">Taxable</th>
          <th style="width:50px">GST%</th>
          <th style="width:90px">Tax</th>
        </tr>
      </thead>
      <tbody>
        ${itemRows}
      </tbody>
    </table>

    <div style="display:flex;justify-content:space-between;margin-top:20px">
      <div class="amount-words" style="flex:1;margin-right:20px">
        <strong>Amount in Words:</strong><br>
        ${amountWords}
      </div>
      <table class="totals-table">
        <tr><td style="padding:6px 12px;text-align:right" colspan="2">Subtotal</td><td style="padding:6px 12px;text-align:right;font-weight:600">₹${subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
        ${taxSummary}
        <tr class="grand-total">
          <td colspan="2" style="padding:10px 12px;text-align:right">GRAND TOTAL</td>
          <td style="padding:10px 12px;text-align:right">₹${grandTotal.toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
        </tr>
      </table>
    </div>

    <div class="footer">
      <div>
        <h4>Terms & Conditions</h4>
        <ul style="padding-left:16px">
          <li>Payment due within 15 days of invoice date</li>
          <li>Prices are inclusive of GST as shown</li>
          <li>Warranty as per manufacturer terms</li>
          <li>Installation timeline: 7-15 working days after payment</li>
          <li>Subject to Bihar/applicable state jurisdiction</li>
        </ul>
      </div>
      <div>
        <h4>Bank Details</h4>
        <p>
          ${invoice.bank_name || 'Bank of India'}<br>
          A/C: ${invoice.bank_account || '-'}<br>
          IFSC: ${invoice.bank_ifsc || '-'}<br>
          Branch: ${invoice.bank_branch || '-'}
        </p>
        <div class="signature-box">
          <br><br>
          <div class="signature-line">Authorized Signatory</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function sendEmail() {
      const email = prompt("Enter customer email address:");
      if (!email) return;
      const subject = encodeURIComponent("Quotation ${invoice.invoice_no} — Divyanshi Solar");
      const body = encodeURIComponent(
        "Dear ${invoice.customer_name || 'Customer'},\\n\\n" +
        "Please find your quotation ${invoice.invoice_no} attached.\\n" +
        "Total Amount: ₹${grandTotal.toLocaleString('en-IN')}\\n\\n" +
        "View online: " + window.location.href + "\\n\\n" +
        "Thank you,\\nDivyanshi Solar\\n📞 9801005212"
      );
      window.open("mailto:" + email + "?subject=" + subject + "&body=" + body);
      
      // Track on server
      fetch("/api/billing/quotations/${id}/send-email", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });
    }
    
    function sendWhatsApp() {
      const phone = prompt("Enter customer WhatsApp number (with 91):");
      if (!phone) return;
      const cleanPhone = phone.replace(/[^0-9]/g, "");
      const waPhone = cleanPhone.startsWith("91") ? cleanPhone : "91" + cleanPhone;
      const msg = encodeURIComponent(
        "🌞 *Divyanshi Solar — Quotation*\\n\\n" +
        "Dear ${invoice.customer_name || 'Customer'},\\n\\n" +
        "Your quotation *${invoice.invoice_no}* is ready.\\n" +
        "💰 Total: ₹${grandTotal.toLocaleString('en-IN')}\\n\\n" +
        "📄 View: " + window.location.href + "\\n\\n" +
        "📞 9801005212 | divyanshisolar.com"
      );
      window.open("https://wa.me/" + waPhone + "?text=" + msg, "_blank");
      
      // Track on server
      fetch("/api/billing/quotations/${id}/send-whatsapp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone })
      });
    }
  </script>
</body>
</html>`;
}
function numberToWordsINR(num: number): string {
  if (num === 0) return "Zero Rupees Only";
  
  const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
    'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen',
    'Seventeen', 'Eighteen', 'Nineteen'];
  const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
  
  function convertGroup(n: number): string {
    if (n === 0) return '';
    if (n < 20) return ones[n];
    if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 ? ' ' + ones[n % 10] : '');
    return ones[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' and ' + convertGroup(n % 100) : '');
  }
  
  let result = '';
  if (num >= 10000000) { result += convertGroup(Math.floor(num / 10000000)) + ' Crore '; num %= 10000000; }
  if (num >= 100000) { result += convertGroup(Math.floor(num / 100000)) + ' Lakh '; num %= 100000; }
  if (num >= 1000) { result += convertGroup(Math.floor(num / 1000)) + ' Thousand '; num %= 1000; }
  if (num > 0) { result += convertGroup(num); }
  
  return result.trim() + ' Rupees Only';
}
