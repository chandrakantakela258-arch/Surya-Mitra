      await client.query(
        "INSERT INTO billing_stock_movements (product_id, movement_type, quantity, reference_type, notes, created_by) VALUES ($1, 'adjustment', $2, 'manual', $3, $4)",
        [product_id, quantity, notes||"Manual adjustment", created_by||null]
      );
      await client.query("COMMIT");
      res.json({ success: true });
