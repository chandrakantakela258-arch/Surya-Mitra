      doc.fillColor(PRIM).fontSize(8.5).font("Helvetica-Bold").text("WARRANTY & PERFORMANCE",36,y);y+=8;
      const ww=(W-24)/4;[{l:"25 Years",s:"Module Mfg."},{l:"30 Years",s:"Performance"},{l:"8 Years",s:"Inverter"},{l:"5 Years",s:"Complete System"}].forEach((w,i)=>{const wx=36+i*(ww+8);doc.rect(wx,y,ww,40).fill("#f0fff0").stroke(GRN);doc.rect(wx,y,ww,4).fill(GRN);doc.fillColor(GRN).fontSize(14).font("Helvetica-Bold").text(w.l,wx+4,y+9,{width:ww-8,align:"center"});doc.fillColor(MGY).fontSize(7).font("Helvetica").text(w.s,wx+4,y+27,{width:ww-8,align:"center"});});y+=54;
      doc.fillColor(PRIM).fontSize(8.5).font("Helvetica-Bold").text("BANK ACCOUNT DETAILS",36,y);y+=8;
